# examples/bare_demo — the whole toolkit, on bare metal.
#
# Build and run:
#   .\scripts\build-bare.ps1 -Source examples\bare_demo\main.tr
#   qemu-system-arm -M mps2-an385 -nographic -kernel build-bare\app.elf > out.ppm
#
# There is no operating system here, no libc, and no filesystem. The compiler
# generates the reset vector and the linker script; the allocator below is the
# entire memory manager; print() goes straight out a UART register. Everything
# between those two extremes -- parser, style cache, layout, interpreter,
# rasteriser -- is the SAME toolkit source the hosted demo runs, imported
# unchanged.
#
# Only two things are substituted, and both are things a bare machine genuinely
# lacks: BufferCanvas (which needs io.file) becomes FrameBuffer, and reading the
# UI from disk becomes a string compiled into the image.

from std.hal.mmio import write32
from string.str import Str
from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.ast import count_nodes, tree_depth
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.render.bare.framebuffer import FrameBuffer

# ---- Memory: the shared arena over the MPS2-AN385 SRAM window ----
#
# The ~80 lines that used to live here (and, verbatim, in three UEFI programs)
# now live in toolkit/platform/arena.tr -- one copy to be correct, and the
# shape the `nebula` CLI will generate. See that file for the four invariants
# every bump allocator here has to satisfy, all four of which were learned the
# hard way and each of which presents as a silent hang rather than an error.
#
# The hooks themselves must stay in the program: @allocator and friends are
# per-program, and --freestanding #errors at C-compile time without them.

from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.platform.arena import arena_mark, arena_release, arena_used

@allocator
def heap_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def heap_free(p: Pointer[u8]):
    pass

@realloc
def heap_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def heap_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

# ---- print() sink: CMSDK UART0 ----
@output
def uart_write(s: Pointer[char]):
    unsafe:
        write32(0x40004008 as usize, 1 as u32)
        mut i = 0
        while s.offset(i).read() != (0 as char):
            write32(0x40004000 as usize, s.offset(i).read() as u32)
            i = i + 1

# The handler. A class implementing EventHandler rather than a plain function,
# because calling a function pointer hangs on this target -- see the note on
# EventHandler in toolkit/types.tr.
#
# It records state rather than printing: this program's stdout IS the image
# file, so anything written before the PPM magic would corrupt it.
mut _ok_hits: int = 0

pub class OkHandler implements EventHandler:
    pub tag: int

extend OkHandler:
    pub def init() -> OkHandler:
        mut h = OkHandler()
        h.tag = 0
        return h

    pub def handle(self, e: Event) -> void:
        _ok_hits = _ok_hits + 1

@entry
def kernel_main():
    # The arena has to be initialised before ANY allocation, which means
    # before the parser runs. 0x20080000 is the MPS2-AN385 SRAM window; the
    # size is deliberately generous, since the bound exists to turn a runaway
    # allocation into a null pointer rather than to model real SRAM.
    unsafe:
        arena_init(0x20080000 as Pointer[u8], 0x00400000 as usize)

    # The UI description, compiled into the image because there is no disk to
    # read it from. Identical in form to examples/hosted_demo/app.ui.
    # A <text> row proves the baked bitmap font (toolkit/text/) renders
    # correctly on Cortex-M, not just hosted -- this is real glyph-bitmap
    # blitting through Canvas.set_pixel, a genuinely new code path on this
    # tier, not something the earlier solid-color-only demo exercised.
    #
    # Colors and the exact canvas size here are deliberately pinned to a
    # combination confirmed to complete on real hardware emulation -- see
    # CLAUDE.md's bare-metal notes. Certain other packed RGB values (amber,
    # violet, mist) and certain canvas widths (96 hangs, 88 does not, same
    # everything else) hang deterministically on this exact target for
    # reasons not yet root-caused. Bisect any change to either before
    # trusting it here.
    mut src = "<panel \"flex-col p-0.5 gap-0.5 bg-slate-800\">\n  <panel \"flex-row gap-0.5 h-5\">\n    <panel \"bg-red grow\" />\n    <panel \"bg-green grow\" />\n    <panel \"bg-blue grow\" />\n  </panel>\n  <text \"text-white\">BARE METAL</text>\n  <panel \"flex-row gap-0.5 h-3\" @on_click(on_ok)>\n    <panel \"bg-blue grow\" />\n    <panel \"bg-red w-3.5\" />\n  </panel>\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it = Interpreter.init()
    # Must match the FrameBuffer's clear color below: it's what the
    # antialiased edges of the outermost panel blend against.
    it.root_bg = 0x000000
    mut ok = OkHandler.init()
    register_handler(it, "on_ok", ok)

    # 88px wide: enough for "BARE METAL" (10 chars * 8px + 2*2px padding =
    # 84px) with a hair of margin, and empirically confirmed to complete
    # (96px, otherwise identical, hangs). 56 tall fits the color row + text
    # row + button row + padding/gaps (2+20+2+14+2+12+2 = 54).
    mut fb = FrameBuffer.init(88, 56, 0x000000)

    # --- per-frame arena reset (proposal v3, phase 1a) ------------------
    #
    # Frame 0 is the warm-up: it resolves every class string into the
    # StyleCache, so the cache's Dict never grows again. The mark is taken
    # AFTER it, because a Dict that reallocs above the mark would have its
    # storage freed out from under it on the first release. See
    # toolkit/platform/arena.tr for the full rule.
    render_to(it, tree, fb)
    mut warm = arena_used()
    mut frame_mark = arena_mark()

    # Three more frames. If the reset works, arena usage after each is
    # IDENTICAL -- that equality is the whole proof, and it is what made this
    # tier single-frame until now.
    mut used_1: usize = 0 as usize
    mut used_2: usize = 0 as usize
    mut used_3: usize = 0 as usize

    arena_release(frame_mark)
    render_to(it, tree, fb)
    used_1 = arena_used()

    arena_release(frame_mark)
    render_to(it, tree, fb)
    used_2 = arena_used()

    arena_release(frame_mark)
    render_to(it, tree, fb)
    used_3 = arena_used()

    # Hit-testing against the LAST frame's tree, which is still live: dispatch
    # must run after a render and before the next release.
    mut on_button = it.dispatch(Event.click(20, 46))
    mut on_padding = it.dispatch(Event.click(1, 1))

    fb.emit_ppm()

    # Diagnostics after the image data, where PPM tolerates trailing bytes.
    print("# nodes=" + count_nodes(tree).to_str() + " depth=" + tree_depth(tree).to_str())
    print("# dispatch button=" + on_button.to_str() + " padding=" + on_padding.to_str() + " hits=" + _ok_hits.to_str())
    print("# " + it.stats())
    print("# arena warm=" + warm.to_str() + " f1=" + used_1.to_str() + " f2=" + used_2.to_str() + " f3=" + used_3.to_str())
    if used_1 == used_2 and used_2 == used_3:
        print("# PER-FRAME RESET OK -- 4 renders, steady-state memory")
    else:
        print("# PER-FRAME RESET BROKEN -- usage grew across frames")
    p.report()
