# toolkit.ui.router — SPA-style page navigation (proposal v5, section 9).
#
# A page IS a component (toolkit.ui.component) and a route param IS a prop
# -- `navigate("user", {"id": "42"})` reaches a page template's `{id}` the
# same way any component's `{title}` gets filled by `instantiate()`. Router
# only adds the bookkeeping components don't need on their own: which page
# is current, and how we got here (for `back()`).
#
# READ docs/proposal/proposal-v5-components.md section 9.3 before shipping
# a page with stateful widgets: node_key (proposal v4 step F) is purely
# positional, so two pages that put a stateful widget at the same tree
# position share its node_key. That is not a crash, but it is a real,
# visible "briefly shows the old page's state" bug unless the page's own
# template gives that widget an explicit `key-<routename>-...` token -- the
# same escape hatch a reordering list already needs.

from toolkit.ui.ast import UiNode, box_node
from toolkit.ui.component import instantiate

pub class Route:
    pub name:     str
    pub template: Pointer[UiNode]

pub class Router:
    pub routes:      List[Route]
    pub current:     str
    pub params:      Dict[str, str]
    # Parallel stacks rather than a list of (name, params) pairs -- Tauraro
    # has no anonymous tuple-in-a-list-literal shorthand as ergonomic as two
    # `.append()`/`.pop()` calls kept in lockstep.
    pub history:     List[str]
    pub hist_params: List[Dict[str, str]]

extend Router:
    pub def init() -> Router:
        mut r = Router()
        r.routes = []
        r.current = ""
        r.params = {}
        r.history = []
        r.hist_params = []
        return r

    pub def register(self, name: str, template: Pointer[UiNode]) -> void:
        mut rt = Route()
        rt.name = name
        rt.template = template
        self.routes.append(rt)

    def find_route(self, name: str) -> int:
        mut i = 0
        while i < len(self.routes):
            if self.routes[i].name == name:
                return i
            i = i + 1
        return 0 - 1

    # The very first navigate() has nothing to push -- `current` starts ""
    # and no template is registered under that name, so `back()` from the
    # first page correctly finds an empty history instead of "returning" to
    # a route that never existed.
    pub def navigate(self, name: str, props: Dict[str, str]) -> void:
        if self.current != "":
            self.history.append(self.current)
            self.hist_params.append(self.params)
        self.current = name
        self.params = props

    pub def can_back(self) -> bool:
        return len(self.history) > 0

    pub def back(self) -> bool:
        if len(self.history) == 0:
            return false
        self.current = self.history.pop()
        self.params = self.hist_params.pop()
        return true

    # An unregistered current route (typo'd navigate(), or page() called
    # before any navigate() at all) degenerates to an empty panel -- the
    # same "always hand back a Pointer[UiNode], never a null check onto
    # every call site" rule toolkit.ui.component.instantiate() follows for
    # a root-<slot/> template.
    pub def page(self, slots: Dict[str, List[Pointer[UiNode]]]) -> Pointer[UiNode]:
        mut idx = self.find_route(self.current)
        if idx < 0:
            mut empty: List[Pointer[UiNode]] = []
            return box_node(UiNode.Element("panel", "", "", "", empty))
        return instantiate(self.routes[idx].template, slots, self.params)
