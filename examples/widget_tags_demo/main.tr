# examples/widget_tags_demo — widgets-as-markup-tags, phase 1, proven on a
# real SDL2 window (the CPU/SoftwareRenderer half of the pair; see
# examples/widget_tags_demo_gl for the GPU-Renderer half of the same claim).
#
# Unlike examples/widgets_demo (which host-paints Checkbox/Radio/Switch/
# Slider/ProgressBar as plain classes constructed, painted and hit-tested by
# hand every frame), this whole screen is ONE markup tree -- `<checkbox/>`,
# `<switch/>`, `<radio/>`, `<slider/>`, `<progress/>` are real tags, parsed by
# the SAME UiParser every `<panel>`/`<button>` already goes through. There is
# no widget construction code in this file at all: toolkit/ui/interp.tr's
# `emit_widget`/`hit_test_widget` (see their own comments) do everything a
# widget class's `.paint()`/`.click_inside()` used to do by hand.
#
# What this proves, concretely:
#   - checkbox/switch: click anywhere on the shape toggles it, with NO
#     `@on_click` needed for the toggle itself to work.
#   - a 3-way radio group (`group-theme` on all three): selecting one
#     deselects the other two, entirely via the shared group name token --
#     no host code names any of the three individually.
#   - slider: draggable, and its live value drives a SEPARATE `<progress>`
#     bar purely through `Interpreter.state` (`key-brightness` /
#     `key-brightness-pb`) -- one widget's interaction is legible to another
#     with one `state_get`/`state_set` round-trip in the frame loop, not a
#     host-held reference between two widget objects.
#
# Run: .\scripts\build-desktop.ps1 -Source examples\widget_tags_demo\main.tr -OutDir build-widget-tags-demo
#      .\build-widget-tags-demo\app.exe

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_diff_to, register_handler
from toolkit.render.desktop.sdl_canvas import SdlCanvas, poll_event, last_click, last_key, mouse_state

pub class OkHandler implements EventHandler:
    pub label: str

extend OkHandler:
    pub def init(label: str) -> OkHandler:
        mut h = OkHandler()
        h.label = label
        return h

    pub def handle(self, e: Event) -> void:
        print("  [host] " + self.label + " fired")

def main():
    mut w = 460
    mut h = 420
    mut canvas = SdlCanvas.open_vsync("Tauraro UI Toolkit -- widget_tags_demo", w, h)
    if not canvas.ok():
        print("failed to open an SDL window/renderer")
        return

    mut it = Interpreter.init()
    it.root_bg = 0x1E293B
    mut ok = OkHandler.init("on_ok")
    mut cancel = OkHandler.init("on_cancel")
    register_handler(it, "on_ok", ok)
    register_handler(it, "on_cancel", cancel)

    # Every widget below is a TAG, not a class -- see this file's own header.
    # `key-*` tokens give each one a stable identity (toolkit/ui/widget_tags.tr
    # / Proposal v4 step F) so `Interpreter.state` survives this tree being
    # thrown away and rebuilt every single frame, exactly like every other
    # per-node key in this toolkit already does.
    mut src = "<panel \"flex-col p-4 gap-4 bg-slate-800\">\n  <panel \"h-16 bg-slate-700 border-slate-400 border rounded-xl items-center justify-center\">\n    <text \"text-white\">NEBULA WIDGET TAGS</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <checkbox \"key-agree checked\"/>\n    <text \"text-white\">I agree to the terms</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <switch \"key-notify on\"/>\n    <text \"text-white\">Notifications</text>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">THEME</text>\n    <panel \"flex-row gap-6\">\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-light group-theme selected\"/>\n        <text \"text-white\">Light</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-dark group-theme\"/>\n        <text \"text-white\">Dark</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-auto group-theme\"/>\n        <text \"text-white\">Auto</text>\n      </panel>\n    </panel>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">BRIGHTNESS</text>\n    <slider \"key-brightness min-0 max-100 value-65 w-full\"/>\n    <progress \"key-brightness-pb w-full\"/>\n  </panel>\n\n  <panel \"flex-row gap-[3px] h-10 p-[3px] bg-slate-700 rounded-lg\">\n    <button \"bg-amber grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_ok)>\n      <text \"text-black\">OK</text>\n    </button>\n    <button \"bg-red grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_cancel)>\n      <text \"text-white\">CANCEL</text>\n    </button>\n  </panel>\n</panel>\n"
    mut p = UiParser.init()
    mut tree = p.parse(src)
    p.report()

    print("window open -- checkbox/switch/radio-group/slider/progress all live markup tags. close the window to quit")

    # render_diff_to's own contract: stop clearing every frame, clear ONCE up
    # front -- see toolkit/ui/interp.tr's own comment on Interpreter.
    # render_diff for the full reasoning (identical to examples/widgets_demo).
    canvas.clear(0x1E293B)

    mut running = true
    while running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                mut clk = last_click()
                it.dispatch(clk)
            elif code == 3:
                mut ke = last_key()
                it.dispatch(ke)

        if running:
            mut mx, my, mdown = mouse_state()
            it.hover_x = mx
            it.hover_y = my
            it.pressed = mdown
            it.mouse_x = mx
            it.mouse_y = my

            # The slider drives the progress bar: read the slider's live,
            # persisted value and hand it straight to the progress bar's own
            # state slot. Nothing here holds a reference to either widget --
            # both are markup, and this is the SAME Interpreter.state map
            # every checkbox/switch/radio above already reads and writes.
            it.state_set("K:brightness-pb", it.state_get("K:brightness", 65))

            render_diff_to(it, tree, canvas)
            canvas.present()

    canvas.close()
    print("window closed")
