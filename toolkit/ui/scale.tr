# toolkit.ui.scale — Tailwind token suffixes -> pixel values.
#
# This is the arithmetic half of the utility system: every function here takes
# the part of a class token AFTER its prefix ("4" from "p-4", "lg" from
# "rounded-lg", "1/2" from "w-1/2") and returns a concrete pixel count. The
# prefix half -- deciding WHICH Style field a token targets -- lives in
# toolkit.ui.style.apply_utility, which calls into here.
#
# Imports only string.str on purpose: style.tr imports this, and Tauraro
# rejects circular imports.
#
# ## The scale, and why these numbers
#
# Tailwind's spacing unit is 0.25rem. At the CSS default root font size of
# 16px that is exactly **4px per step**, so `p-4` is 16px, not 4px. That is
# the whole point of this module and the one thing to keep straight while
# reading any .ui file in this repo: the number in a class name is a STEP on
# a scale, not a pixel count.
#
# We follow Tailwind v4's *dynamic* spacing scale -- any integer step is
# valid, `p-13` is simply 13 * 4 = 52px -- rather than v3's fixed list, which
# rejected everything not in its table. The dynamic rule is strictly more
# permissive, so every v3 class string still means what it meant, and it
# collapses what would otherwise be a 34-arm lookup into one multiply.
#
# The four half-steps (0.5, 1.5, 2.5, 3.5) and the literal `px` step are the
# exceptions the multiply cannot express, and are listed explicitly.
#
# ## Arbitrary values
#
# Tailwind's own escape hatch, `p-[17px]`, is supported everywhere a scale
# value is -- with or without the `px` unit, so `w-[460px]` and `w-[460]` are
# the same thing. This is the migration path for anything that genuinely
# wants an exact pixel count rather than a scale step, and it is deliberately
# uglier to type than `p-4`, because reaching for it should be a decision.

from string.str import Str

# "This suffix is not a value of the kind you asked for." Distinct from any
# legitimate result: 0 is a real spacing value (`p-0`), and negative pixel
# counts are real too once margins are in play (`-mt-4`), so the sentinel has
# to sit outside the range either could ever produce.
pub def no_px() -> int:
    return 0 - 1000000

# Strips Tailwind's arbitrary-value brackets and optional `px` unit:
# "[17px]" -> "17", "[460]" -> "460", anything else -> "" (not arbitrary).
# Returns the inner text rather than a number so colors (`bg-[#1e293b]`) can
# share the same unwrapping.
pub def arbitrary_inner(v: str) -> str:
    mut n = Str.len(v)
    if n < 3:
        return ""
    if not Str.starts_with(v, "["):
        return ""
    if Str.slice(v, n - 1, n) != "]":
        return ""
    mut inner = Str.slice(v, 1, n - 1)
    mut m = Str.len(inner)
    if m > 2:
        if Str.slice(inner, m - 2, m) == "px":
            return Str.slice(inner, 0, m - 2)
    return inner

# An arbitrary pixel literal, e.g. the "[17px]" in `p-[17px]`. no_px() if the
# suffix is not bracketed or the brackets do not contain a plain integer.
pub def arbitrary_px(v: str) -> int:
    mut inner = arbitrary_inner(v)
    if inner == "":
        return no_px()
    if Str.starts_with(inner, "-"):
        mut body = Str.slice(inner, 1, Str.len(inner))
        if not Str.is_digit(body):
            return no_px()
        return 0 - Str.parse_int(body)
    if not Str.is_digit(inner):
        return no_px()
    return Str.parse_int(inner)

# The spacing scale: `p-*`, `m-*`, `gap-*`, and the fixed sizes `w-*`/`h-*`
# fall back to. See the header for why a step is 4px.
pub def spacing_px(v: str) -> int:
    if v == "px":
        return 1
    if v == "0.5":
        return 2
    if v == "1.5":
        return 6
    if v == "2.5":
        return 10
    if v == "3.5":
        return 14

    mut arb = arbitrary_px(v)
    if arb != no_px():
        return arb

    if Str.is_digit(v):
        return Str.parse_int(v) * 4
    return no_px()

# Border radius. Tailwind's radius steps are their own scale, NOT the spacing
# scale -- `rounded-lg` is 8px while `p-lg` is not a thing at all -- so this
# is a separate table rather than a call into spacing_px.
#
# The bare token `rounded` (empty suffix) is 4px, matching Tailwind's default.
# `rounded-full` is a pill: a radius larger than any box, which the rasterizer
# clamps to half the shorter side, so one huge number covers every box size.
pub def radius_px(v: str) -> int:
    if v == "":
        return 4
    if v == "none":
        return 0
    if v == "sm":
        return 2
    if v == "md":
        return 6
    if v == "lg":
        return 8
    if v == "xl":
        return 12
    if v == "2xl":
        return 16
    if v == "3xl":
        return 24
    if v == "full":
        return 9999

    mut arb = arbitrary_px(v)
    if arb != no_px():
        return arb
    return no_px()

# Border width. Another small scale of its own: bare `border` is 1px, and the
# named steps are 0/2/4/8 -- note these are literal pixels, so `border-4` is
# 4px, unlike `p-4` which is 16px. That asymmetry is Tailwind's, not ours.
pub def border_px(v: str) -> int:
    if v == "":
        return 1
    if v == "0":
        return 0
    if v == "2":
        return 2
    if v == "4":
        return 4
    if v == "8":
        return 8

    mut arb = arbitrary_px(v)
    if arb != no_px():
        return arb
    return no_px()

# --- fractional sizing -----------------------------------------------------
#
# `w-1/2`, `w-2/3`, `w-full`. Returned as a numerator/denominator PAIR rather
# than a percentage, and resolved against the parent's content box at layout
# time, because rounding a percent first loses exactness: 1/3 of a 300px
# parent is exactly 100px, while 33% of it is 99px, and three such children
# would visibly fail to fill their row.
#
# Two functions rather than one returning a pair, because Tauraro has no
# tuple return: callers ask for the numerator, and if it is >= 0 ask for the
# denominator with the same argument.

pub def fraction_num(v: str) -> int:
    if v == "full":
        return 1
    mut slash = Str.index_of(v, "/")
    if slash <= 0:
        return 0 - 1
    mut n = Str.slice(v, 0, slash)
    if not Str.is_digit(n):
        return 0 - 1
    mut d = Str.slice(v, slash + 1, Str.len(v))
    if not Str.is_digit(d):
        return 0 - 1
    if Str.parse_int(d) <= 0:
        return 0 - 1
    return Str.parse_int(n)

pub def fraction_den(v: str) -> int:
    if v == "full":
        return 1
    mut slash = Str.index_of(v, "/")
    if slash <= 0:
        return 0 - 1
    mut d = Str.slice(v, slash + 1, Str.len(v))
    if not Str.is_digit(d):
        return 0 - 1
    mut dv = Str.parse_int(d)
    if dv <= 0:
        return 0 - 1
    return dv

# Brackets only, no unit handling: "[#1e293b]" -> "#1e293b". Colors need this
# rather than arbitrary_inner(), which also strips a trailing "px" unit --
# harmless for hex (no hex digit is 'p' or 'x') but wrong in principle, and
# the distinction is worth one extra function rather than a comment.
pub def strip_brackets(v: str) -> str:
    mut n = Str.len(v)
    if n < 3:
        return ""
    if not Str.starts_with(v, "["):
        return ""
    if Str.slice(v, n - 1, n) != "]":
        return ""
    return Str.slice(v, 1, n - 1)
