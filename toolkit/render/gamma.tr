pub def srgb_to_linear(v: int) -> int:
    if not _gamma_tables_ready:
        _init_gamma_tables()
    if v < 0:
        return SRGB_TO_LINEAR[0]
    if v > 255:
        return SRGB_TO_LINEAR[255]
    return SRGB_TO_LINEAR[v]

pub def linear_to_srgb(v: int) -> int:
    if not _gamma_tables_ready:
        _init_gamma_tables()
    if v < 0:
        return LINEAR_TO_SRGB[0]
    if v > 255:
        return LINEAR_TO_SRGB[255]
    return LINEAR_TO_SRGB[v]
