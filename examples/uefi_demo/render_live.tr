# examples/uefi_demo/render_live.tr — a LIVE, interactive UI on bare firmware.
#
# This is what phases 1a and 1b of proposal v3 were for. Every other UEFI demo
# renders one static frame and halts; this one runs a real frame loop with a
# real mouse and a real keyboard, on a machine with no OS, no libc, no
# filesystem and no window manager.
#
# Two things made it possible, and neither is in this file:
#
#   1. toolkit/platform/arena.tr's mark/release. Before it, a second render
#      allocated a second LayoutBox tree and never reclaimed the first, so
#      every freestanding tier was structurally single-frame.
#   2. examples/uefi_demo/boot_interactive.zig, which locates the pointer and
#      keyboard protocols the turnkey --target uefi-x64 glue cannot reach, and
#      calls tauraro_ui_frame() once per frame with plain integers.
#
# Nothing in toolkit/ changed. Hover feedback, hit-testing, dispatch and the
# widgets below are the SAME code paths examples/widgets_demo drives from
# SDL2 -- the portability claim, tested against the least forgiving platform
# available.
#
# ## Why every object is rebuilt each frame
#
# The obvious design is to build the parser, the Interpreter and the widgets
# once into module-level globals and keep them. That does not work here, and
# the failure is worth recording because it is invisible until it isn't:
#
#     member access within null pointer of type 'UiParser'
#
# A module-level `mut x = SomeClass.init()` runs its initializer during
# program startup -- which on this tier is BEFORE the zig stub has called
# tauraro_heap_init(). It allocates from an arena whose bounds are still
# zero, gets a null pointer back, and stores it. Every later use is a null
# dereference, on a machine with no fault handler to explain it.
#
# So the persistent state here is SCALARS ONLY (ints and bools, no
# allocation, safe to initialize statically), and everything else is
# reconstructed each frame from them. That sounds wasteful and is not:
# re-parsing ~15 nodes and re-resolving ~10 class strings is noise next to
# antialiasing a 520x360 panel, and it buys two real simplifications --
# there is no live object that a per-frame release could dangle, and the
# StyleCache never outlives a frame, so it can never grow above the mark
# (which is the one ordering rule arena.tr warns about).

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.ui.interp import draw_text, fill_circle_aa
from toolkit.render.uefi.gop import GopCanvas
from toolkit.text.font import Font
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.switch import Switch
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.platform.arena import arena_mark, arena_release, arena_used

pub export def tauraro_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def heap_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def heap_free(p: Pointer[u8]):
    pass

@realloc
def heap_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def heap_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

# --- persistent state: scalars only, for the reason in the header ---------
mut _marked:   bool = false
mut _mark:     usize = 0 as usize
mut _frames:   int = 0
mut _clicks:   int = 0
mut _last_key: int = 0
mut _prev_btn: bool = false
mut _cb_on:    bool = false
mut _sw_on:    bool = false
mut _sw_knob:  int = 0
mut _sl_val:   int = 40

# The RAM backbuffer. Allocated once, OUTSIDE the per-frame mark, and held as
# a raw pointer -- a pointer global has a constant initializer, so unlike a
# class it is safe to declare at module level (see the header).
mut _back: Pointer[u32] = 0 as Pointer[u32]

# The colour the widgets' antialiased edges blend against. It has to match the
# bg- of the panel they are drawn ON, not the screen behind it, or every
# rounded corner picks up a halo of the wrong colour.
def panel_bg() -> int:
    return 0x1E293B

pub class ClickHandler implements EventHandler:
    pub tag: int

extend ClickHandler:
    pub def init() -> ClickHandler:
        mut h = ClickHandler()
        h.tag = 0
        return h

    pub def handle(self, e: Event) -> void:
        _clicks = _clicks + 1

# A mouse cursor, drawn by us. There is no window manager here: nothing else
# in the machine is going to put a pointer on the screen, and without one the
# UI is unusable even when it is responding perfectly.
#
# A ring, not a dot -- a solid cursor vanishes against a light widget, and
# Canvas has no XOR or invert to fall back on.
def paint_cursor(c: GopCanvas, x: int, y: int, pressed: bool) -> void:
    mut fill = 0xFFFFFF
    if pressed:
        fill = 0x38BDF8
    fill_circle_aa(c, x, y, 8, 0x0F172A, panel_bg())
    fill_circle_aa(c, x, y, 5, fill, 0x0F172A)

# Called once per frame by boot_interactive.zig. Returns non-zero to ask the
# firmware loop to stop -- here, when Esc (27) is pressed.
pub export def tauraro_ui_frame(fb: Pointer[u32], width: int, height: int, pitch: int, mouse_x: int, mouse_y: int, buttons: int, key: int) -> int:
    # The mark is taken on the first frame, before anything is allocated, so
    # EVERY allocation this program makes is per-frame and reclaimable. That
    # is only safe because nothing persists but scalars -- see the header.
    # Allocate the backbuffer ONCE, before the mark, so the per-frame release
    # never reclaims it. Drawing into RAM and blitting at the end is what
    # RASTERIZER.md 1 prescribes, for two reasons that both bite here:
    #
    #   1. The GOP framebuffer is uncached write-combining memory across PCIe.
    #      Writing it pixel-by-pixel -- which is exactly what an antialiasing
    #      rasterizer does -- is far slower than writing RAM and blitting once.
    #   2. Painting straight to the scanout means anything watching the screen
    #      sees a HALF-DRAWN frame. That is not theoretical: two screenshots
    #      of this demo caught the frame mid-paint and looked like layout bugs
    #      (a missing header, a truncated string) until the backbuffer proved
    #      the renderer had been right all along.
    if not _marked:
        unsafe:
            _back = alloc[u32](width * height)
        _mark = arena_mark()
        _marked = true

    arena_release(_mark)
    _frames = _frames + 1
    if key != 0:
        _last_key = key

    mut pressed = buttons != 0
    # A click is the RISING edge of the button, not the button being held --
    # otherwise one physical click toggles the checkbox sixty times a second.
    mut clicked = pressed and not _prev_btn
    _prev_btn = pressed

    # The canvas targets the BACKBUFFER, not the scanout. Its pitch is the
    # plain width, because we allocated it ourselves and it has no padding --
    # the firmware's own pitch only matters at blit time.
    mut canvas = GopCanvas.init(_back, width, height, width)
    mut font = Font.load()

    mut src = "<panel \"flex-row justify-center items-center bg-[#0F172A]\">\n  <panel \"w-[520px] h-[360px] flex-col p-5 gap-4 bg-slate-800 rounded-2xl border border-slate-500\">\n    <panel \"h-12 bg-slate-700 rounded-xl px-4 items-center\">\n      <text \"text-slate-100\">NEBULA LIVE ON UEFI</text>\n    </panel>\n    <panel \"grow\" />\n    <panel \"flex-row gap-4 h-12\">\n      <button \"grow bg-sky-500 rounded-lg justify-center items-center\" @on_click(on_a)>\n        <text \"text-white\">CLICK ME</text>\n      </button>\n      <button \"grow bg-slate-600 rounded-lg border border-slate-400 justify-center items-center\" @on_click(on_b)>\n        <text \"text-slate-100\">OR ME</text>\n      </button>\n    </panel>\n  </panel>\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it = Interpreter.init()
    it.root_bg = 0x0F172A
    register_handler(it, "on_a", ClickHandler.init())
    register_handler(it, "on_b", ClickHandler.init())

    # Hover and press feed the interpreter exactly the way the SDL loop does:
    # plain per-frame fields that paint() reads while walking the tree, which
    # is the whole hover-highlight mechanism.
    it.hover_x = mouse_x
    it.hover_y = mouse_y
    it.pressed = pressed

    render_to(it, tree, canvas)

    # Where layout actually put the card, read back rather than recomputed, so
    # the host-painted widgets follow it if the markup changes.
    mut card = it.root.children[0]
    mut ox = card.x
    mut oy = card.y

    mut cbx = ox + 20
    mut cby = oy + 76
    mut swx = ox + 20
    mut swy = oy + 116
    mut slx = ox + 20
    mut sly = oy + 160
    mut slw = 480

    # Widgets rebuilt from the scalar state, driven, then read back. This is
    # the whole reason the state is scalars: a widget object cannot survive a
    # release, but three ints and two bools can.
    mut cb = Checkbox.init(_cb_on)
    cb.page_bg = panel_bg()
    mut sw = Switch.init(_sw_on)
    sw.page_bg = panel_bg()
    sw.knob_pos = _sw_knob
    mut sl = Slider.init(0, 100, _sl_val)
    sl.page_bg = panel_bg()
    mut pb = ProgressBar.init(_sl_val)
    pb.page_bg = panel_bg()

    if clicked:
        cb.click_inside(mouse_x, mouse_y, cbx, cby, 20, 20)
        sw.click_inside(mouse_x, mouse_y, swx, swy, 48, 26)
        it.dispatch(Event.click(mouse_x, mouse_y))

    # The slider needs its rect before drag_to can map x to a value, and
    # paint() is what stashes that rect -- so paint first, then drag, then
    # paint again with the new value on the next frame. Dragging while held
    # rather than only on the rising edge is what makes it feel continuous.
    sl.paint(canvas, slx, sly, slw, 24)
    if pressed:
        sl.drag_to(mouse_x)

    sw.tick()

    # Read the driven state back out before the objects are released.
    _cb_on = cb.checked
    _sw_on = sw.on
    _sw_knob = sw.knob_pos
    _sl_val = sl.value

    pb.set_value(_sl_val)

    cb.paint(canvas, cbx, cby, 20, 20)
    draw_text(canvas, font, "Checkbox -- click it", cbx + 32, cby + 3, 0xE2E8F0, panel_bg())
    sw.paint(canvas, swx, swy, 48, 26)
    draw_text(canvas, font, "Switch -- it animates", swx + 60, swy + 6, 0xE2E8F0, panel_bg())
    pb.paint(canvas, ox + 20, oy + 196, slw, 10)

    # Live telemetry, so a viewer can see this is a real loop and not a
    # cleverly-arranged still.
    mut l1 = "frames " + _frames.to_str() + "   clicks " + _clicks.to_str() + "   xy " + mouse_x.to_str() + "," + mouse_y.to_str() + "   slider " + _sl_val.to_str()
    draw_text(canvas, font, l1, ox + 20, oy + 224, 0x94A3B8, panel_bg())
    mut l2 = "arena " + arena_used().to_str() + " bytes -- constant means the per-frame reset works"
    draw_text(canvas, font, l2, ox + 20, oy + 242, 0x94A3B8, panel_bg())
    if _last_key != 0:
        draw_text(canvas, font, "last key " + _last_key.to_str() + "   (Esc exits)", ox + 20, oy + 260, 0x94A3B8, panel_bg())
    else:
        draw_text(canvas, font, "type something   (Esc exits)", ox + 20, oy + 260, 0x94A3B8, panel_bg())

    paint_cursor(canvas, mouse_x, mouse_y, pressed)

    # Blit the finished frame to the real framebuffer in one sequential pass.
    # This is the only place the scanout is touched all frame, so a viewer
    # never sees a partial paint, and the slow uncached writes happen once per
    # pixel instead of once per overlapping draw.
    unsafe:
        mut y = 0
        while y < height:
            mut src_row = y * width
            mut dst_row = y * pitch
            mut x = 0
            while x < width:
                fb.offset(dst_row + x).write(_back.offset(src_row + x).read())
                x = x + 1
            y = y + 1

    if _last_key == 27:
        return 1
    return 0
