# examples/ide_demo_web -- "Nebula Studio", browser half of the same app
# (see examples/ide_demo for the desktop half and the full app/tag design
# rationale, not repeated here). Same markup, same tags, same 2-Interpreter
# structure -- only the platform glue differs, and only in the ways every
# other examples/*_web sibling already differs from its desktop twin.
#
# ## KNOWN ISSUE, not yet resolved: hangs at runtime inside nebula_init
#
# The wasm module compiles and links cleanly (`-O Debug`, not the default
# `-O ReleaseSmall`, is required to avoid this box's zig-linker memory-
# pressure kills -- see scripts/build-web.ps1's own args for the flag this
# overrides). But calling `nebula_init` never returns: confirmed via a
# direct Node.js `WebAssembly.instantiate` probe (bypassing the browser
# entirely, so this is not a browser-automation artifact) -- CPU climbs
# steadily with memory usage FLAT, which rules out a runaway allocation
# loop and points at something CPU-bound that never terminates. Not yet
# isolated to a specific line: an isolation test (a bare
# `_it = Interpreter.init()` global assignment, no markup at all) was
# in progress when this session's build infra became too unreliable to
# finish it (see MEMORY.md's own notes on this box's chronic build
# flakiness). Prime suspect, not yet confirmed: the "persistent Interpreter
# as a module-level global" pattern this file introduces (see below) --
# genuinely novel, not used by any other *_web example, since every other
# one keeps its widget state in scalar globals instead. Desktop
# (examples/ide_demo) does not have this bug; the logic is identical there,
# only the platform glue differs.
#
# ## The one real architectural difference: a PERSISTENT Interpreter
#
# examples/web_shell (this file's closest sibling) constructs a brand-new
# `Interpreter` every single animation frame, because on freestanding wasm
# module-level initializers never run (see render_web.tr's own header,
# "verified by probe, not inferred": a global's declared initializer value
# is silently discarded, and everything starts at its raw zeroed/null bit
# pattern until something explicitly assigns it later). That was fine for
# web_shell's host-painted widgets, whose state lived in scalar globals,
# never inside an Interpreter at all.
#
# This app's `<tabitem>`/`<listitem>`/checkbox/switch/radio/slider/progress
# tags all depend on `Interpreter.state` (a `Dict`) SURVIVING across
# frames via `node_key` -- a fresh Interpreter every frame means an empty
# `state` every frame, which would make every tag forget every click the
# instant the next frame starts. So `_it`/`_tree`/`_content_it`/
# `_content_trees` are module-level globals here, constructed ONCE inside
# `nebula_init` (called exactly once by the host, same guarantee
# `nebula_init` already gives every *_web example) -- an ordinary function
# BODY assignment, not a global's own declaration-time initializer, so the
# "initializers don't run" rule doesn't apply to it: `nebula_init`'s code
# runs exactly like any other exported function's does.
#
# Also unlike every desktop tier here (which use `render_diff_to` once
# `examples/widget_tags_demo` proved SDL2's 2D renderer presents by copy,
# not by flip): this always fully clears and fully repaints, matching
# examples/web_shell's OWN choice for Canvas2D exactly, rather than
# assuming the same diffing safety carries over to a THIRD, never-tested
# present() implementation. And unlike every freestanding *_web sibling's
# own `arena_mark()`/`arena_release()` per-frame reset (see
# toolkit/platform/arena.tr's own header): this never releases at all.
# A released mark only reclaims memory that's ENTIRELY scratch, and here
# `Interpreter.state`'s own growth is interleaved in time with genuinely
# disposable per-frame allocations (the parsed tree is persistent too, but
# `Scene`/`LayoutBox` are rebuilt every frame) with no clean boundary
# between them under a single bump pointer -- releasing risks freeing
# storage `_it.state` still points at, the exact hazard arena.tr's own
# header describes for StyleCache. A bump allocator that only grows is a
# safe, simple, explicitly-stated tradeoff for a bounded demo session
# instead (see build-web-ide-demo's larger --initial-memory for the room
# this needs).
#
#   tauraroc examples\ide_demo_web\main.tr --target wasm --freestanding --emit c
#   zig build-exe -target wasm32-freestanding -fno-entry -rdynamic \
#       --import-symbols --export=__heap_base --initial-memory=... \
#       -cflags -w ... -- build/*.c
#
# (scripts/build-web.ps1 -Source examples\ide_demo_web\main.tr -OutDir build-web-ide-demo)

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, render_into, register_handler
from toolkit.ui.component import instantiate, one_slot, no_props
from toolkit.ui.ast import UiNode, box_node
from toolkit.render.web.canvas2d_renderer import Canvas2DCanvas, canvas2d_renderer_of
from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc

pub export def nebula_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def nebula_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def nebula_free(p: Pointer[u8]):
    pass

@realloc
def nebula_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def nebula_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

def b2i(b: bool) -> int:
    if b:
        return 1
    return 0

pub class MenuHandler implements EventHandler:
    pub name: str

extend MenuHandler:
    pub def init(name: str) -> MenuHandler:
        mut h = MenuHandler()
        h.name = name
        return h

    pub def handle(self, e: Event) -> void:
        pass

# --- persistent state -------------------------------------------------
#
# Scalars, exactly like every other freestanding example -- see
# render_web.tr's own header for why any NON-zero default below is
# meaningless until something on a host-called path (here, nebula_init)
# assigns it explicitly.
mut _frames:   int  = 0
mut _prev_btn: bool = false

# The persistent Interpreters/trees this file's own header explains --
# their declared initializers below never run on freestanding either (same
# rule, same reason), so these start as raw zeroed/null values and are
# given their real ones inside nebula_init's own body instead.
mut _it:            Interpreter        = Interpreter.init()
mut _tree:          Pointer[UiNode]    = 0 as Pointer[UiNode]
mut _content_it:    Interpreter        = Interpreter.init()
mut _content_trees: List[Pointer[UiNode]] = []

def content_x() -> int:
    return 220

def content_y() -> int:
    return 40 + 36

pub export def nebula_init(width: int, height: int) -> void:
    mut m_file = MenuHandler.init("File")
    mut m_edit = MenuHandler.init("Edit")
    mut m_view = MenuHandler.init("View")
    mut m_help = MenuHandler.init("Help")

    _it = Interpreter.init()
    _it.root_bg = 0x0B1120
    register_handler(_it, "on_file", m_file)
    register_handler(_it, "on_edit", m_edit)
    register_handler(_it, "on_view", m_view)
    register_handler(_it, "on_help", m_help)

    # --- sidebar rows via the component model, spliced into the shell
    # through a named slot -- identical to examples/ide_demo's own comment
    # on this, see that file for the full rationale.
    mut row_src = "<listitem \"group-active-file value-{idx} {sel} key-file-{idx} px-2 h-8 items-center gap-2\">\n  <panel \"w-[10px] h-[10px] rounded-full bg-{color}\" />\n  <text \"text-slate-200\">{name}</text>\n</listitem>\n"
    mut row_p = UiParser.init()
    mut row_template = row_p.parse(row_src)

    mut names: List[str] = ["main.tr", "style.tr", "README.md", "Settings"]
    mut colors: List[str] = ["blue-500", "amber-500", "emerald-500", "violet-500"]
    mut sidebar_kids: List[Pointer[UiNode]] = []
    mut i = 0
    while i < 4:
        mut props = no_props()
        props["idx"] = i.to_str()
        props["name"] = names[i]
        props["color"] = colors[i]
        mut sel = ""
        if i == 0:
            sel = "selected"
        props["sel"] = sel
        sidebar_kids.append(instantiate(row_template, one_slot([]), props))
        i = i + 1
    mut sidebar_panel = box_node(UiNode.Element("panel", "w-[220px] bg-[#111827] flex-col p-3 gap-2", "", "", sidebar_kids))

    mut shell_src = "<panel \"flex-col bg-[#0B1120]\">\n  <panel \"flex-row items-center h-10 bg-[#111827] px-3 gap-2\">\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_file)>\n      <text \"text-slate-300\">File</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_edit)>\n      <text \"text-slate-300\">Edit</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_view)>\n      <text \"text-slate-300\">View</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_help)>\n      <text \"text-slate-300\">Help</text>\n    </button>\n    <panel \"grow\" />\n    <text \"text-slate-500\">NEBULA STUDIO</text>\n  </panel>\n\n  <panel \"flex-row items-end h-9 bg-[#0B1120] gap-1 px-2\">\n    <tabitem \"group-active-file value-0 selected key-tab-0 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">main.tr</text>\n    </tabitem>\n    <tabitem \"group-active-file value-1 key-tab-1 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">style.tr</text>\n    </tabitem>\n    <tabitem \"group-active-file value-2 key-tab-2 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">README.md</text>\n    </tabitem>\n    <tabitem \"group-active-file value-3 key-tab-3 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">Settings</text>\n    </tabitem>\n  </panel>\n\n  <panel \"flex-row grow\">\n    <slot \"sidebar\"/>\n    <panel \"grow bg-[#0F172A]\" />\n  </panel>\n\n  <panel \"flex-row items-center h-6 bg-[#111827] px-3 gap-4\">\n    <text \"text-slate-300\">main</text>\n    <panel \"grow\" />\n    <text \"text-slate-500\">Ln 12, Col 4</text>\n    <text \"text-slate-500\">Tauraro</text>\n  </panel>\n</panel>\n"
    mut shell_p = UiParser.init()
    mut shell_template = shell_p.parse(shell_src)
    mut slots: Dict[str, List[Pointer[UiNode]]] = {}
    slots["sidebar"] = [sidebar_panel]
    _tree = instantiate(shell_template, slots, no_props())

    mut main_src = "<panel \"flex-col gap-1 p-3 bg-[#0F172A]\">\n  <text \"text-purple-400\">from toolkit.ui.parser import UiParser</text>\n  <text \"text-purple-400\">from toolkit.ui.interp import Interpreter, render_to</text>\n  <panel \"h-2\" />\n  <text \"text-blue-400\">def main():</text>\n  <text \"text-slate-200\">    mut it = Interpreter.init()</text>\n  <text \"text-green-400\">    # build the UI tree and render it</text>\n  <text \"text-slate-200\">    mut tree = UiParser.init().parse(src)</text>\n  <text \"text-slate-200\">    render_to(it, tree, canvas)</text>\n</panel>\n"
    mut style_src = "<panel \"flex-col gap-1 p-3 bg-[#0F172A]\">\n  <text \"text-blue-400\">.card {</text>\n  <text \"text-slate-200\">    background: #1e293b;</text>\n  <text \"text-slate-200\">    border-radius: 12px;</text>\n  <text \"text-slate-200\">}</text>\n  <panel \"h-2\" />\n  <text \"text-green-400\">/* accent tokens */</text>\n  <text \"text-blue-400\">.accent {</text>\n  <text \"text-slate-200\">    color: #3b82f6;</text>\n  <text \"text-slate-200\">}</text>\n</panel>\n"
    mut readme_src = "<panel \"flex-col gap-2 p-3 bg-[#0F172A]\">\n  <text \"text-white\">Nebula Studio</text>\n  <panel \"h-2\" />\n  <text \"text-slate-300\">A demo IDE shell built entirely from nebula markup tags --</text>\n  <text \"text-slate-300\">tabitem, listitem, checkbox, switch, radio, slider and</text>\n  <text \"text-slate-300\">progress, composed with the component model.</text>\n</panel>\n"
    mut settings_src = "<panel \"flex-col gap-4 p-3 bg-[#0F172A]\">\n  <text \"text-slate-300\">EDITOR SETTINGS</text>\n\n  <panel \"flex-row items-center gap-3\">\n    <checkbox \"key-set-autosave checked\"/>\n    <text \"text-slate-200\">Enable auto-save</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <switch \"key-set-format on\"/>\n    <text \"text-slate-200\">Format on save</text>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">Tab size</text>\n    <panel \"flex-row gap-6\">\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab2 group-tabsize selected\"/>\n        <text \"text-slate-200\">2</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab4 group-tabsize\"/>\n        <text \"text-slate-200\">4</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab8 group-tabsize\"/>\n        <text \"text-slate-200\">8</text>\n      </panel>\n    </panel>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">Font size</text>\n    <slider \"key-set-fontsize min-8 max-32 value-14 w-full\"/>\n    <progress \"key-set-fontsize-pb w-full\"/>\n  </panel>\n</panel>\n"

    _content_trees = [UiParser.init().parse(main_src), UiParser.init().parse(style_src), UiParser.init().parse(readme_src), UiParser.init().parse(settings_src)]
    _content_it = Interpreter.init()
    _content_it.root_bg = 0x0F172A

pub export def nebula_frames() -> int:
    return _frames

pub export def nebula_arena_used() -> int:
    return 0

# One call per animation frame -- same host contract as
# examples/web_shell's own `nebula_frame` (positive wheel_delta = up /
# scroll-toward-start), even though this app has nothing wheel-scrollable
# yet (see examples/ide_demo's own "Deferred" section).
pub export def nebula_frame(width: int, height: int, mouse_x: int, mouse_y: int, buttons: int, key: int, wheel_delta: int) -> void:
    _frames = _frames + 1

    mut pressed = buttons != 0
    mut clicked = pressed and not _prev_btn
    _prev_btn = pressed

    mut canvas = Canvas2DCanvas.init(width, height)
    canvas.clear(0x0B1120)

    if clicked:
        _it.dispatch(Event.click(mouse_x, mouse_y))
        if _it.state_get("G:active-file", 0) == 3:
            _content_it.dispatch(Event.click(mouse_x, mouse_y))

    _it.hover_x = mouse_x
    _it.hover_y = mouse_y
    _it.pressed = pressed
    _it.mouse_x = mouse_x
    _it.mouse_y = mouse_y
    _content_it.hover_x = mouse_x
    _content_it.hover_y = mouse_y
    _content_it.pressed = pressed
    _content_it.mouse_x = mouse_x
    _content_it.mouse_y = mouse_y

    mut active = _it.state_get("G:active-file", 0)
    _it.state_set("K:tab-0", b2i(active == 0))
    _it.state_set("K:tab-1", b2i(active == 1))
    _it.state_set("K:tab-2", b2i(active == 2))
    _it.state_set("K:tab-3", b2i(active == 3))
    _it.state_set("K:file-0", b2i(active == 0))
    _it.state_set("K:file-1", b2i(active == 1))
    _it.state_set("K:file-2", b2i(active == 2))
    _it.state_set("K:file-3", b2i(active == 3))

    render_to(_it, _tree, canvas)

    mut cw = width - content_x()
    mut ch = height - content_y() - 24
    render_into(_content_it, _content_trees[active], canvas, content_x(), content_y(), cw, ch, 0x0F172A)

    if active == 3:
        mut fv = _content_it.state_get("K:set-fontsize", 14)
        mut pct = (fv - 8) * 100 / (32 - 8)
        _content_it.state_set("K:set-fontsize-pb", pct)
