# examples/widget_tags_demo_gl — widgets-as-markup-tags, phase 1, GPU half
# of the pair (see examples/widget_tags_demo for the CPU/SoftwareRenderer
# half and the full rationale -- not repeated here).
#
# A near-exact copy of that file's markup and frame loop, with three changes
# proposal-v6 phase 1/2 established for every GL example:
#   1. `gl_canvas_open(...)` instead of `SdlCanvas.open_vsync(...)`.
#   2. `it.renderer = gl_renderer_of(canvas)` -- this is the ONE line that
#      makes `emit_widget`'s `Cmd.circle`/`Cmd.circle_ring` (switch knob,
#      radio ring/dot, slider thumb) route through the GPU SDF shader
#      instead of the CPU rasterizer (see toolkit/ui/interp.tr's own
#      `exec_cmds` comment on why only those two NEW shape kinds are
#      Renderer-dispatched in phase 1). `rounded_rect`/`rounded_box`
#      (checkbox, switch track, slider track/fill, progress bar, and every
#      plain `<panel>`/`<button>`) still paint via the CPU AA rasterizer
#      either way -- unchanged from the CPU example, correct on both.
#   3. `render_to`, NOT `render_diff_to` -- see examples/widgets_demo_gl's
#      own comment on its chrome_tree render call for why: real OpenGL
#      double buffering swaps between two DISTINCT physical buffers
#      (SDL_GL_SwapWindow is a flip, not SDL2's 2D renderer's blit-style
#      present()), so skipping a command diffing decided was "unchanged"
#      leaves the OTHER physical buffer one frame stale -- every widget here
#      is fully dynamic (hover/press/drag), so this alternated between two
#      different partial frames and flickered continuously. Full repaint
#      every frame is what every existing GL example does for exactly this
#      reason.
#
# Run: .\scripts\build-desktop-gl.ps1 -Source examples\widget_tags_demo_gl\main.tr -OutDir build-widget-tags-demo-gl
#      .\build-widget-tags-demo-gl\app.exe

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.render.desktop.sdl_canvas import poll_event, last_click, last_key, mouse_state
from toolkit.render.desktop.gl_canvas import gl_canvas_open, gl_renderer_of

pub class OkHandler implements EventHandler:
    pub label: str

extend OkHandler:
    pub def init(label: str) -> OkHandler:
        mut h = OkHandler()
        h.label = label
        return h

    pub def handle(self, e: Event) -> void:
        print("  [host] " + self.label + " fired")

def main():
    mut w = 460
    mut h = 420
    mut canvas = gl_canvas_open("Tauraro UI Toolkit -- widget_tags_demo (GPU)", w, h)
    if not canvas.ok():
        print("failed to open a GL window/context")
        return

    mut it = Interpreter.init()
    it.root_bg = 0x1E293B
    it.renderer = gl_renderer_of(canvas)
    mut ok = OkHandler.init("on_ok")
    mut cancel = OkHandler.init("on_cancel")
    register_handler(it, "on_ok", ok)
    register_handler(it, "on_cancel", cancel)

    mut src = "<panel \"flex-col p-4 gap-4 bg-slate-800\">\n  <panel \"h-16 bg-slate-700 border-slate-400 border rounded-xl items-center justify-center\">\n    <text \"text-white\">NEBULA WIDGET TAGS</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <checkbox \"key-agree checked\"/>\n    <text \"text-white\">I agree to the terms</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <switch \"key-notify on\"/>\n    <text \"text-white\">Notifications</text>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">THEME</text>\n    <panel \"flex-row gap-6\">\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-light group-theme selected\"/>\n        <text \"text-white\">Light</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-dark group-theme\"/>\n        <text \"text-white\">Dark</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-theme-auto group-theme\"/>\n        <text \"text-white\">Auto</text>\n      </panel>\n    </panel>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">BRIGHTNESS</text>\n    <slider \"key-brightness min-0 max-100 value-65 w-full\"/>\n    <progress \"key-brightness-pb w-full\"/>\n  </panel>\n\n  <panel \"flex-row gap-[3px] h-10 p-[3px] bg-slate-700 rounded-lg\">\n    <button \"bg-amber grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_ok)>\n      <text \"text-black\">OK</text>\n    </button>\n    <button \"bg-red grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_cancel)>\n      <text \"text-white\">CANCEL</text>\n    </button>\n  </panel>\n</panel>\n"
    mut p = UiParser.init()
    mut tree = p.parse(src)
    p.report()

    print("window open (GPU) -- checkbox/switch/radio-group/slider/progress all live markup tags. close the window to quit")

    canvas.clear(0x1E293B)

    mut running = true
    while running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                mut clk = last_click()
                it.dispatch(clk)
            elif code == 3:
                mut ke = last_key()
                it.dispatch(ke)

        if running:
            mut mx, my, mdown = mouse_state()
            it.hover_x = mx
            it.hover_y = my
            it.pressed = mdown
            it.mouse_x = mx
            it.mouse_y = my

            it.state_set("K:brightness-pb", it.state_get("K:brightness", 65))

            render_to(it, tree, canvas)
            canvas.present()

    canvas.close()
    print("window closed")
