# examples/widgets_demo_gl — the full widget demo, GPU-accelerated
# (proposal-v6 phase 2's real end-to-end wiring, not just a standalone shape
# smoke test).
#
# A near-exact copy of examples/widgets_demo/main.tr -- same tree, same
# widgets, same layout constants -- with exactly two kinds of change from the
# original, both additive:
#   1. `gl_canvas_open(...)` instead of `SdlCanvas.open_vsync(...)`. GlCanvas
#      implements the SAME Canvas interface, so every existing
#      `canvas.fill_rect/present/close`, `draw_text(canvas, ...)`, and
#      `render_diff_to(it, chrome_tree, canvas)` call keeps compiling and
#      running completely unchanged -- proposal-v6 phase 1's whole point.
#   2. Every host-painted widget's own `.renderer` field (Checkbox, Radio,
#      Switch, Slider, ProgressBar, Dropdown, Tabs, ScrollList -- the ones
#      that draw shapes directly, not through the chrome markup tree) is
#      reassigned from its default `SoftwareRenderer` to this SAME
#      `GlCanvas`'s own `Renderer` implementation, via `gl_renderer_of()`
#      (the interface-field-assignment workaround, see
#      toolkit/render/software_renderer.tr's own comment on why that
#      indirection exists). That is what actually routes their rounded
#      rects/circles/rings through the SDF shader instead of the CPU
#      rasterizer.
#
# The markup-driven chrome tree (`render_diff_to`) and the two free
# functions `draw_text`/`paint_section_label` still call `toolkit.ui.interp`'s
# CPU rasterizer directly (neither is routed through Renderer -- that never
# changed in phase 1 either), which still produce correct pixels here via
# GlCanvas's own Canvas.fill_rect/set_pixel (real GPU alpha-blended draws,
# just one shape at a time rather than batched into a single SDF quad) --
# correct output, not yet the fully-batched GPU path proposal-v6 describes
# for a future session.
#
# Run: .\scripts\build-desktop-gl.ps1 -Source examples\widgets_demo_gl\main.tr -OutDir build-widgets-demo-gl
#      .\build-widgets-demo-gl\app.exe

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, render_diff_to, render_into, register_handler, paint_rounded_rect_aa, draw_text
from toolkit.ui.ast import UiNode
from toolkit.render.desktop.sdl_canvas import poll_event, last_click, last_key, last_wheel_delta, mouse_state
from toolkit.render.desktop.gl_canvas import GlCanvas, gl_canvas_open, gl_renderer_of, caps
from toolkit.render.canvas import Canvas
from toolkit.text.font import Font
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.radio import Radio, select_only
from toolkit.ui.switch import Switch
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.ui.dropdown import Dropdown
from toolkit.ui.tabs import Tabs
from toolkit.ui.list import ScrollList

# Identical to examples/widgets_demo/main.tr's own tab_source -- see that
# file's header comment for why this exists (render_into() into a
# sub-rectangle, not a host-painted workaround).
def tab_source(idx: int) -> str:
    if idx == 0:
        return "<panel \"flex-row gap-2 bg-slate-800\">\n  <panel \"grow bg-red-500 rounded-[10px]\" />\n  <panel \"grow bg-green-500 rounded-[10px]\" />\n  <panel \"grow bg-blue-500 rounded-[10px]\" />\n</panel>\n"
    return "<panel \"flex-col gap-2 bg-slate-800\">\n  <text \"text-slate-200\">Widgets added this session:</text>\n  <panel \"h-0.5 bg-slate-500\" />\n  <panel \"flex-row gap-2 h-6\">\n    <button \"w-[70px] bg-blue-500 rounded-full justify-center items-center\">\n      <text \"text-white\">8 NEW</text>\n    </button>\n    <button \"w-[60px] bg-green-500 rounded-full justify-center items-center\">\n      <text \"text-slate-900\">LIVE</text>\n    </button>\n  </panel>\n</panel>\n"

def paint_section_label(c: Canvas, font: Font, text: str, x: int, y: int, w: int) -> void:
    draw_text(c, font, text, x, y, 0x94A3B8, 0x1E293B)
    c.fill_rect(x, y + 20, w, 1, 0x334155)

pub class OkHandler implements EventHandler:
    pub label: str

extend OkHandler:
    pub def init(label: str) -> OkHandler:
        mut h = OkHandler()
        h.label = label
        return h

    pub def handle(self, e: Event) -> void:
        print("  [host] " + self.label + " fired")

def main():
    mut w = 460
    mut h = 560
    mut canvas = gl_canvas_open("Tauraro UI Toolkit -- widgets_demo (GPU)", w, h)
    if not canvas.ok():
        print("failed to open a GL window/context")
        return
    mut gr = gl_renderer_of(canvas)

    mut it = Interpreter.init()
    mut ok = OkHandler.init("on_ok")
    mut cancel = OkHandler.init("on_cancel")
    register_handler(it, "on_ok", ok)
    register_handler(it, "on_cancel", cancel)

    mut chrome_src = "<panel \"flex-col p-4 gap-3 bg-slate-800\">\n  <panel \"h-16 bg-slate-700 border-slate-400 border rounded-xl p-[3px] items-center\">\n    <text \"text-white\">TAURARO WIDGETS</text>\n  </panel>\n  <panel \"h-[400px]\" />\n  <panel \"flex-row gap-[3px] h-10 p-[3px] bg-slate-700 rounded-lg\">\n    <button \"bg-amber grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_ok)>\n      <text \"text-black\">OK</text>\n    </button>\n    <button \"bg-red grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_cancel)>\n      <text \"text-white\">CANCEL</text>\n    </button>\n  </panel>\n</panel>\n"
    mut chrome_p = UiParser.init()
    mut chrome_tree = chrome_p.parse(chrome_src)
    chrome_p.report()

    mut ui_font = Font.load()

    mut tab_it = Interpreter.init()
    tab_it.root_bg = 0x1E293B
    mut tp0 = UiParser.init()
    mut tp1 = UiParser.init()
    mut tab_trees: List[Pointer[UiNode]] = [tp0.parse(tab_source(0)), tp1.parse(tab_source(1))]

    mut tabs = Tabs.init(["Cards", "Info"], 0)
    tabs.page_bg = 0x1E293B
    tabs.renderer = gr
    mut tx = 16
    mut ty = 92
    mut tw = 428
    mut th = 28

    mut content_x = 16
    mut content_y = 126
    mut content_w = 428
    mut content_h = 56

    mut prefs_label_y = 194

    mut notify_cb = Checkbox.init(true)
    notify_cb.page_bg = 0x1E293B
    notify_cb.renderer = gr
    mut ncx = 16
    mut ncy = 222
    mut nch = 18

    mut theme_label_y = 250

    mut theme_light = Radio.init(true)
    mut theme_dark = Radio.init(false)
    mut theme_auto = Radio.init(false)
    theme_light.page_bg = 0x1E293B
    theme_dark.page_bg = 0x1E293B
    theme_auto.page_bg = 0x1E293B
    theme_light.renderer = gr
    theme_dark.renderer = gr
    theme_auto.renderer = gr
    mut theme_group: List[Radio] = [theme_light, theme_dark, theme_auto]
    mut rrx = 16
    mut rry = 272
    mut rspacing = 100

    mut autoupdate_sw = Switch.init(false)
    autoupdate_sw.page_bg = 0x1E293B
    autoupdate_sw.renderer = gr
    mut swx = 384
    mut swy = 270
    mut sww = 44
    mut swh = 24

    mut appearance_label_y = 308

    mut brightness_sl = Slider.init(0, 100, 65)
    brightness_sl.page_bg = 0x1E293B
    brightness_sl.renderer = gr
    mut slx = 16
    mut sly = 332
    mut slw = 428
    mut slh = 22

    mut brightness_pb = ProgressBar.init(65)
    brightness_pb.page_bg = 0x1E293B
    brightness_pb.renderer = gr
    mut pbx = 16
    mut pby = 358
    mut pbw = 428
    mut pbh = 10

    mut accent_dd = Dropdown.init(["Blue", "Green", "Violet", "Amber"], 0)
    accent_dd.page_bg = 0x1E293B
    accent_dd.renderer = gr
    mut ddx = 16
    mut ddy = 380
    mut ddw = 200
    mut ddh = 30

    mut recent_label_y = 420

    mut recent_list = ScrollList.init(["Checkbox toggled", "Theme -> Dark", "Auto-update ON", "Brightness -> 80%", "Accent -> Violet", "Slider dragged", "Dropdown opened", "OK clicked", "Session started"])
    recent_list.renderer = gr
    mut lsx = 16
    mut lsy = 442
    mut lsw = 428
    mut lsh = 56

    print("GPU window open -- checkbox/radio/switch/slider/dropdown/list/tabs all live, real-alpha-blended GPU shapes. close the window to quit")

    canvas.clear(0x0B1120)

    mut running = true
    while running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                mut clk = last_click()
                tabs.click_inside(clk.x, clk.y, tx, ty, tw, th)
                notify_cb.click_inside(clk.x, clk.y, ncx, ncy, nch, nch)
                if theme_light.click_inside(clk.x, clk.y, rrx, rry, nch, nch):
                    select_only(theme_group, 0)
                if theme_dark.click_inside(clk.x, clk.y, rrx + rspacing, rry, nch, nch):
                    select_only(theme_group, 1)
                if theme_auto.click_inside(clk.x, clk.y, rrx + rspacing * 2, rry, nch, nch):
                    select_only(theme_group, 2)
                autoupdate_sw.click_inside(clk.x, clk.y, swx, swy, sww, swh)
                brightness_sl.press_inside(clk.x, clk.y, slx, sly, slw, slh)
                recent_list.click_inside(clk.x, clk.y, lsx, lsy, lsw, lsh)
                accent_dd.click_inside(clk.x, clk.y, ddx, ddy, ddw, ddh)
                it.dispatch(clk)
            elif code == 3:
                mut ke = last_key()
                it.dispatch(ke)
            elif code == 4:
                recent_list.scroll(last_wheel_delta(), lsh)

        if running:
            mut mx, my, mdown = mouse_state()
            it.hover_x = mx
            it.hover_y = my
            it.pressed = mdown
            accent_dd.hover_at(mx, my, ddx, ddy, ddw, ddh)
            if mdown:
                brightness_sl.drag_to(mx)
            else:
                brightness_sl.dragging = false
            brightness_pb.set_value(brightness_sl.value)
            autoupdate_sw.tick()

            # Full repaint every frame here, NOT render_diff_to's skip-
            # unchanged-commands path: true OpenGL double buffering swaps
            # between two DISTINCT physical buffers (SDL_GL_SwapWindow is a
            # real flip, not a copy/blit the way SDL2's 2D renderer present()
            # apparently is) -- anything diffing skips one frame never lands
            # in the OTHER physical buffer, so it flickers between two
            # different partial states every other frame. Every widget below
            # already repaints its own fixed rect unconditionally every
            # frame for the same underlying reason; chrome is the one place
            # that still tried to skip work, and a GPU redraw of one small
            # header/footer is cheap enough that skipping it was never
            # buying much here anyway.
            if caps().shadows:
                canvas.draw_shadow(16, 16, 428, 64, 12)
            render_to(it, chrome_tree, canvas)

            tabs.paint(canvas, tx, ty, tw, th)
            render_into(tab_it, tab_trees[tabs.selected_index], canvas, content_x, content_y, content_w, content_h, 0x1E293B)

            paint_section_label(canvas, ui_font, "PREFERENCES", 16, prefs_label_y, 428)
            notify_cb.paint(canvas, ncx, ncy, nch, nch)
            draw_text(canvas, ui_font, "Enable notifications", ncx + nch + 10, ncy + 1, 0xE2E8F0, 0x1E293B)

            draw_text(canvas, ui_font, "Theme", 16, theme_label_y, 0x94A3B8, 0x1E293B)
            theme_light.paint(canvas, rrx, rry, nch, nch)
            theme_dark.paint(canvas, rrx + rspacing, rry, nch, nch)
            theme_auto.paint(canvas, rrx + rspacing * 2, rry, nch, nch)
            draw_text(canvas, ui_font, "Auto-update", swx - 110, swy + 3, 0xE2E8F0, 0x1E293B)
            autoupdate_sw.paint(canvas, swx, swy, sww, swh)

            paint_section_label(canvas, ui_font, "APPEARANCE", 16, appearance_label_y, 428)
            brightness_sl.paint(canvas, slx, sly, slw, slh)
            brightness_pb.paint(canvas, pbx, pby, pbw, pbh)

            paint_section_label(canvas, ui_font, "RECENT ITEMS", 16, recent_label_y, 428)
            recent_list.paint(canvas, lsx, lsy, lsw, lsh)

            accent_dd.paint(canvas, ddx, ddy, ddw, ddh)

            canvas.present()

    canvas.close()
    print("window closed")
