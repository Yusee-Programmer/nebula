# examples/web_shell — a comprehensive "modern browser UI" demo, GPU/native
# quality end to end via toolkit.render.web.canvas2d_renderer.Canvas2DCanvas
# (proposal-v6 phase 3).
#
# Same freestanding-wasm shape as examples/web_demo/render_web.tr (see that
# file's own header for the load-bearing build flags and the "module-level
# initializers do not run here, persistent state is scalars only" rule this
# file follows just as strictly) -- extended to exercise every widget that
# already routes through `Renderer` (Phase 1): Checkbox, Radio (3-way group),
# Switch, Slider + ProgressBar, ScrollList. Every one of them "just worked"
# through Canvas2DCanvas with no widget-side changes at all, which is the
# entire point of the Renderer seam introduced back in phase 1.
#
# Unlike render_web.tr's WebCanvas build, THIS backend has no pixel buffer
# at all: every shape/text call crosses straight into a real
# ctx.roundRect/arc/fillText call in the host page (see index.html) --
# nebula_init needs no `alloc[u32](...)`, and the host page needs no
# `putImageData` step either. Real browser antialiasing and text shaping,
# not a bitmap font blown up from a baked atlas.
#
# TextInput is NOT included here: its own persistent state is a live text
# buffer + cursor position, not a handful of scalars, and this file's
# "module globals don't run on freestanding, everything is scalars"
# constraint (see render_web.tr's header) doesn't have a clean answer for
# that yet -- a real gap, not an oversight, left for a future pass.
#
#   tauraroc examples\web_shell\main.tr --target wasm --freestanding --emit c
#   zig build-exe -target wasm32-freestanding -fno-entry -rdynamic \
#       --import-symbols --export=__heap_base --initial-memory=... \
#       -cflags -w ... -- build/*.c
#
# (scripts/build-web.ps1 -Source examples\web_shell\main.tr -OutDir build-web-shell)

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler, draw_text
from toolkit.render.web.canvas2d_renderer import Canvas2DCanvas, canvas2d_renderer_of
from toolkit.text.font import Font
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.radio import Radio
from toolkit.ui.switch import Switch
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.ui.list import ScrollList
from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.platform.arena import arena_mark, arena_release, arena_used

pub export def nebula_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def nebula_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def nebula_free(p: Pointer[u8]):
    pass

@realloc
def nebula_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def nebula_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

# --- persistent state: scalars only, see render_web.tr's own header ---
mut _marked:       bool = false
mut _mark:         usize = 0 as usize
mut _frames:       int = 0
mut _clicks:       int = 0
mut _prev_btn:     bool = false
mut _cb_on:        bool = false
mut _sw_on:        bool = false
mut _sw_knob:      int = 0
mut _sl_val:       int = 65
mut _sl_dragging:  bool = false
mut _radio_sel:    int = 0
mut _scroll_off:   int = 0

def panel_bg() -> int:
    return 0x1E293B

pub class ClickHandler implements EventHandler:
    pub tag: int

extend ClickHandler:
    pub def init() -> ClickHandler:
        mut h = ClickHandler()
        h.tag = 0
        return h

    pub def handle(self, e: Event) -> void:
        _clicks = _clicks + 1

# Non-zero defaults are silently zero on a freestanding target (module
# initializers never run) -- assign them here instead, on a path the host
# actually calls. See render_web.tr's own header for the full story.
def reset_defaults() -> void:
    _sl_val = 65
    _cb_on = true
    _sw_on = false
    _sw_knob = 0
    _sl_dragging = false
    _radio_sel = 0
    _scroll_off = 0

pub export def nebula_init(width: int, height: int) -> void:
    reset_defaults()
    _mark = arena_mark()
    _marked = true

pub export def nebula_frames() -> int:
    return _frames

pub export def nebula_arena_used() -> int:
    return arena_used() as int

# One call per animation frame -- same host contract as render_web.tr's own
# nebula_frame, plus `wheel_delta` (positive = up / scroll-toward-start,
# the same convention SdlCanvas.last_wheel_delta() and the desktop tiers use)
# for the scroll list.
pub export def nebula_frame(width: int, height: int, mouse_x: int, mouse_y: int, buttons: int, key: int, wheel_delta: int) -> void:
    if not _marked:
        return

    arena_release(_mark)
    _frames = _frames + 1

    mut pressed = buttons != 0
    mut clicked = pressed and not _prev_btn
    _prev_btn = pressed

    mut canvas = Canvas2DCanvas.init(width, height)
    mut gr = canvas2d_renderer_of(canvas)
    mut font = Font.load()

    canvas.clear(0x0F172A)

    mut src = "<panel \"flex-col p-6 gap-4 bg-[#0F172A] items-center justify-center\">\n  <panel \"w-[600px] h-[560px] flex-col p-5 gap-4 bg-slate-800 rounded-2xl border border-slate-600\">\n    <panel \"h-12 bg-slate-700 rounded-xl px-4 items-center\">\n      <text \"text-slate-100\">NEBULA CANVAS2D -- MODERN BROWSER UI</text>\n    </panel>\n    <panel \"grow\" />\n    <panel \"flex-row gap-4 h-12\">\n      <button \"grow bg-sky-500 rounded-lg justify-center items-center\" @on_click(on_a)>\n        <text \"text-white\">SAVE</text>\n      </button>\n      <button \"grow bg-slate-600 rounded-lg border border-slate-400 justify-center items-center\" @on_click(on_b)>\n        <text \"text-slate-100\">RESET</text>\n      </button>\n    </panel>\n  </panel>\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it = Interpreter.init()
    it.root_bg = 0x0F172A
    register_handler(it, "on_a", ClickHandler.init())
    register_handler(it, "on_b", ClickHandler.init())
    it.hover_x = mouse_x
    it.hover_y = mouse_y
    it.pressed = pressed

    render_to(it, tree, canvas)

    mut card = it.root.children[0]
    mut ox = card.x
    mut oy = card.y
    mut inner_w = 560

    mut cby = oy + 76
    mut rry = cby + 44
    mut swy = rry + 44
    mut sly = swy + 46
    mut lsy = sly + 46
    mut lsh = 140

    mut cbx = ox + 20
    mut rrx = ox + 20
    mut rspacing = 130
    mut swx = ox + 20
    mut slx = ox + 20
    mut slw = inner_w
    mut lsx = ox + 20
    mut lsw = inner_w

    mut cb = Checkbox.init(_cb_on)
    cb.page_bg = panel_bg()
    cb.renderer = gr

    mut theme_light = Radio.init(_radio_sel == 0)
    mut theme_dark = Radio.init(_radio_sel == 1)
    mut theme_auto = Radio.init(_radio_sel == 2)
    theme_light.page_bg = panel_bg()
    theme_dark.page_bg = panel_bg()
    theme_auto.page_bg = panel_bg()
    theme_light.renderer = gr
    theme_dark.renderer = gr
    theme_auto.renderer = gr

    mut sw = Switch.init(_sw_on)
    sw.page_bg = panel_bg()
    sw.knob_pos = _sw_knob
    sw.renderer = gr

    mut sl = Slider.init(0, 100, _sl_val)
    sl.page_bg = panel_bg()
    sl.renderer = gr
    mut pb = ProgressBar.init(_sl_val)
    pb.page_bg = panel_bg()
    pb.renderer = gr

    mut items: List[str] = ["Checkbox toggled", "Theme -> Dark", "Auto-update ON", "Brightness -> 80%", "Slider dragged", "Canvas2D renderer live", "Native browser text", "Session started"]
    mut sl2 = ScrollList.init(items)
    sl2.scroll_offset = _scroll_off
    sl2.renderer = gr

    if clicked:
        cb.click_inside(mouse_x, mouse_y, cbx, cby, 20, 20)
        if theme_light.click_inside(mouse_x, mouse_y, rrx, rry, 18, 18):
            _radio_sel = 0
        if theme_dark.click_inside(mouse_x, mouse_y, rrx + rspacing, rry, 18, 18):
            _radio_sel = 1
        if theme_auto.click_inside(mouse_x, mouse_y, rrx + rspacing * 2, rry, 18, 18):
            _radio_sel = 2
        sw.click_inside(mouse_x, mouse_y, swx, swy, 48, 26)
        if sl.press_inside(mouse_x, mouse_y, slx, sly, slw, 24):
            _sl_dragging = true
        sl2.click_inside(mouse_x, mouse_y, lsx, lsy, lsw, lsh)
        it.dispatch(Event.click(mouse_x, mouse_y))
    if not pressed:
        _sl_dragging = false

    if wheel_delta != 0:
        sl2.scroll(wheel_delta, lsh)

    if _sl_dragging:
        sl.dragging = true
        sl.origin_x = slx
        sl.origin_w = slw
        sl.origin_h = 24
        sl.drag_to(mouse_x)
    sw.tick()

    _cb_on = cb.checked
    _sw_on = sw.on
    _sw_knob = sw.knob_pos
    _sl_val = sl.value
    _scroll_off = sl2.scroll_offset
    pb.set_value(_sl_val)

    cb.paint(canvas, cbx, cby, 20, 20)
    draw_text(canvas, font, "Enable notifications", cbx + 32, cby + 3, 0xE2E8F0, panel_bg())

    draw_text(canvas, font, "Theme", rrx, rry - 22, 0x94A3B8, panel_bg())
    theme_light.paint(canvas, rrx, rry, 18, 18)
    draw_text(canvas, font, "Light", rrx + 26, rry + 1, 0xE2E8F0, panel_bg())
    theme_dark.paint(canvas, rrx + rspacing, rry, 18, 18)
    draw_text(canvas, font, "Dark", rrx + rspacing + 26, rry + 1, 0xE2E8F0, panel_bg())
    theme_auto.paint(canvas, rrx + rspacing * 2, rry, 18, 18)
    draw_text(canvas, font, "Auto", rrx + rspacing * 2 + 26, rry + 1, 0xE2E8F0, panel_bg())

    sw.paint(canvas, swx, swy, 48, 26)
    draw_text(canvas, font, "Auto-update -- it animates", swx + 60, swy + 6, 0xE2E8F0, panel_bg())

    draw_text(canvas, font, "Brightness", slx, sly - 22, 0x94A3B8, panel_bg())
    sl.paint(canvas, slx, sly, slw, 24)
    pb.paint(canvas, slx, sly + 32, slw, 10)

    draw_text(canvas, font, "Recent items (scroll to see more)", lsx, lsy - 22, 0x94A3B8, panel_bg())
    sl2.paint(canvas, lsx, lsy, lsw, lsh)

    mut l1 = "frames " + _frames.to_str() + "   clicks " + _clicks.to_str() + "   xy " + mouse_x.to_str() + "," + mouse_y.to_str() + "   slider " + _sl_val.to_str()
    draw_text(canvas, font, l1, ox + 20, lsy + lsh + 14, 0x94A3B8, panel_bg())
    mut l2 = "arena " + arena_used().to_str() + " bytes -- Canvas2D renderer (proposal-v6 phase 3)"
    draw_text(canvas, font, l2, ox + 20, lsy + lsh + 32, 0x94A3B8, panel_bg())
