# examples/ide_demo -- "Nebula Studio", a genuinely IDE-shaped app built
# entirely from nebula markup tags (proposal-v6 phase 2, desktop half; see
# examples/ide_demo_web for the browser half of the same app).
#
# Where examples/widget_tags_demo proved the mechanism on a settings-panel-
# shaped screen, this proves it composes into something that reads as a
# real application: a top menu bar, a tab strip, a file sidebar, a content
# pane, and a status bar -- top bar and status bar are plain markup
# (`<button>`/`<panel>`/`<text>`, nothing new), the tab strip and sidebar
# are the two NEW phase-2 tags (`<tabitem>`/`<listitem>`), and the content
# pane's fourth "file" (Settings) is a real interactive panel using every
# phase-1 tag (checkbox/switch/radio/slider/progress) -- so "every widget
# the toolkit has as a tag" is literally exercised here, not just the two
# new ones.
#
# ## Two things NOT attempted here, on purpose (see the plan doc)
#
# File/Edit/View/Help are plain buttons with no working dropdown menu --
# MenuBar/Dropdown need a "conditionally-visible subtree" the markup/layout
# engine doesn't have yet. The editor pane shows STATIC styled text (faux
# syntax highlighting), never live-editable -- TextInput needs mutable text,
# which has no AST representation. Both are honest scope boundaries, not
# missing-and-pretending-otherwise.
#
# ## Two Interpreters, two hit-test roots
#
# `it` owns the persistent chrome (top bar, tab strip, sidebar, status bar).
# `content_it` owns whichever of the 4 pre-parsed editor-pane trees is
# active, painted into a fixed sub-rect via `render_into` -- the same
# "more than one hit-test root, each scoped to its own render_into call"
# pattern `examples/widgets_demo` already established for its own tab
# content. Settings is the only content tree with anything clickable in it,
# so `content_it.dispatch(...)` only needs calling while it's the active one.
#
# ## Keeping the tab strip and the sidebar in sync
#
# Both use the SAME group name, `active-file`, but different TAGS
# (`tabitem` vs `listitem`) -- `select_in_group`/`deselect_group_siblings`
# (toolkit/ui/interp.tr) match on (tag, group) together, so a sidebar click
# never clears the tab strip's own per-tab selected flags or vice versa.
# Clicking either side writes ONE shared key, `"G:active-file"` (the
# group-wide "which value is active" convenience key both tags write on
# click) -- the frame loop reads that key once and explicitly re-asserts
# every tab's and every row's own bare-node_key selected state to match it,
# the same "read one widget's state, drive another" pattern
# examples/widget_tags_demo's slider-drives-progress-bar already proved,
# just with two groups converging on one shared value instead of one value
# feeding one dependent widget.
#
# Run: .\scripts\build-desktop.ps1 -Source examples\ide_demo\main.tr -OutDir build-ide-demo
#      .\build-ide-demo\app.exe

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_diff_to, render_into, register_handler
from toolkit.ui.component import instantiate, one_slot, no_props
from toolkit.ui.ast import UiNode, box_node
from toolkit.render.desktop.sdl_canvas import SdlCanvas, poll_event, last_click, last_key, mouse_state

def b2i(b: bool) -> int:
    if b:
        return 1
    return 0

# The top bar's four labels are decorative (no dropdown -- see this file's
# own header), but still worth a real handler so they get the SAME hover
# darken every other `@on_click` box in this toolkit gets for free
# (Interpreter.emit's is_hot check, keyed on event_name != "").
pub class MenuHandler implements EventHandler:
    pub name: str

extend MenuHandler:
    pub def init(name: str) -> MenuHandler:
        mut h = MenuHandler()
        h.name = name
        return h

    pub def handle(self, e: Event) -> void:
        print("  [host] menu: " + self.name)

def main():
    mut w = 1000
    mut h = 680
    mut canvas = SdlCanvas.open_vsync("Nebula Studio -- IDE demo", w, h)
    if not canvas.ok():
        print("failed to open an SDL window/renderer")
        return

    mut it = Interpreter.init()
    it.root_bg = 0x0B1120
    mut m_file = MenuHandler.init("File")
    mut m_edit = MenuHandler.init("Edit")
    mut m_view = MenuHandler.init("View")
    mut m_help = MenuHandler.init("Help")
    register_handler(it, "on_file", m_file)
    register_handler(it, "on_edit", m_edit)
    register_handler(it, "on_view", m_view)
    register_handler(it, "on_help", m_help)

    # --- sidebar rows, built via the component model (toolkit.ui.component)
    # -- one small row template, instantiated 4 times with different props,
    # then spliced into the static app shell below through a named slot.
    mut row_src = "<listitem \"group-active-file value-{idx} {sel} key-file-{idx} px-2 h-8 items-center gap-2\">\n  <panel \"w-[10px] h-[10px] rounded-full bg-{color}\" />\n  <text \"text-slate-200\">{name}</text>\n</listitem>\n"
    mut row_p = UiParser.init()
    mut row_template = row_p.parse(row_src)

    mut names: List[str] = ["main.tr", "style.tr", "README.md", "Settings"]
    mut colors: List[str] = ["blue-500", "amber-500", "emerald-500", "violet-500"]
    mut sidebar_kids: List[Pointer[UiNode]] = []
    mut i = 0
    while i < 4:
        mut props = no_props()
        props["idx"] = i.to_str()
        props["name"] = names[i]
        props["color"] = colors[i]
        mut sel = ""
        if i == 0:
            sel = "selected"
        props["sel"] = sel
        sidebar_kids.append(instantiate(row_template, one_slot([]), props))
        i = i + 1
    mut sidebar_panel = box_node(UiNode.Element("panel", "w-[220px] bg-[#111827] flex-col p-3 gap-2", "", "", sidebar_kids))

    # --- the static app shell, with a named slot where the sidebar goes ---
    mut shell_src = "<panel \"flex-col bg-[#0B1120]\">\n  <panel \"flex-row items-center h-10 bg-[#111827] px-3 gap-2\">\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_file)>\n      <text \"text-slate-300\">File</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_edit)>\n      <text \"text-slate-300\">Edit</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_view)>\n      <text \"text-slate-300\">View</text>\n    </button>\n    <button \"px-3 h-7 rounded justify-center items-center\" @on_click(on_help)>\n      <text \"text-slate-300\">Help</text>\n    </button>\n    <panel \"grow\" />\n    <text \"text-slate-500\">NEBULA STUDIO</text>\n  </panel>\n\n  <panel \"flex-row items-end h-9 bg-[#0B1120] gap-1 px-2\">\n    <tabitem \"group-active-file value-0 selected key-tab-0 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">main.tr</text>\n    </tabitem>\n    <tabitem \"group-active-file value-1 key-tab-1 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">style.tr</text>\n    </tabitem>\n    <tabitem \"group-active-file value-2 key-tab-2 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">README.md</text>\n    </tabitem>\n    <tabitem \"group-active-file value-3 key-tab-3 px-4 h-9 items-center justify-center\">\n      <text \"text-slate-200\">Settings</text>\n    </tabitem>\n  </panel>\n\n  <panel \"flex-row grow\">\n    <slot \"sidebar\"/>\n    <panel \"grow bg-[#0F172A]\" />\n  </panel>\n\n  <panel \"flex-row items-center h-6 bg-[#111827] px-3 gap-4\">\n    <text \"text-slate-300\">main</text>\n    <panel \"grow\" />\n    <text \"text-slate-500\">Ln 12, Col 4</text>\n    <text \"text-slate-500\">Tauraro</text>\n  </panel>\n</panel>\n"
    mut shell_p = UiParser.init()
    mut shell_template = shell_p.parse(shell_src)
    mut slots: Dict[str, List[Pointer[UiNode]]] = {}
    slots["sidebar"] = [sidebar_panel]
    mut tree = instantiate(shell_template, slots, no_props())

    # --- editor-pane content: 3 static faux-code/prose panes + one real
    # interactive Settings panel (all 5 phase-1 tags) ---
    mut main_src = "<panel \"flex-col gap-1 p-3 bg-[#0F172A]\">\n  <text \"text-purple-400\">from toolkit.ui.parser import UiParser</text>\n  <text \"text-purple-400\">from toolkit.ui.interp import Interpreter, render_to</text>\n  <panel \"h-2\" />\n  <text \"text-blue-400\">def main():</text>\n  <text \"text-slate-200\">    mut it = Interpreter.init()</text>\n  <text \"text-green-400\">    # build the UI tree and render it</text>\n  <text \"text-slate-200\">    mut tree = UiParser.init().parse(src)</text>\n  <text \"text-slate-200\">    render_to(it, tree, canvas)</text>\n</panel>\n"
    mut style_src = "<panel \"flex-col gap-1 p-3 bg-[#0F172A]\">\n  <text \"text-blue-400\">.card {</text>\n  <text \"text-slate-200\">    background: #1e293b;</text>\n  <text \"text-slate-200\">    border-radius: 12px;</text>\n  <text \"text-slate-200\">}</text>\n  <panel \"h-2\" />\n  <text \"text-green-400\">/* accent tokens */</text>\n  <text \"text-blue-400\">.accent {</text>\n  <text \"text-slate-200\">    color: #3b82f6;</text>\n  <text \"text-slate-200\">}</text>\n</panel>\n"
    mut readme_src = "<panel \"flex-col gap-2 p-3 bg-[#0F172A]\">\n  <text \"text-white\">Nebula Studio</text>\n  <panel \"h-2\" />\n  <text \"text-slate-300\">A demo IDE shell built entirely from nebula markup tags --</text>\n  <text \"text-slate-300\">tabitem, listitem, checkbox, switch, radio, slider and</text>\n  <text \"text-slate-300\">progress, composed with the component model.</text>\n</panel>\n"
    mut settings_src = "<panel \"flex-col gap-4 p-3 bg-[#0F172A]\">\n  <text \"text-slate-300\">EDITOR SETTINGS</text>\n\n  <panel \"flex-row items-center gap-3\">\n    <checkbox \"key-set-autosave checked\"/>\n    <text \"text-slate-200\">Enable auto-save</text>\n  </panel>\n\n  <panel \"flex-row items-center gap-3\">\n    <switch \"key-set-format on\"/>\n    <text \"text-slate-200\">Format on save</text>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">Tab size</text>\n    <panel \"flex-row gap-6\">\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab2 group-tabsize selected\"/>\n        <text \"text-slate-200\">2</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab4 group-tabsize\"/>\n        <text \"text-slate-200\">4</text>\n      </panel>\n      <panel \"flex-row items-center gap-2\">\n        <radio \"key-set-tab8 group-tabsize\"/>\n        <text \"text-slate-200\">8</text>\n      </panel>\n    </panel>\n  </panel>\n\n  <panel \"flex-col gap-2\">\n    <text \"text-slate-400\">Font size</text>\n    <slider \"key-set-fontsize min-8 max-32 value-14 w-full\"/>\n    <progress \"key-set-fontsize-pb w-full\"/>\n  </panel>\n</panel>\n"

    mut content_trees: List[Pointer[UiNode]] = [UiParser.init().parse(main_src), UiParser.init().parse(style_src), UiParser.init().parse(readme_src), UiParser.init().parse(settings_src)]
    mut content_it = Interpreter.init()
    content_it.root_bg = 0x0F172A

    # Fixed pixel geometry, matching the shell's own fixed row heights
    # (h-10, h-9, h-6) and sidebar width (w-[220px]) -- same "hardcode the
    # sub-rect a static chrome layout implies" choice examples/widgets_demo
    # and examples/desktop_shell both already make, rather than walking
    # `it.root` to re-derive it every frame.
    mut content_x = 220
    mut content_y = 40 + 36
    mut content_w = w - 220
    mut content_h = h - (40 + 36) - 24

    print("window open -- tab strip / sidebar stay in sync; open Settings for checkbox/switch/radio/slider/progress. close the window to quit")

    canvas.clear(0x0B1120)

    mut running = true
    while running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                mut clk = last_click()
                it.dispatch(clk)
                if it.state_get("G:active-file", 0) == 3:
                    content_it.dispatch(clk)
            elif code == 3:
                mut ke = last_key()
                it.dispatch(ke)

        if running:
            mut mx, my, mdown = mouse_state()
            it.hover_x = mx
            it.hover_y = my
            it.pressed = mdown
            it.mouse_x = mx
            it.mouse_y = my
            content_it.hover_x = mx
            content_it.hover_y = my
            content_it.pressed = mdown
            content_it.mouse_x = mx
            content_it.mouse_y = my

            # Converge the tab strip and the sidebar on whichever one was
            # last clicked -- see this file's own header for why this needs
            # explicit re-assertion rather than falling out of the group
            # mechanism on its own (different tags never touch each
            # other's per-node selected state, only the shared "G:" key).
            mut active = it.state_get("G:active-file", 0)
            it.state_set("K:tab-0", b2i(active == 0))
            it.state_set("K:tab-1", b2i(active == 1))
            it.state_set("K:tab-2", b2i(active == 2))
            it.state_set("K:tab-3", b2i(active == 3))
            it.state_set("K:file-0", b2i(active == 0))
            it.state_set("K:file-1", b2i(active == 1))
            it.state_set("K:file-2", b2i(active == 2))
            it.state_set("K:file-3", b2i(active == 3))

            render_diff_to(it, tree, canvas)
            render_into(content_it, content_trees[active], canvas, content_x, content_y, content_w, content_h, 0x0F172A)

            if active == 3:
                # Same slider-drives-progress mirroring
                # examples/widget_tags_demo already proved, just mapped
                # from the slider's own 8..32 range onto the progress
                # bar's fixed 0..100 scale.
                mut fv = content_it.state_get("K:set-fontsize", 14)
                mut pct = (fv - 8) * 100 / (32 - 8)
                content_it.state_set("K:set-fontsize-pb", pct)

            canvas.present()

    canvas.close()
    print("window closed")
