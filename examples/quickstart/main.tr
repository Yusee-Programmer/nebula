# examples/quickstart — the smallest complete Nebula program.
#
#   tauraroc --run examples/quickstart/main.tr        (from the repo root)
#
# Five steps, and every tier is the same five: read markup, parse it, make an
# Interpreter, give it a Canvas, dispatch events at it. Only the Canvas
# changes between hosted / desktop / UEFI / bare-metal.

from io.file import File
from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.render.hosted.buffer import BufferCanvas

# 1. A handler is a class implementing EventHandler, not a function.
#    (An interface, because calling a first-class function value used to hang
#    on the freestanding tiers -- see CLAUDE.md. It also gives handlers a
#    place to keep state, which a bare function would not have.)
pub class Say implements EventHandler:
    pub label: str

extend Say:
    pub def init(label: str) -> Say:
        mut h = Say()
        h.label = label
        return h

    pub def handle(self, e: Event) -> void:
        print("  [handler] " + self.label + " clicked at (" + e.x.to_str() + "," + e.y.to_str() + ")")

def main():
    # 2. The UI is a string. Here it comes from disk; on bare metal it is a
    #    literal compiled into the image. Nothing else changes.
    mut src = File.read_text("examples/quickstart/app.ui")

    mut p = UiParser.init()
    mut tree = p.parse(src)
    p.report()          # malformed markup is reported, never fatal

    # 3. One Interpreter owns the style cache, the font, and the handler
    #    table. Keep it alive across renders -- that is what makes reloading
    #    a UI file cheap.
    mut it = Interpreter.init()
    it.root_bg = 0x0F172A     # MUST match the canvas clear color below:
                              # it is what antialiased edges blend against.

    register_handler(it, "on_save", Say.init("SAVE"))
    register_handler(it, "on_cancel", Say.init("CANCEL"))

    # 4. Pick a Canvas. This is the only tier-specific line in the file.
    mut canvas = BufferCanvas.init(360, 280, 0x0F172A)

    # render_to() is a free function on purpose: a method call would not
    # auto-upcast BufferCanvas to the Canvas interface.
    render_to(it, tree, canvas)
    canvas.save_ppm("examples/quickstart/out.ppm")
    print("wrote examples/quickstart/out.ppm")

    # 5. Events are hit-tested against the laid-out tree. Returns true only
    #    when a registered handler actually ran.
    print("dispatch:")
    print("  save button   -> " + it.dispatch(Event.click(100, 250)).to_str())
    print("  cancel button -> " + it.dispatch(Event.click(280, 250)).to_str())
    print("  empty space   -> " + it.dispatch(Event.click(10, 10)).to_str())
    print(it.stats())
