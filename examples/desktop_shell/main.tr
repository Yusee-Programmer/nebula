# examples/desktop_shell -- a bigger, multi-page desktop app: a top menu
# bar, a page switcher, and three real pages (Dashboard/Data Table/
# Settings) sharing one window, navigated with toolkit.ui.router.Router
# (proposal v5 section 9) the same way a real app would.
#
# Deliberately built on every lesson from examples/widgets_demo's diffing
# pass rather than repeating its mistakes:
#   - open_vsync(), not open() + a manual SDL_Delay -- see
#     toolkit.render.desktop.sdl_canvas.SdlCanvas.open_vsync's own comment.
#   - every host-painted widget's page_bg is set to the ACTUAL colour it
#     sits on (never left at a default that doesn't match), and every one
#     of them self-clears its own full box before drawing anything else --
#     see toolkit.ui.menubar.MenuBar/toolkit.ui.table.Table's own comments.
#   - chrome uses render_diff_to() from frame 1, never a plain render_to()
#     that would need a per-frame canvas.clear() to stay correct.
#   - larger corner radii (16px, not 10px) and more generous padding than
#     widgets_demo used -- a purely visual-design change, not a rasterizer
#     one; see docs/proposal/proposal-v5-components.md's note on why a
#     small radius looks "chunky" at any zoom, independent of the
#     antialiasing math being correct.
#
# Run from the repository root:
#   tauraroc examples\desktop_shell\main.tr -o build\desktop_shell.exe --link SDL2.lib

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_diff_to, draw_text, paint_rounded_rect_aa
from toolkit.render.desktop.sdl_canvas import SdlCanvas, poll_event, last_click, last_key, last_wheel_delta, mouse_state
from toolkit.text.font import Font
from toolkit.ui.router import Router
from toolkit.ui.menubar import MenuBar
from toolkit.ui.table import Table
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.radio import Radio, select_only
from toolkit.ui.switch import Switch
from toolkit.ui.textinput import TextInput

# Colours shared between the markup chrome below and every host-painted
# widget's page_bg -- see toolkit.ui.palette.color_shade for where these
# come from (slate-900/800/700). Kept as named constants here rather than
# repeating the hex four times, the mismatch that made every widget in
# widgets_demo blend its antialiased edges against the wrong backdrop.
def bg_outer() -> int:
    return 0x0F172A

def bg_panel() -> int:
    return 0x1E293B

def bg_menubar() -> int:
    return 0x111827

# The chrome tree is intentionally almost empty -- one full-width reserved
# row for the (host-painted) MenuBar, then a padded body containing a
# reserved row for the (host-painted) page-switcher and the content
# panel's own rounded background. Every actual page's content is painted
# by the host on top of that panel, the same layering
# examples/widgets_demo's h-[400px] spacer used, just with a bigger radius.
def chrome_src() -> str:
    return "<panel \"flex-col bg-slate-900\">\n  <panel \"h-[32px]\" />\n  <panel \"grow flex-col p-4 gap-4\">\n    <panel \"h-[32px]\" />\n    <panel \"grow bg-slate-800 rounded-[16px]\" />\n  </panel>\n</panel>\n"

def main():
    mut w = 900
    mut h = 650
    mut canvas = SdlCanvas.open_vsync("Nebula Desktop Shell", w, h)
    if not canvas.ok():
        print("failed to open an SDL window/renderer")
        return

    mut it = Interpreter.init()
    mut chrome_p = UiParser.init()
    mut chrome_tree = chrome_p.parse(chrome_src())
    chrome_p.report()

    # Geometry -- hand-derived from chrome_src()'s own flex spec (p-4 = 16px,
    # gap-4 = 16px, two h-[32px] reserved rows), the same "the host knows
    # exactly where its own markup laid things out" approach every demo in
    # this repo uses (layout_tree has no public position-query API to read
    # this back dynamically).
    mut menubar_x = 0
    mut menubar_y = 0
    mut menubar_w = w
    mut menubar_h = 32

    mut nav_x = 16
    mut nav_y = 48
    mut nav_w = w - 32
    mut nav_h = 32

    mut panel_x = 16
    mut panel_y = 96
    mut panel_w = w - 32
    mut panel_h = h - 96 - 16

    mut inner_x = panel_x + 24
    mut inner_y = panel_y + 24
    mut inner_w = panel_w - 48

    mut router = Router.init()
    mut empty_tpl_p = UiParser.init()
    mut empty_tpl = empty_tpl_p.parse("<panel \"\" />\n")
    router.register("dashboard", empty_tpl)
    router.register("data", empty_tpl)
    router.register("settings", empty_tpl)
    router.navigate("dashboard", {})

    mut page_names: List[str] = ["dashboard", "data", "settings"]

    mut menubar = MenuBar.init(
        ["File", "Edit", "View", "Help"],
        [4, 3, 3, 1],
        ["New", "Open", "Save", "Exit", "Cut", "Copy", "Paste", "Dashboard", "Data Table", "Settings", "About"],
    )
    menubar.bg = bg_menubar()
    menubar.page_bg = bg_outer()

    mut nav_items: List[str] = []
    mut nav = MenuBar.init(["Dashboard", "Data Table", "Settings"], [0, 0, 0], nav_items)
    nav.bg = bg_outer()
    nav.page_bg = bg_outer()
    nav.hover_bg = bg_panel()

    mut ui_font = Font.load()

    # ---- Dashboard page state ----
    mut brightness_sl = Slider.init(0, 100, 65)
    brightness_sl.page_bg = bg_panel()
    mut slx = inner_x
    mut sly = inner_y + 90
    mut slw = inner_w
    # Bumped from 22 to 32: the thumb's radius is h/2, and the antialiasing
    # is now analytic (toolkit.ui.interp.analytic_coverage, a true distance
    # ramp, not supersampling -- see its own comment) rather than
    # resolution-limited to begin with. Kept the larger radius anyway: more
    # actual pixels still means a visibly rounder curve at normal viewing
    # size, independent of how good the antialiasing math is.
    mut slh = 32

    mut brightness_pb = ProgressBar.init(65)
    brightness_pb.page_bg = bg_panel()
    mut pbx = inner_x
    # Was a flat "+34", calibrated back when slh was 22 (slider bottom at
    # sly+22, leaving a 12px gap to this bar) -- bumping slh to 32 without
    # updating this shrank that gap to 2px, tight enough that the thumb's
    # own antialiased edge (see Slider.paint()'s clear-margin comment) could
    # reach past its own widget's bottom edge into this one's space. Sized
    # off slh directly so the gap stays constant if either widget's size
    # changes again.
    mut pby = sly + slh + 12
    mut pbw = inner_w
    mut pbh = 10

    # ---- Data page state ----
    mut table_rows: List[List[str]] = [
        ["nebula-core", "green", "you", "2026-09-08"],
        ["render-diff", "yellow", "you", "2026-09-08"],
        ["menu-bar", "green", "you", "2026-09-08"],
        ["table-widget", "green", "you", "2026-09-08"],
        ["router", "green", "you", "2026-09-08"],
        ["component-model", "green", "you", "2026-09-08"],
        ["vsync-fix", "green", "you", "2026-09-08"],
        ["aa-corners", "yellow", "you", "2026-09-08"],
    ]
    mut table = Table.init(["Task", "Status", "Owner", "Date"], table_rows)
    mut tblx = panel_x + 12
    mut tbly = panel_y + 12
    mut tblw = panel_w - 24
    mut tblh = panel_h - 24

    # ---- Settings page state ----
    mut notify_cb = Checkbox.init(true)
    notify_cb.page_bg = bg_panel()
    mut ncx = inner_x
    mut ncy = inner_y
    # Bumped from 18 to 24 -- same reasoning as the slider above: Checkbox's
    # own rounded corners/checkmark are correctly antialiased already, they
    # just need more pixels to look smooth at normal viewing size.
    mut nch = 24

    mut theme_light = Radio.init(true)
    mut theme_dark = Radio.init(false)
    mut theme_auto = Radio.init(false)
    theme_light.page_bg = bg_panel()
    theme_dark.page_bg = bg_panel()
    theme_auto.page_bg = bg_panel()
    mut theme_group: List[Radio] = [theme_light, theme_dark, theme_auto]
    mut rrx = inner_x
    mut rry = ncy + 56
    mut rspacing = 120

    mut autoupdate_sw = Switch.init(false)
    autoupdate_sw.page_bg = bg_panel()
    mut swx = inner_x
    mut swy = rry + 56
    mut sww = 56
    mut swh = 30

    # TextInput is host-side, not markup (see its own file header for why:
    # the AST has no mutable-text-node concept) -- same page_bg-threading
    # and click_inside/handle_key/tick wiring every other host-painted
    # widget in this file already uses.
    mut display_name = TextInput.init(24)
    display_name.page_bg = bg_panel()
    mut dnx = inner_x
    mut dny = swy + 56
    mut dnw = 320
    mut dnh = 40

    print("desktop_shell open -- File/Edit/View/Help menus, Dashboard/Data Table/Settings pages. close the window to quit")

    # menubar's open item list can extend below the bar into the nav strip
    # (and, for a menu with enough items, into the content panel) -- when it
    # CLOSES, that footprint is not something the content panel's own
    # unchanging rounded-rect Cmd will ever repaint (diffing correctly sees
    # it as unchanged), and nothing else clears it either. Same fix as
    # examples/widgets_demo's Dropdown guard: force one full chrome repaint
    # the frame the menu closes.
    #
    # Tracked as the actual INDEX, not just an open/closed bool: clicking
    # directly from one open menu's label to a DIFFERENT one's (File ->
    # Edit -> View -> Help without ever passing through "closed") changes
    # open_index without it ever going negative, so a bool guard misses
    # every one of those transitions -- each label sits at a different x
    # and each menu has a different item count, so switching directly
    # between two open menus needs the same "something else's footprint
    # must be cleared" fix as actually closing one. Confirmed by
    # reproducing it: clicking through all four menus left every one of
    # their dropdowns ghosted on screen simultaneously.
    mut menubar_prev_open_index = 0 - 1
    # Which route was on screen last frame -- switching pages only redraws
    # the NEW page's own widgets; nothing erases the OLD page's leftovers
    # first unless something explicitly clears the whole content panel.
    mut last_page = ""
    mut running = true
    while running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                mut clk = last_click()
                mut mb_hit = menubar.click_inside(clk.x, clk.y, menubar_x, menubar_y, menubar_w, menubar_h)
                if mb_hit and menubar.clicked_menu == 2:
                    router.navigate(page_names[menubar.clicked_item], {})
                if not mb_hit:
                    mut nav_hit = nav.click_inside(clk.x, clk.y, nav_x, nav_y, nav_w, nav_h)
                    # nav's own per-menu item lists are empty (it is being
                    # reused purely as "a row of labels, one highlighted",
                    # not a real dropdown strip -- see its own comment
                    # above), so a label click surfaces as click_inside
                    # setting open_index to that label's index rather than
                    # clicked_menu/clicked_item (which only fire for an
                    # ITEM pick from an open list, and this one never has
                    # any items to pick). Read it immediately, then put it
                    # back to "nothing open" so it never actually behaves
                    # like a dropdown.
                    if nav_hit and nav.open_index >= 0:
                        router.navigate(page_names[nav.open_index], {})
                    nav.open_index = 0 - 1
                    if router.current == "dashboard":
                        brightness_sl.press_inside(clk.x, clk.y, slx, sly, slw, slh)
                    elif router.current == "data":
                        table.click_inside(clk.x, clk.y, tblx, tbly, tblw, tblh)
                    elif router.current == "settings":
                        notify_cb.click_inside(clk.x, clk.y, ncx, ncy, nch, nch)
                        if theme_light.click_inside(clk.x, clk.y, rrx, rry, nch, nch):
                            select_only(theme_group, 0)
                        if theme_dark.click_inside(clk.x, clk.y, rrx + rspacing, rry, nch, nch):
                            select_only(theme_group, 1)
                        if theme_auto.click_inside(clk.x, clk.y, rrx + rspacing * 2, rry, nch, nch):
                            select_only(theme_group, 2)
                        autoupdate_sw.click_inside(clk.x, clk.y, swx, swy, sww, swh)
                        # Clicking anywhere on the Settings page other than
                        # the field itself must still reach click_inside --
                        # it's what blurs the field on an outside click (see
                        # its own comment) -- so this isn't gated behind "did
                        # something else already handle the click" the way
                        # some of the widgets above are.
                        display_name.click_inside(clk.x, clk.y, dnx, dny, dnw, dnh)
            elif code == 3:
                mut ke = last_key()
                if router.current == "settings":
                    display_name.handle_key(ke.code)
            elif code == 4:
                if router.current == "data":
                    table.scroll(last_wheel_delta(), tblh)

        if running:
            # The two secondary-nav "tabs" (View menu + the Dashboard/Data
            # Table/Settings strip) can each change the current route --
            # keep the strip's own open/hover bookkeeping pointed at
            # whichever route is ACTUALLY current, even when the menu bar
            # was what changed it.
            mut cur_idx = 0
            mut ci = 0
            while ci < len(page_names):
                if page_names[ci] == router.current:
                    cur_idx = ci
                ci = ci + 1
            nav.open_index = 0 - 1

            mut mx, my, mdown = mouse_state()
            menubar.hover_at(mx, my, menubar_x, menubar_y, menubar_w, menubar_h)
            nav.hover_at(mx, my, nav_x, nav_y, nav_w, nav_h)
            if router.current == "dashboard":
                if mdown:
                    brightness_sl.drag_to(mx)
                else:
                    brightness_sl.dragging = false
                brightness_pb.set_value(brightness_sl.value)
            elif router.current == "data":
                table.hover_at(mx, my, tblx, tbly, tblw, tblh)
            elif router.current == "settings":
                autoupdate_sw.tick()
                display_name.tick()

            # File/Edit/View/Help's open item list just closed OR switched
            # to a different menu -- force one full chrome repaint so it
            # overpaints whatever the PREVIOUS dropdown was covering (the
            # nav strip, and for a long enough menu, part of the content
            # panel too). See this variable's own declaration above for the
            # full reasoning, including why this has to fire on ANY index
            # change, not just a transition to "nothing open".
            if menubar.open_index != menubar_prev_open_index:
                it.has_last_scene = false
            menubar_prev_open_index = menubar.open_index

            render_diff_to(it, chrome_tree, canvas)

            # The content panel's own background is ONE static rounded-rect
            # Cmd that never changes, so diffing always skips repainting it
            # -- correct for chrome, but it means switching pages does NOT
            # erase whatever the PREVIOUS page's host-painted widgets drew
            # here (see this file's header comment on layering). Clearing
            # the whole panel explicitly, once, whenever the current page
            # changes keeps every page responsible for its own area without
            # relying on any single widget's own self-clear rect happening
            # to line up with every OTHER widget/label this page draws.
            if router.current != last_page:
                # Same radius (16px) and ambient (bg_outer -- what actually
                # sits outside the panel, per chrome_src()'s own rounded-
                # [16px] panel on bg-slate-900) chrome_src()'s panel already
                # used -- a flat fill_rect here would square off corners
                # chrome had already rounded.
                paint_rounded_rect_aa(canvas, panel_x, panel_y, panel_w, panel_h, 16, bg_panel(), bg_outer())
                last_page = router.current

            # nav strip: draw the three page labels, highlighting the
            # CURRENT route rather than a hover-only state -- reuses
            # MenuBar's own label layout/paint since a plain "row of
            # labels, one highlighted" is exactly what it already does
            # with an always-closed dropdown (items are empty lists).
            mut save_hover = nav.hover_menu
            if nav.hover_menu < 0:
                nav.hover_menu = cur_idx
            nav.paint(canvas, nav_x, nav_y, nav_w, nav_h)
            nav.hover_menu = save_hover

            if router.current == "dashboard":
                # No separate "Dashboard" title drawn here: the nav strip
                # right above already shows which page is current, and
                # inner_y - 34 sits ABOVE panel_y (in chrome's own gap-4
                # strip between the nav row and the content panel) -- text
                # placed there falls outside this file's page-switch clear
                # rect (see its own comment), so it survived as a ghost
                # under whichever page painted next. Simplest fix: nothing
                # this page draws should sit outside the panel it owns.
                paint_rounded_rect_aa(canvas, inner_x, inner_y, 190, 70, 12, 0x1E3A8A, bg_panel())
                draw_text(canvas, ui_font, "Active tasks", inner_x + 14, inner_y + 12, 0xBFDBFE, 0x1E3A8A)
                draw_text(canvas, ui_font, "8", inner_x + 14, inner_y + 34, 0xF8FAFC, 0x1E3A8A)
                paint_rounded_rect_aa(canvas, inner_x + 206, inner_y, 190, 70, 12, 0x14532D, bg_panel())
                draw_text(canvas, ui_font, "Done today", inner_x + 220, inner_y + 12, 0xBBF7D0, 0x14532D)
                draw_text(canvas, ui_font, "6", inner_x + 220, inner_y + 34, 0xF8FAFC, 0x14532D)
                draw_text(canvas, ui_font, "Brightness", slx, sly - 22, 0x94A3B8, bg_panel())
                brightness_sl.paint(canvas, slx, sly, slw, slh)
                brightness_pb.paint(canvas, pbx, pby, pbw, pbh)
            elif router.current == "data":
                table.paint(canvas, tblx, tbly, tblw, tblh)
            elif router.current == "settings":
                notify_cb.paint(canvas, ncx, ncy, nch, nch)
                draw_text(canvas, ui_font, "Enable notifications", ncx + nch + 10, ncy + 1, 0xE2E8F0, bg_panel())
                draw_text(canvas, ui_font, "Theme", rrx, rry - 24, 0x94A3B8, bg_panel())
                theme_light.paint(canvas, rrx, rry, nch, nch)
                theme_dark.paint(canvas, rrx + rspacing, rry, nch, nch)
                theme_auto.paint(canvas, rrx + rspacing * 2, rry, nch, nch)
                draw_text(canvas, ui_font, "Auto-update", swx, swy - 24, 0x94A3B8, bg_panel())
                autoupdate_sw.paint(canvas, swx, swy, sww, swh)
                draw_text(canvas, ui_font, "Display name", dnx, dny - 24, 0x94A3B8, bg_panel())
                display_name.paint(canvas, dnx, dny, dnw, dnh)

            # Menu bar paints LAST, same reason Dropdown/MenuBar's own
            # header comments give: its open item list must sit on top of
            # every page's own content.
            menubar.paint(canvas, menubar_x, menubar_y, menubar_w, menubar_h)

            canvas.present()

    canvas.close()
    print("window closed")
