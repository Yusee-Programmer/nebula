# examples/web_demo/render_web.tr — Nebula in a browser tab.
#
# The fifth platform, and the one that shares the least with the others: no
# framebuffer, no firmware, no OS window. It still needed only
# toolkit/render/web/canvas.tr plus this file, because everything above the
# pixel never learns where it is running.
#
# ## The interop shape (settled by probe before any of this was written)
#
#   tauraroc x.tr --target wasm --freestanding --emit c
#   zig build-exe -target wasm32-freestanding -fno-entry -rdynamic \
#       --export=__heap_base --initial-memory=... -cflags -w ... -- build/*.c
#
# Facts that shape everything below, each confirmed by running a probe rather
# than by reading docs:
#
#   * `--target wasm` alone FAILS: tauraro_rt.h includes <stdio.h> and bare
#     wasm has no libc. `--freestanding` defines TAURARO_KERNEL, which is what
#     turns that off -- the same mechanism the UEFI and Cortex-M tiers use.
#   * `pub export def` is NOT enough on its own. wasm-ld drops unreferenced
#     symbols, so without `-rdynamic` the module exports only `memory` and
#     `_start`, and every call from JS fails with "not a function".
#   * The result has ZERO imports. No WASI shim, no JS glue contract to
#     maintain -- the host page only needs WebAssembly.instantiate.
#   * Tauraro `int` is i64, so it arrives in JS as BigInt; `Pointer[T]` is a
#     plain i32 Number. Calls that mix them need `frame(ptr, 640n, ...)`.
#   * `__heap_base` is where static data ends. Exporting it is how the host
#     learns a safe arena base without guessing.
#
# ## Why the allocator hooks have long names
#
# A `@calloc def c(...)` emits `#define TAURARO_CALLOC(n,sz) c(n,sz)`, and
# tauraro_rt.h has its own local variables named `c`. The macro then expands
# inside the runtime and fails with "called object type '_TrChan *' is not a
# function". Allocator hook names are effectively global macros: keep them
# distinctive.

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.ui.interp import draw_text, fill_circle_aa
from toolkit.render.web.canvas import WebCanvas
from toolkit.text.font import Font
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.switch import Switch
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.platform.arena import arena_mark, arena_release, arena_used

pub export def nebula_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def nebula_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def nebula_free(p: Pointer[u8]):
    pass

@realloc
def nebula_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def nebula_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

# --- persistent state: scalars only ----------------------------------------
#
# ## Module-level initializers DO NOT RUN on a freestanding target
#
# Verified by probe, not inferred: `mut x: int = 42` reads back as 0, and so
# do `= 6 * 7`, `= true` and `= 99 as usize`. The generated C puts global
# initialization in a module-init routine that only runs from main/_start,
# and a freestanding entry point like nebula_frame() is called directly by
# the host without any of that ever happening.
#
# Two consequences, and the second is the nastier one:
#
#   1. A `mut x = SomeClass.init()` global is permanently NULL. It looks like
#      it should work, and fails much later as a null dereference far from
#      the declaration. So the persistent state here is scalars only, and
#      everything else is rebuilt each frame and reclaimed by the release.
#   2. A scalar with a non-zero default is SILENTLY ZERO. Nothing crashes;
#      the UI just renders with the wrong value, which is how a slider that
#      declared `= 55` sat at 0 through several screenshots before anyone
#      noticed. Non-zero defaults must be assigned on a path the host calls
#      -- see reset_defaults().
mut _marked:   bool = false
mut _mark:     usize = 0 as usize
mut _pixels:   Pointer[u32] = 0 as Pointer[u32]
mut _frames:   int = 0
mut _clicks:   int = 0
mut _prev_btn: bool = false
mut _cb_on:    bool = false
mut _sw_on:    bool = false
mut _sw_knob:  int = 0
mut _sl_val:   int = 55   # NOT the real default -- see reset_defaults()
# Whether a slider drag is currently in progress -- has to be its OWN
# persistent scalar (see this file's header on why: only scalars survive
# across frames here). `Slider.press_inside`/`drag_to` were designed for a
# host that keeps ONE long-lived Slider object across frames (see
# toolkit.ui.slider's own header) -- this file instead reconstructs a fresh
# `Slider` every frame (same "persistent state: scalars only" constraint),
# so `sl.dragging` can never carry forward past the frame it was set on.
# Read this scalar back into the fresh Slider's own `dragging`/`origin_*`
# fields every frame a drag is active (see nebula_frame below) instead.
mut _sl_dragging: bool = false

def panel_bg() -> int:
    return 0x1E293B

pub class ClickHandler implements EventHandler:
    pub tag: int

extend ClickHandler:
    pub def init() -> ClickHandler:
        mut h = ClickHandler()
        h.tag = 0
        return h

    pub def handle(self, e: Event) -> void:
        _clicks = _clicks + 1

# The pixel buffer, allocated once and never freed. The host asks for its byte
# offset with nebula_pixels() and wraps THOSE EXACT BYTES in an ImageData --
# there is no copy on this side, and no serialization anywhere.
# Module-level `mut` initializers DO NOT RUN on a freestanding target -- see
# this file's header. Every global starts zeroed regardless of what its
# declaration says, so any non-zero default has to be assigned here, on a
# path the host actually calls.
def reset_defaults() -> void:
    _sl_val = 55
    _cb_on = false
    _sw_on = false
    _sw_knob = 0
    _sl_dragging = false

pub export def nebula_init(width: int, height: int) -> usize:
    unsafe:
        _pixels = alloc[u32](width * height)
    reset_defaults()
    _mark = arena_mark()
    _marked = true
    # Returns a BYTE OFFSET, not a pointer, for two reasons: the compiler
    # rejects returning a module-level Pointer from a function ([L-1], since
    # it cannot prove the lifetime), and an offset is what JS needs to index
    # linear memory with anyway.
    #
    # NOTE: this arrives in JS as a BigInt, not a Number -- Tauraro usize is
    # i64 in the wasm ABI even on wasm32. Only Pointer[T] comes across as a
    # plain i32 Number. Number() it before using it as an array offset.
    unsafe:
        return _pixels as usize

pub export def nebula_frames() -> int:
    return _frames

pub export def nebula_arena_used() -> int:
    return arena_used() as int

# One call per animation frame, from requestAnimationFrame. Everything the UI
# needs to know about the outside world, flattened to integers -- the same
# boundary the UEFI stub uses, so the two hosts are interchangeable from the
# toolkit's point of view.
pub export def nebula_frame(width: int, height: int, mouse_x: int, mouse_y: int, buttons: int, key: int) -> void:
    if not _marked:
        return

    arena_release(_mark)
    _frames = _frames + 1

    mut pressed = buttons != 0
    # Rising edge only: a held button must not retrigger sixty times a second.
    mut clicked = pressed and not _prev_btn
    _prev_btn = pressed

    mut canvas = WebCanvas.init(_pixels, width, height)
    mut font = Font.load()

    mut src = "<panel \"flex-col p-6 gap-4 bg-[#0F172A] items-center justify-center\">\n  <panel \"w-[560px] h-[380px] flex-col p-5 gap-4 bg-slate-800 rounded-2xl border border-slate-600\">\n    <panel \"h-12 bg-slate-700 rounded-xl px-4 items-center\">\n      <text \"text-slate-100\">NEBULA IN THE BROWSER</text>\n    </panel>\n    <panel \"grow\" />\n    <panel \"flex-row gap-4 h-12\">\n      <button \"grow bg-sky-500 rounded-lg justify-center items-center\" @on_click(on_a)>\n        <text \"text-white\">CLICK ME</text>\n      </button>\n      <button \"grow bg-slate-600 rounded-lg border border-slate-400 justify-center items-center\" @on_click(on_b)>\n        <text \"text-slate-100\">OR ME</text>\n      </button>\n    </panel>\n  </panel>\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it = Interpreter.init()
    it.root_bg = 0x0F172A
    register_handler(it, "on_a", ClickHandler.init())
    register_handler(it, "on_b", ClickHandler.init())
    it.hover_x = mouse_x
    it.hover_y = mouse_y
    it.pressed = pressed

    render_to(it, tree, canvas)

    mut card = it.root.children[0]
    mut ox = card.x
    mut oy = card.y

    mut cbx = ox + 20
    mut cby = oy + 76
    mut swx = ox + 20
    mut swy = oy + 116
    mut slx = ox + 20
    mut sly = oy + 160
    mut slw = 520

    mut cb = Checkbox.init(_cb_on)
    cb.page_bg = panel_bg()
    mut sw = Switch.init(_sw_on)
    sw.page_bg = panel_bg()
    sw.knob_pos = _sw_knob
    mut sl = Slider.init(0, 100, _sl_val)
    sl.page_bg = panel_bg()
    mut pb = ProgressBar.init(_sl_val)
    pb.page_bg = panel_bg()

    if clicked:
        cb.click_inside(mouse_x, mouse_y, cbx, cby, 20, 20)
        sw.click_inside(mouse_x, mouse_y, swx, swy, 48, 26)
        it.dispatch(Event.click(mouse_x, mouse_y))
        if sl.press_inside(mouse_x, mouse_y, slx, sly, slw, 24):
            _sl_dragging = true
    if not pressed:
        _sl_dragging = false

    # `sl` is a fresh object THIS frame -- press_inside's hit-test (rejecting
    # a click far from the thumb) is only meaningful on the frame a drag
    # STARTS. Once `_sl_dragging` is latched, prime this frame's Slider
    # directly from that persistent flag and drag unconditionally: a real
    # drag moves the mouse away from the thumb's last position by design,
    # so re-running the hit-test every frame would cancel the drag as soon
    # as the mouse moved (see this file's header on why persistence has to
    # go through scalars, not the Slider object itself).
    if _sl_dragging:
        sl.dragging = true
        sl.origin_x = slx
        sl.origin_w = slw
        sl.origin_h = 24
        sl.drag_to(mouse_x)
    sl.paint(canvas, slx, sly, slw, 24)
    sw.tick()

    _cb_on = cb.checked
    _sw_on = sw.on
    _sw_knob = sw.knob_pos
    _sl_val = sl.value
    pb.set_value(_sl_val)

    cb.paint(canvas, cbx, cby, 20, 20)
    draw_text(canvas, font, "Checkbox -- click it", cbx + 32, cby + 3, 0xE2E8F0, panel_bg())
    sw.paint(canvas, swx, swy, 48, 26)
    draw_text(canvas, font, "Switch -- it animates", swx + 60, swy + 6, 0xE2E8F0, panel_bg())
    pb.paint(canvas, ox + 20, oy + 196, slw, 10)

    mut l1 = "frames " + _frames.to_str() + "   clicks " + _clicks.to_str() + "   xy " + mouse_x.to_str() + "," + mouse_y.to_str() + "   slider " + _sl_val.to_str()
    draw_text(canvas, font, l1, ox + 20, oy + 226, 0x94A3B8, panel_bg())
    mut l2 = "arena " + arena_used().to_str() + " bytes -- same engine as UEFI, SDL2 and bare metal"
    draw_text(canvas, font, l2, ox + 20, oy + 244, 0x94A3B8, panel_bg())

    # The cursor is the browser's job here, not ours -- unlike UEFI, where
    # nothing else in the machine would draw one.
