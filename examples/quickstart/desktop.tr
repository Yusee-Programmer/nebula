# examples/quickstart/desktop.tr — the same UI, in a real window.
#
#   tauraroc examples\quickstart\desktop.tr -o build\quickstart.exe --link SDL2.lib
#   copy SDL2.dll build\   &&   build\quickstart.exe
#
# Compare against main.tr: the markup, the handlers, the Interpreter and the
# dispatch call are all IDENTICAL. Three things are added, and all three are
# about being live rather than about the UI:
#
#   1. SdlCanvas instead of BufferCanvas.
#   2. An event loop that drains SDL events and turns them into Event.click.
#   3. Per-frame hover/press state, which is what makes buttons light up
#      under the cursor -- Interpreter.paint darkens any box wired to an
#      event when hover_x/hover_y fall inside it.

from io.file import File
from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.render.desktop.sdl_canvas import SdlCanvas, poll_event, last_click, mouse_state
from toolkit.render.desktop.sdl_bindings import SDL_Delay, Uint32

pub class Say implements EventHandler:
    pub label: str

extend Say:
    pub def init(label: str) -> Say:
        mut h = Say()
        h.label = label
        return h

    pub def handle(self, e: Event) -> void:
        print("[handler] " + self.label + " clicked")

def main():
    mut src = File.read_text("examples/quickstart/app.ui")
    mut p = UiParser.init()
    mut tree = p.parse(src)
    p.report()

    mut it = Interpreter.init()
    it.root_bg = 0x0F172A
    register_handler(it, "on_save", Say.init("SAVE"))
    register_handler(it, "on_cancel", Say.init("CANCEL"))

    mut canvas = SdlCanvas.open("Nebula Quickstart", 500, 500)
    if not canvas.ok():
        print("SDL window failed to open")
        return

    print("window open -- click the buttons, close the window to quit")

    mut running = true
    while running:
        # Drain EVERY pending event each frame. One poll per frame would lag
        # behind under fast input; and there must be exactly one PollEvent
        # call site, or two would steal each other's events.
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false
            elif code == 2:
                # A real click, hit-tested against the laid-out tree.
                it.dispatch(last_click())

        # Hover and press feedback. These are plain per-frame fields on the
        # Interpreter, not an event -- paint() reads them while walking the
        # tree, so the whole thing costs nothing when nothing is hovered.
        mut mx, my, mdown = mouse_state()
        it.hover_x = mx
        it.hover_y = my
        it.pressed = mdown

        canvas.clear(0x0F172A)
        render_to(it, tree, canvas)
        canvas.present()
        unsafe: SDL_Delay(16 as Uint32)

    canvas.close()
