# examples/gl_smoke — standalone smoke test for GlCanvas (proposal-v6 phase 2),
# isolated from the toolkit's parser/layout/interpreter layers on purpose: this
# exercises GlCanvas's own draw primitives directly, so a shader/GL bug shows
# up here first, not tangled up with widget/layout code that has nothing to
# do with the new GPU path.
#
# Run: .\scripts\build-desktop-gl.ps1 ; .\build-desktop-gl\app.exe

from toolkit.render.desktop.gl_canvas import GlCanvas, gl_canvas_open
from toolkit.text.font import Font
from toolkit.render.desktop.sdl_bindings import SDL_Delay
from toolkit.render.desktop.sdl_canvas import poll_event

def main():
    mut w = 480
    mut h = 320
    mut c = gl_canvas_open("nebula GL smoke test", w, h)
    if not c.ok():
        print("failed to open a GL window/context")
        return

    mut base_font = Font.load_size(1)
    mut lg_font = Font.load_size(2)

    mut frame = 0
    mut running = true
    while frame < 600 and running:
        mut draining = true
        while draining:
            mut code = poll_event()
            if code == 0:
                draining = false
            elif code == 1:
                running = false
                draining = false

        c.clear(0x0B1120)

        # Flat rect (Canvas.fill_rect -- radius 0 degenerate case)
        c.fill_rect(20, 20, 120, 60, 0x334155)

        # Rounded rect, no border
        c.rounded_rect(c, 160, 20, 120, 60, 14, 0x2563EB, 0x0B1120)

        # Bordered rounded box (two-pass: border shape, then inset fill shape)
        c.rounded_box(c, 300, 20, 140, 60, 14, 4, 0x16A34A, 0xE5E7EB, 0x0B1120)

        # Filled circle
        c.circle(c, 60, 160, 36, 0xF59E0B, 0x0B1120)

        # Ring (annulus) -- circle_ring reuses rounded_box's two-pass path
        c.circle_ring(c, 160, 160, 36, 8, 0x0B1120, 0xEC4899, 0x0B1120)

        # Translucent overlay via real GPU alpha blending
        c.fill_rect_alpha(220, 124, 160, 72, 0xFFFFFF, 90)

        c.text(c, base_font, "Tauraro GL renderer", 20, 240, 0xE5E7EB, 0x0B1120)
        c.text(c, lg_font, "Phase 2", 20, 260, 0xF59E0B, 0x0B1120)

        c.present()
        unsafe: SDL_Delay(16 as Uint32)
        frame = frame + 1

    c.close()
    print("gl_smoke done")
