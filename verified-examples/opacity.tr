# verified-examples/opacity.tr — real translucency (nebula1.0 Phase 2).
#
# Checks the three things that make "opacity-N" a real claim:
#   1. opacity-100 (or no token at all) paints fully opaque -- no accidental
#      always-blend regression for the overwhelmingly common case.
#   2. A translucent rect genuinely BLENDS with whatever is already on the
#      canvas, at the exact math toolkit.render.hosted.buffer.BufferCanvas.
#      fill_rect_alpha computes -- not merely "looks different from the
#      source color", an EXACT expected value.
#   3. opacity-0 paints nothing (the destination is left untouched).
#
#   tauraroc --run verified-examples/opacity.tr

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to
from toolkit.render.hosted.buffer import BufferCanvas
from toolkit.types import red_of, green_of, blue_of, rgb

mut _pass: int = 0
mut _fail: int = 0

def check_int(label: str, got: int, want: int) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def check_bool(label: str, got: bool, want: bool) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

# Mirrors BufferCanvas.fill_rect_alpha's own math exactly.
def blend(src: int, dst: int, alpha: int) -> int:
    mut inv = 255 - alpha
    mut r = (red_of(src) * alpha + red_of(dst) * inv + 127) / 255
    mut g = (green_of(src) * alpha + green_of(dst) * inv + 127) / 255
    mut b = (blue_of(src) * alpha + blue_of(dst) * inv + 127) / 255
    return rgb(r, g, b)

def main():
    mut W = 200
    mut H = 200
    mut bg = 0x1E293B

    # opacity-100: fully opaque, no different from today's plain bg-red-500.
    mut full_src = "<panel \"p-4 bg-slate-800\">\n  <panel \"w-10 h-10 bg-red-500 opacity-100\" />\n</panel>\n"
    mut fp = UiParser.init()
    mut ftree = fp.parse(full_src)
    mut fit = Interpreter.init()
    fit.root_bg = bg
    mut fcanvas = BufferCanvas.init(W, H, bg)
    render_to(fit, ftree, fcanvas)
    check_int("opacity-100 paints fully opaque", fcanvas.get_px(20, 20), 0xEF4444)

    # opacity-50: blended with the slate-800 background (0x1E293B) it sits
    # on -- exact expected value from the same math the backend uses.
    mut half_src = "<panel \"p-4 bg-slate-800\">\n  <panel \"w-10 h-10 bg-red-500 opacity-50\" />\n</panel>\n"
    mut hp = UiParser.init()
    mut htree = hp.parse(half_src)
    mut hit = Interpreter.init()
    hit.root_bg = bg
    mut hcanvas = BufferCanvas.init(W, H, bg)
    render_to(hit, htree, hcanvas)
    mut want_half = blend(0xEF4444, 0x1E293B, 127)
    check_int("opacity-50 genuinely blends toward the destination pixel", hcanvas.get_px(20, 20), want_half)
    check_bool("opacity-50 result differs from both the pure source and pure destination", want_half != 0xEF4444 and want_half != 0x1E293B, true)

    # opacity-0: paints nothing -- the destination (root bg) shows through
    # completely untouched.
    mut zero_src = "<panel \"p-4 bg-slate-800\">\n  <panel \"w-10 h-10 bg-red-500 opacity-0\" />\n</panel>\n"
    mut zp = UiParser.init()
    mut ztree = zp.parse(zero_src)
    mut zit = Interpreter.init()
    zit.root_bg = bg
    mut zcanvas = BufferCanvas.init(W, H, bg)
    render_to(zit, ztree, zcanvas)
    check_int("opacity-0 paints nothing -- destination untouched", zcanvas.get_px(20, 20), bg)

    print("")
    print("passed=" + _pass.to_str() + " failed=" + _fail.to_str())
    if _fail == 0:
        print("ALL OK")
