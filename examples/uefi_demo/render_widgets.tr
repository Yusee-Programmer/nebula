# examples/uefi_demo/render_widgets.tr — the FULL modern widget set, drawn
# straight into a real UEFI framebuffer via GOP.
#
# `render.tr` (the original UEFI demo) proves the pipeline: parser -> style
# cache -> layout -> interpreter -> GOP canvas. This one proves the pipeline is
# actually good enough to build a real OS-level screen with, by putting every
# widget the desktop tier has -- checkbox, radio group, switch, slider,
# progress bar, dropdown, tab strip, scrolling list, card/divider/badge -- on a
# bare-metal display with no OS, no libc, no filesystem and no window manager.
#
# It is the SAME toolkit source examples/widgets_demo/main.tr runs in an SDL2
# window. Nothing in toolkit/ changed to make this work. Only three things
# differ, and all three are inherent to the tier rather than to the widgets:
#
#   1. `SdlCanvas` becomes `GopCanvas` (a different Canvas implementation).
#   2. There is no event loop -- UEFI has no pointer/keyboard driver wired up
#      here yet, so every widget renders in a fixed, deliberately non-default
#      state (checkbox checked, second radio selected, switch on, slider at
#      65%, a list row selected) instead of responding to input. The state
#      fields are plain `pub` fields; a Simple Pointer / Simple Text Input
#      driver would set them exactly the way the SDL demo's loop does. See
#      render_interactive.tr for the shape that takes.
#   3. There is no drop shadow: `SdlCanvas.draw_shadow` uses SDL's alpha blend
#      modes, which a write-only GOP framebuffer genuinely cannot do. The
#      antialiasing itself is unaffected -- it never needed alpha (it blends
#      against a caller-supplied flat backdrop and writes one final solid
#      color), which is exactly why it works identically on all four tiers.
#
# The panel is CENTERED on whatever resolution the firmware reports, using the
# markup's own `justify-center items-center` on a fixed-size child rather than
# arithmetic here -- the alignment tokens added 2026-09-05 are what make that
# expressible. Host-painted widget coordinates are then read back off the laid-
# out tree (`it.root.children[0].x/y`), so they follow the panel wherever
# layout actually put it instead of duplicating the centering math.
#
# Build:  .\scripts\build-uefi-turnkey.ps1 -Source examples\uefi_demo\render_widgets.tr -OutDir build-uefi-widgets
# Run:    .\scripts\run-uefi.ps1 -OutDir build-uefi-widgets -Build:$false

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, register_handler
from toolkit.ui.interp import draw_text, paint_rounded_rect_aa
from toolkit.render.uefi.gop import GopCanvas
from toolkit.text.font import Font
from toolkit.ui.checkbox import Checkbox
from toolkit.ui.radio import Radio, select_only
from toolkit.ui.switch import Switch
from toolkit.ui.slider import Slider
from toolkit.ui.progress import ProgressBar
from toolkit.ui.dropdown import Dropdown
from toolkit.ui.tabs import Tabs
from toolkit.ui.list import ScrollList

# ---- Memory: the shared arena over a pool the UEFI stub allocates ----
#
# The ~80 lines that used to live here (and, verbatim, in three sibling
# programs) now live in toolkit/platform/arena.tr. See that file for the four
# invariants every bump allocator here has to satisfy, and for the per-frame
# mark/release rules. The hooks stay in the program because @allocator and
# friends are per-program, and --freestanding #errors at C-compile time
# without them.
#
# Unlike the Cortex-M tier's fixed SRAM address, the arena here is
# parameterised on a pointer from the firmware's own AllocatePool, handed in
# via tauraro_heap_init before anything else runs.

from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.platform.arena import arena_mark, arena_release, arena_used

pub export def tauraro_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def heap_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def heap_free(p: Pointer[u8]):
    pass

@realloc
def heap_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def heap_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

mut _ok_hits: int = 0

pub class OkHandler implements EventHandler:
    pub tag: int

extend OkHandler:
    pub def init() -> OkHandler:
        mut h = OkHandler()
        h.tag = 0
        return h

    pub def handle(self, e: Event) -> void:
        _ok_hits = _ok_hits + 1

# The page background every widget's antialiasing blends its outer edges
# against. It has to match the `bg-` of the panel the widgets are drawn ON --
# not the screen behind the panel -- or every rounded corner picks up a halo of
# the wrong color. One named constant rather than the literal repeated at each
# widget's `page_bg` assignment, so the two can't drift apart.
def panel_bg() -> int:
    return 0x1E293B

# A section header + the thin rule under it. Card/Divider/Badge need no widget
# code at all -- they are existing Style tokens composed directly, which is the
# same finding examples/widgets_demo made and the reason no `<divider>` tag
# exists.
def paint_section_label(c: GopCanvas, font: Font, text: str, x: int, y: int, w: int) -> void:
    draw_text(c, font, text, x, y, 0x94A3B8, panel_bg())
    c.fill_rect(x, y + 20, w, 1, 0x334155)

# The selected tab's content: three rounded cards and a badge row. Host-painted
# rather than rendered as a second markup tree, because render_to() always
# lays its root out to fill the ENTIRE canvas -- there is no viewport
# parameter -- so a second render_to() call would repaint the whole screen and
# erase the panel underneath. Same constraint, same workaround, as
# examples/widgets_demo (see CLAUDE.md's note on it).
def paint_tab_content(c: GopCanvas, font: Font, x: int, y: int, w: int, h: int) -> void:
    mut gap = 8
    mut card_w = (w - gap * 2) / 3
    paint_rounded_rect_aa(c, x, y, card_w, h, 10, 0xEF4444, panel_bg())
    paint_rounded_rect_aa(c, x + card_w + gap, y, card_w, h, 10, 0x22C55E, panel_bg())
    paint_rounded_rect_aa(c, x + (card_w + gap) * 2, y, card_w, h, 10, 0x3B82F6, panel_bg())

# Called once by the UEFI stub with GOP's framebuffer pointer, resolution and
# PixelsPerScanLine.
pub export def tauraro_ui_render(fb: Pointer[u32], width: int, height: int, pitch: int) -> void:
    # The chrome. The outer panel fills the screen and centers the inner one on
    # BOTH axes -- `justify-center` on the main (row) axis, `items-center` on
    # the cross axis -- around a child with a fixed w-[460px] h-[560px]. Before the
    # alignment tokens existed this was not expressible in markup at all and
    # would have had to be computed here in host code.
    mut src = "<panel \"flex-row justify-center items-center bg-#0B1120\">\n  <panel \"w-[460px] h-[560px] flex-col p-4 gap-3 bg-slate-800 rounded-2xl border-slate-400 border\">\n    <panel \"h-16 bg-slate-700 border-slate-400 border rounded-xl p-[3px] items-center\">\n      <text \"text-white\">TAURARO WIDGETS ON UEFI</text>\n    </panel>\n    <panel \"h-[400px]\" />\n    <panel \"flex-row gap-[3px] h-10 p-[3px] bg-slate-700 rounded-lg\">\n      <button \"bg-amber grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_ok)>\n        <text \"text-black\">OK</text>\n      </button>\n      <button \"bg-red grow border-white border-2 rounded-lg justify-center items-center\" @on_click(on_cancel)>\n        <text \"text-white\">CANCEL</text>\n      </button>\n    </panel>\n  </panel>\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it = Interpreter.init()
    # Must match the outer panel's own bg-#0B1120, since that is what the
    # centered card's antialiased outer corners blend against.
    it.root_bg = 0x0B1120
    mut ok = OkHandler.init()
    register_handler(it, "on_ok", ok)
    mut cancel = OkHandler.init()
    register_handler(it, "on_cancel", cancel)

    mut canvas = GopCanvas.init(fb, width, height, pitch)
    render_to(it, tree, canvas)

    # Where layout actually put the centered card. Read back rather than
    # recomputed: if the panel's size or the centering rule ever changes, the
    # host-painted widgets follow automatically instead of silently drifting
    # off by however much the two calculations disagree.
    mut card = it.root.children[0]
    mut ox = card.x
    mut oy = card.y

    mut font = Font.load()

    # Everything below is positioned relative to (ox, oy) using the exact
    # offsets examples/widgets_demo uses inside its 460x560 window, so the two
    # tiers render a pixel-identical panel.
    mut tabs = Tabs.init(["Cards", "Info"], 0)
    tabs.page_bg = panel_bg()
    tabs.paint(canvas, ox + 16, oy + 92, 428, 28)

    paint_tab_content(canvas, font, ox + 16, oy + 126, 428, 56)

    paint_section_label(canvas, font, "PREFERENCES", ox + 16, oy + 194, 428)

    mut notify_cb = Checkbox.init(true)
    notify_cb.page_bg = panel_bg()
    notify_cb.paint(canvas, ox + 16, oy + 222, 18, 18)
    draw_text(canvas, font, "Enable notifications", ox + 44, oy + 223, 0xE2E8F0, panel_bg())

    draw_text(canvas, font, "Theme", ox + 16, oy + 250, 0x94A3B8, panel_bg())
    mut theme_light = Radio.init(false)
    mut theme_dark = Radio.init(false)
    mut theme_auto = Radio.init(false)
    mut theme_group: List[Radio] = [theme_light, theme_dark, theme_auto]
    # "Dark" -- picked deliberately over the default first entry so the
    # rendered frame proves select_only() actually moved the selection rather
    # than just showing an untouched initial state.
    select_only(theme_group, 1)
    mut r = 0
    while r < 3:
        mut radio = theme_group[r]
        radio.page_bg = panel_bg()
        radio.paint(canvas, ox + 16 + r * 100, oy + 272, 18, 18)
        r = r + 1

    draw_text(canvas, font, "Auto-update", ox + 274, oy + 273, 0xE2E8F0, panel_bg())
    mut autoupdate_sw = Switch.init(true)
    autoupdate_sw.page_bg = panel_bg()
    # No tick() loop here and none needed: Switch.init() seeds knob_pos to the
    # settled end of its travel, and tick()'s easing only matters once the
    # state can actually change mid-run. A single-frame tier gets the right
    # picture for free.
    autoupdate_sw.paint(canvas, ox + 384, oy + 270, 44, 24)

    paint_section_label(canvas, font, "APPEARANCE", ox + 16, oy + 308, 428)

    mut brightness_sl = Slider.init(0, 100, 65)
    brightness_sl.page_bg = panel_bg()
    brightness_sl.paint(canvas, ox + 16, oy + 332, 428, 22)

    mut brightness_pb = ProgressBar.init(65)
    brightness_pb.page_bg = panel_bg()
    brightness_pb.paint(canvas, ox + 16, oy + 358, 428, 10)

    paint_section_label(canvas, font, "RECENT ITEMS", ox + 16, oy + 420, 428)

    mut recent_list = ScrollList.init(["Booted from firmware", "GOP framebuffer located", "Toolkit rendered", "Awaiting input driver"])
    recent_list.selected_index = 0
    recent_list.paint(canvas, ox + 16, oy + 442, 428, 56)

    draw_text(canvas, font, "Accent", ox + 16, oy + 389, 0xE2E8F0, panel_bg())

    # Dropdown LAST: while open its item list overlays whatever is already
    # drawn beneath it, so it has to be the last thing painted to stay on top.
    # Rendered open here precisely because that overlay is the interesting
    # case and a single static frame is the only chance to show it -- with a
    # hovered row too, since hover is the state most likely to be subtly wrong
    # (it changes what backdrop the row's text has to blend against).
    #
    # Placed on the RIGHT half rather than the left, purely for this frame's
    # composition: the open list is 120px tall and lands on top of the recent-
    # items list and one footer button whatever happens, so it may as well
    # fall where it leaves the section label, the list's own left column, and
    # the OK button legible.
    mut accent_dd = Dropdown.init(["Blue", "Green", "Violet", "Amber"], 0)
    accent_dd.page_bg = panel_bg()
    accent_dd.open = true
    accent_dd.hover_index = 2
    accent_dd.paint(canvas, ox + 244, oy + 380, 200, 30)

    # Same allowlisted dispatch the other three tiers prove, ahead of a real
    # pointer driver existing for this target: a click on the OK button.
    it.dispatch(Event.click(ox + 120, oy + 520))
