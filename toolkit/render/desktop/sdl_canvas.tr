# toolkit.render.desktop.sdl_canvas — the real cross-platform GUI Canvas backend.
#
# This is the piece the hosted (PPM-dump) and bare-metal/UEFI (MMIO/GOP-framebuffer)
# tiers don't have: an actual OS window with live mouse input, using SDL2 as a thin
# wrapper -- exactly the "use an existing graphics tool as a wrapper, but write
# everything else in Tauraro" approach. Every method here is a handful of lines
# forwarding straight to SDL; the parser, style cache, layout engine, interpreter,
# and widgets are the SAME toolkit source the other two tiers run, completely
# unaware this backend exists.
#
# Bindings: toolkit/render/desktop/sdl_bindings.tr, generated with
#   tauraroc bindgen <mingw64>/include/SDL2/SDL.h --cc clang \
#       -I<mingw64>/include -I<mingw64>/include/SDL2
# (bindgen needs `--cc clang`, not the default, to resolve libclang's own
# builtin-include search path on this toolchain -- without it, parsing silently
# produces 0 types/0 functions instead of an error.)
#
# Earlier versions of this file worked around three real bindgen bugs (a
# shim header skipping SDL_events.h's gamecontroller/joystick transitive
# includes to dodge a struct-corruption bug, a hand-written
# SDL_MouseButtonEvent, and a hand-written `@union` SdlEventU standing in for
# a mis-emitted-as-struct SDL_Event). All three were root-caused and FIXED in
# tauraro's bindgen (src/bindgen.tr, 2026-09-04):
#   1. A GCC/clang attribute between a struct/union body and its typedef name
#      (`} __attribute__((packed)) Name;` -- exactly how SDL_AudioCVT is
#      declared) was read as if `__attribute__` were the type's own name.
#   2. A 2nd-level-nested anonymous struct/union field (SDL_GameController-
#      ButtonBind's `union {...; struct {...} hat;} value;` is the real case
#      that found this) desynced brace-depth tracking for the REST OF THE
#      FILE -- every subsequent top-level function/struct was misparsed as
#      more fields of whatever struct was open when the desync happened.
# `SDL_Event` now correctly binds as `@union`, `SDL_AudioCVT` keeps its real
# name, and no function is silently swallowed as a field -- so this file now
# uses the real, direct SDL.h bindings with no workarounds.

from toolkit.render.canvas import Canvas
from toolkit.render.caps import Caps
from toolkit.types import Event, red_of, green_of, blue_of

# Proposal v4 step B: real alpha blending (draw_shadow below uses it) and
# hardware acceleration -- bench_render.tr measured ACCELERATED|TARGETTEXTURE
# (proposal-v4-renderer-architecture.md 5a). Still no destination read-back
# or subpixel text through Canvas's own interface. See toolkit/render/caps.tr.
pub def caps() -> Caps:
    return Caps.sdl2()
from toolkit.render.desktop.sdl_bindings import SDL_Window, SDL_Renderer, SDL_Rect, SDL_Event, SDL_BlendMode
from toolkit.render.desktop.sdl_bindings import SDL_Init, SDL_Quit, SDL_CreateWindow, SDL_CreateRenderer
from toolkit.render.desktop.sdl_bindings import SDL_DestroyRenderer, SDL_DestroyWindow, SDL_PollEvent
from toolkit.render.desktop.sdl_bindings import SDL_SetRenderDrawColor, SDL_RenderFillRect, SDL_RenderDrawPoint
from toolkit.render.desktop.sdl_bindings import SDL_RenderPresent, SDL_RenderClear, SDL_Delay, SDL_GetError
from toolkit.render.desktop.sdl_bindings import SDL_GetMouseState, SDL_SetRenderDrawBlendMode
from toolkit.render.desktop.sdl_bindings import SDL_SetHint

# Stable, version-independent SDL2 ABI constants that bindgen's macro pass
# didn't pick up (defined via bit-shift/indirection macros, not plain literals).
# Unchanged since SDL2's first release -- safe to hardcode.
pub def sdl_init_video() -> Uint32:
    return 0x00000020 as Uint32

pub def sdl_windowpos_undefined() -> c_int:
    return 0x1FFF0000

pub def sdl_window_shown() -> Uint32:
    return 4 as Uint32

pub def sdl_renderer_accelerated() -> Uint32:
    return 2 as Uint32

pub def sdl_renderer_presentvsync() -> Uint32:
    return 4 as Uint32

pub def sdl_quit_event() -> Uint32:
    return 256 as Uint32

pub def sdl_mousebuttondown() -> Uint32:
    return 1025 as Uint32

pub def sdl_keydown() -> Uint32:
    return 768 as Uint32

pub def sdl_mousewheel() -> Uint32:
    return 1027 as Uint32

pub def sdl_blendmode_none() -> SDL_BlendMode:
    return 0 as SDL_BlendMode

pub def sdl_blendmode_blend() -> SDL_BlendMode:
    return 1 as SDL_BlendMode

pub class SdlCanvas implements Canvas:
    pub win: Pointer[SDL_Window]
    pub ren: Pointer[SDL_Renderer]
    pub w:   int
    pub h:   int

# Shared by SdlCanvas.open()/open_vsync() -- a free function, not another
# static method on SdlCanvas, so there is no ambiguity about calling one
# no-`self` associated function from another inside the same `extend` block.
def sdl_canvas_open_ex(title: str, w: int, h: int, vsync: bool) -> SdlCanvas:
    mut c = SdlCanvas()
    c.w = w
    c.h = h
    unsafe:
        # DPI awareness, BEFORE SDL_Init -- this hint is only read during
        # video-subsystem startup, so setting it afterwards silently does
        # nothing.
        #
        # Without it the process is DPI-unaware, and on any display with a
        # scale factor above 100% Windows renders the window at the
        # requested logical size and then BITMAP-STRETCHES the whole
        # surface up to physical pixels. That stretch is a bilinear
        # resample of an already-finished frame: it re-blurs every
        # antialiased corner and every glyph edge the rasterizer just
        # spent 16 subsamples per pixel computing, which is a strange way
        # to spend that work. It also makes the window's real on-screen
        # footprint larger than the size asked for, which is what an
        # earlier session saw and (correctly) guessed at but did not fix.
        #
        # "permonitorv2" is the modern behavior: 1 SDL pixel == 1 physical
        # pixel, no stretch, and the scale factor re-negotiated when the
        # window moves between monitors of different DPI. The hint is
        # Windows-only and simply ignored elsewhere, so this stays a
        # single unconditional call rather than a platform branch.
        SDL_SetHint("SDL_WINDOWS_DPI_AWARENESS" as Pointer[char], "permonitorv2" as Pointer[char])

        mut rc = SDL_Init(sdl_init_video())
        if rc != 0:
            c.win = 0 as Pointer[SDL_Window]
            c.ren = 0 as Pointer[SDL_Renderer]
            return c

        mut cw = w as c_int
        mut ch = h as c_int
        c.win = SDL_CreateWindow(title as Pointer[char], sdl_windowpos_undefined(), sdl_windowpos_undefined(), cw, ch, sdl_window_shown())
        if (c.win as usize) == (0 as usize):
            c.ren = 0 as Pointer[SDL_Renderer]
            return c

        # ACCELERATED (2) and PRESENTVSYNC (4) are distinct bits, so addition
        # combines them exactly like a bitwise OR would -- used instead of
        # `|` since nothing else in this codebase relies on that operator
        # being defined for Uint32, and this avoids being the first.
        mut flags = sdl_renderer_accelerated()
        if vsync:
            flags = flags + sdl_renderer_presentvsync()
        c.ren = SDL_CreateRenderer(c.win, 0 - 1, flags)
    return c

extend SdlCanvas:
    # Opens a real window. Returns a canvas with `win` NULL on failure (SDL_Init
    # or window/renderer creation failed) -- callers should check `.ok()` before
    # using it; nothing here crashes on a null handle, but nothing draws either.
    #
    # No PRESENTVSYNC: bench_render.tr measures raw per-frame cost through this
    # exact call (proposal-v4-renderer-architecture.md section 5a's recorded
    # numbers -- "219 fps" etc. -- depend on nothing capping the frame rate),
    # so changing this default would quietly invalidate that measurement.
    # Interactive demos that want a tear-free, evenly-paced loop should use
    # open_vsync() instead (see its own comment for why an uncapped loop with
    # a fixed post-frame SDL_Delay is worse than either extreme alone).
    pub def open(title: str, w: int, h: int) -> SdlCanvas:
        return sdl_canvas_open_ex(title, w, h, false)

    # Same as open(), but the renderer also gets SDL_RENDERER_PRESENTVSYNC.
    # Without it, SDL_RenderPresent() returns immediately and a loop has to
    # pace itself with something like SDL_Delay(16) to avoid pegging a core
    # at an unbounded frame rate -- examples/widgets_demo did exactly that.
    # Two real, distinct problems follow from an uncapped present under a
    # fixed post-frame delay, not one: (1) RenderPresent with no vsync can
    # hand the compositor a buffer mid-scanout, which showed up as visible
    # tearing during an active drag (half a frame's colour, half the
    # previous one -- confirmed by a rapid burst-capture during a slider
    # drag); (2) SDL_Delay(16) after a present that ALSO returns immediately
    # means the delay is the only thing pacing the loop, so the tiniest bit
    # of extra work in some frames (e.g. the occasional full-scene repaint
    # under diffing, see render_diff_to()) does not push the frame later --
    # it just makes that frame's real (work + 16ms) length longer than the
    # next one's, an UNEVEN cadence a human eye actually notices as jank
    # even though every individual frame drew correctly. PRESENTVSYNC fixes
    # both by blocking the present call itself until the next vblank: no
    # partial buffer is ever shown, and every frame is paced to the display
    # refresh regardless of how much work it did -- the caller should drop
    # its own SDL_Delay once using this, or the two paces stack and roughly
    # halve the frame rate.
    pub def open_vsync(title: str, w: int, h: int) -> SdlCanvas:
        return sdl_canvas_open_ex(title, w, h, true)

    pub def ok(self) -> bool:
        unsafe:
            return (self.win as usize) != (0 as usize) and (self.ren as usize) != (0 as usize)

    pub def width(self) -> int:
        return self.w

    pub def height(self) -> int:
        return self.h

    # Clears the whole window to `color` -- call once per frame before repainting
    # the tree, since (unlike the PPM/framebuffer backends) SDL does not start
    # each frame pre-filled with anything in particular.
    pub def clear(self, color: int) -> void:
        unsafe:
            SDL_SetRenderDrawColor(self.ren, red_of(color) as Uint8, green_of(color) as Uint8, blue_of(color) as Uint8, 255 as Uint8)
            SDL_RenderClear(self.ren)

    pub def fill_rect(self, x: int, y: int, w: int, h: int, color: int) -> void:
        if w <= 0:
            return
        if h <= 0:
            return
        unsafe:
            SDL_SetRenderDrawColor(self.ren, red_of(color) as Uint8, green_of(color) as Uint8, blue_of(color) as Uint8, 255 as Uint8)
            mut r = SDL_Rect()
            r.x = x as c_int
            r.y = y as c_int
            r.w = w as c_int
            r.h = h as c_int
            SDL_RenderFillRect(self.ren, alloc_rect(r))

    pub def set_pixel(self, x: int, y: int, color: int) -> void:
        unsafe:
            SDL_SetRenderDrawColor(self.ren, red_of(color) as Uint8, green_of(color) as Uint8, blue_of(color) as Uint8, 255 as Uint8)
            SDL_RenderDrawPoint(self.ren, x as c_int, y as c_int)

    # Real GPU alpha blending -- same SDL_SetRenderDrawBlendMode/reset
    # bracket draw_shadow below already uses, just for one caller-chosen
    # flat rect instead of the fixed shadow-layer stack. Blend mode is
    # reset to `none` afterward so every OTHER fill_rect/set_pixel call
    # (which never expects blending) keeps painting fully opaque, matching
    # the state SDL_CreateRenderer starts a renderer in.
    pub def fill_rect_alpha(self, x: int, y: int, w: int, h: int, color: int, alpha: int) -> void:
        if w <= 0:
            return
        if h <= 0:
            return
        unsafe:
            SDL_SetRenderDrawBlendMode(self.ren, sdl_blendmode_blend())
            SDL_SetRenderDrawColor(self.ren, red_of(color) as Uint8, green_of(color) as Uint8, blue_of(color) as Uint8, alpha as Uint8)
            mut r = SDL_Rect()
            r.x = x as c_int
            r.y = y as c_int
            r.w = w as c_int
            r.h = h as c_int
            SDL_RenderFillRect(self.ren, alloc_rect(r))
            SDL_SetRenderDrawBlendMode(self.ren, sdl_blendmode_none())

    # A soft drop shadow, SDL2-only -- deliberately NOT on the Canvas interface
    # (see toolkit/render/canvas.tr's own comment on why that stays minimal):
    # this needs real alpha blending, which the bare-metal MMIO and UEFI GOP
    # framebuffers cannot do at all, so making it part of the portable paint
    # path would force those backends to either fake it (a solid darker block,
    # not a shadow) or pay a linker-error obligation for a primitive they can
    # never honestly implement. Callers on THIS backend call it directly,
    # before painting the elevated panel on top, e.g. a card.
    #
    # Not a real Gaussian blur -- a handful of concentric, progressively
    # larger, progressively more transparent SQUARE-cornered rects offset
    # down-right, which is what a cheap CSS box-shadow approximation looks
    # like too. Square corners under a blurred, faded edge read as soft
    # anyway (the fade is doing the visual work, not the corner geometry),
    # so this doesn't bother routing through paint_rounded_rect -- that also
    # avoids a render-backend module reaching up into toolkit.ui.interp,
    # which nothing else in toolkit/render/ does. `radius` is accepted for
    # call-site symmetry with the panel it shadows and for future refinement,
    # not used yet. Cheap enough to call every frame for a handful of cards;
    # not something you'd want under a hot per-pixel loop.
    pub def draw_shadow(self, x: int, y: int, w: int, h: int, radius: int) -> void:
        unsafe:
            SDL_SetRenderDrawBlendMode(self.ren, sdl_blendmode_blend())
            mut layers = 6
            mut i = 0
            while i < layers:
                mut spread = i + 1
                mut alpha = 60 - i * 9
                if alpha < 0:
                    alpha = 0
                SDL_SetRenderDrawColor(self.ren, 2 as Uint8, 6 as Uint8, 16 as Uint8, alpha as Uint8)
                mut r = SDL_Rect()
                r.x = (x - spread + 3) as c_int
                r.y = (y - spread + 5) as c_int
                r.w = (w + spread * 2) as c_int
                r.h = (h + spread * 2) as c_int
                SDL_RenderFillRect(self.ren, alloc_rect(r))
                i = i + 1
            SDL_SetRenderDrawBlendMode(self.ren, sdl_blendmode_none())

    # Flips the back buffer to the screen -- call once per frame, after every
    # fill_rect/set_pixel for that frame, never per-primitive (that would tear
    # and be needlessly slow).
    pub def present(self) -> void:
        unsafe:
            SDL_RenderPresent(self.ren)

    pub def close(self) -> void:
        unsafe:
            if (self.ren as usize) != (0 as usize):
                SDL_DestroyRenderer(self.ren)
            if (self.win as usize) != (0 as usize):
                SDL_DestroyWindow(self.win)
            SDL_Quit()

# SDL_RenderFillRect wants a Pointer[SDL_Rect], and Tauraro has no `&` (address-of
# a local) -- heap-allocate the one-element out-argument the same way the
# toolkit's own boxed-enum AST does (toolkit.ui.ast.box_node). One allocation per
# fill_rect call is not free, but this is a UI redraw path (dozens of rects per
# frame, not a hot per-pixel loop), so it is not worth a pooled/reused buffer yet.
def alloc_rect(r: SDL_Rect) -> Pointer[SDL_Rect]:
    unsafe:
        mut p = alloc[SDL_Rect](1)
        p.write(r)
        return p

# A single poll pops AT MOST one event off SDL's queue. Separate poll
# functions (one asking "was it a click", one asking "was it quit") would each
# call SDL_PollEvent independently and silently steal/drop each other's events
# -- a real bug caught before it shipped, not a hypothetical one. One poll,
# one result code:
#   0 = no event waiting this call
#   1 = SDL_QUIT (the window's close button, or the last window closing) --
#       an OS/window-level signal, not a toolkit.types.Event, so it does not
#       flow through the interpreter's dispatch; the caller's own loop exits.
#   2 = a mouse-button-down event; coordinates are in _last_click_x/_last_click_y,
#       read via last_click() as a real toolkit.types.Event for
#       Interpreter.dispatch().
#   3 = a keydown event; the key's SDL_Keycode is in _last_key_code, read via
#       last_key() -- SDL_Keycode is the ASCII value for printable keys
#       (SDLK_a == 'a' == 97), the same rough convention UEFI's
#       unicode_char gives tauraro_uefi_frame, so on_key handlers see a
#       consistent code across backends.
#   4 = a mouse-wheel event; the vertical scroll delta (positive = away from
#       the user, i.e. "up"/scroll-content-up, matching every other desktop
#       UI's convention) is in _last_wheel_delta, read via
#       last_wheel_delta(). NOT a toolkit.types.Event/EventHandler dispatch --
#       there is no "on_wheel" event kind, because wheel scroll targets
#       whichever scrollable widget the mouse happens to be over, which is a
#       hit-test the HOST already has to do for itself (it knows each
#       widget's rect), not something the allowlisted handler-by-name
#       dispatch is shaped for.
# Any other SDL event type (window resize, ...) is silently discarded -- this
# backend does not wire those up yet.
mut _last_click_x: int = 0
mut _last_click_y: int = 0
mut _last_key_code: int = 0
mut _last_wheel_delta: int = 0

pub def poll_event() -> int:
    unsafe:
        mut ev = alloc[SDL_Event](1)
        mut n = SDL_PollEvent(ev)
        if n == 0:
            return 0
        mut e = ev.read()
        if e.type == sdl_quit_event():
            return 1
        if e.type == sdl_mousebuttondown():
            _last_click_x = e.button.x as int
            _last_click_y = e.button.y as int
            return 2
        if e.type == sdl_keydown():
            _last_key_code = e.key.keysym.sym as int
            return 3
        if e.type == sdl_mousewheel():
            _last_wheel_delta = e.wheel.y as int
            return 4
        return 0

pub def last_click() -> Event:
    return Event.click(_last_click_x, _last_click_y)

pub def last_key() -> Event:
    return Event.key(_last_key_code)

pub def last_wheel_delta() -> int:
    return _last_wheel_delta

# Continuous mouse position + left-button state, for hover/pressed feedback
# (Interpreter.hover_x/hover_y/pressed) -- unlike poll_event()'s discrete
# click events, this doesn't drain the SDL event queue at all, so it's safe
# to call every frame regardless of what poll_event() saw this frame.
pub def mouse_state() -> (int, int, bool):
    unsafe:
        mut mx = alloc[c_int](1)
        mut my = alloc[c_int](1)
        mut buttons = SDL_GetMouseState(mx, my)
        mut left_down = (buttons & (1 as Uint32)) != (0 as Uint32)
        return (mx.read() as int, my.read() as int, left_down)
