# examples/web_ide -- "Nebula Code": a real, from-scratch multi-file text
# editor rendered on the web (Canvas2D), built from nebula's own
# markup/component model (toolkit.ui.parser/component/interp) for the IDE
# chrome -- tab strip, sidebar file list, menu bar, status bar -- plus a
# hand-painted text buffer for the editor pane itself.
#
# WHY hand-painted: toolkit.ui.textinput.TextInput is single-line only, with
# no cursor-position/selection model at all (see its own header) -- text
# always appends at the end, no arrow-key navigation. A real code editor
# needs a proper line-buffer + row/col cursor, which doesn't exist anywhere
# in the toolkit yet, so this file builds one (the `Buffer` class below).
#
# Rendering strategy (three layers, painted in this exact order every
# frame -- same "host-painted overlay on a placeholder" pattern
# examples/ide_demo_web used for its content pane):
#   1. render_into(_it, _tree, canvas, ...) -- the Interpreter-tree chrome
#      (tab strip + sidebar file list + an EMPTY placeholder panel + an
#      empty status-bar strip).
#   2. render_editor(...) -- hand-painted text buffer, drawn directly onto
#      the placeholder panel's known rect (computed from fixed layout
#      constants below, not introspected from the tree -- same trick
#      examples/ide_demo_web's content_x()/content_y() used).
#   3. render_status_bar(...) + mb.paint(...) -- hand-painted status-bar
#      text and the host-owned MenuBar (toolkit.ui.menubar), which must
#      paint LAST so its open dropdown list sits on top of everything else.
#
# FEATURES:
#   - real multi-line editing: insert/backspace/delete/enter/tab
#   - cursor movement: arrow keys, Home/End, PageUp/PageDown, click-to-place
#   - line-number gutter, auto-scroll-to-cursor, mouse-wheel scroll
#   - basic syntax highlighting (keywords/strings/comments/numbers) for
#     Tauraro-like source
#   - 5 seeded files via a tab strip + sidebar list, kept in sync through
#     the SAME group/state mechanism toolkit.ui.interp's tabitem/listitem
#     widgets already provide (see toolkit.ui.widget_tags's own header)
#   - a real dropdown menu bar (File/Edit/View/Help) via toolkit.ui.menubar:
#     File>Save marks the buffer clean + shows a toast; View>Toggle Theme
#     really does flip the whole editor between dark/light
#   - status bar: file name, modified flag, line/col, char count
#
# NOT implemented (scope cut, so nothing is silently missing):
#   - text selection (drag or shift+arrow), copy/paste, find/replace, undo/redo
#   - File>New (would need rebuilding the tab-strip/sidebar tree at runtime
#     for a dynamic file count -- out of scope for this pass); the menu item
#     is present and shows an honest "not wired up" toast rather than
#     pretending to work
#   - horizontal scroll / line wrap -- a line longer than the pane just runs
#     off the right edge

from toolkit.types import Event, EventHandler
from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to, render_into, register_handler
from toolkit.ui.component import instantiate, one_slot, no_props
from toolkit.ui.ast import UiNode, box_node
from toolkit.ui.menubar import MenuBar
from toolkit.render.web.canvas2d_renderer import Canvas2DCanvas, canvas2d_renderer_of
from toolkit.render.renderer import Renderer
from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc
from toolkit.text.font import Font
from string.str import Str
from core.string import StringBuilder

# --- allocator hooks (freestanding wasm: the program supplies its own) ----

pub export def nebula_heap_init(base: Pointer[u8], size: usize) -> void:
    arena_init(base, size)

@allocator
def ed_alloc(n: usize) -> Pointer[u8]:
    return arena_alloc(n)

@free
def ed_free(p: Pointer[u8]):
    pass

@realloc
def ed_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:
    return arena_realloc(p, n)

@calloc
def ed_calloc(n: usize, sz: usize) -> Pointer[u8]:
    return arena_calloc(n, sz)

# --- key codes --------------------------------------------------------
# Printable ASCII (32..126) arrives as-is. Everything else is assigned a
# code above the printable range so it can never collide -- see
# index.html's keydown handler for the JS-side half of this contract.
def key_backspace() -> int: return 8
def key_tab() -> int: return 9
def key_enter() -> int: return 13
def key_left() -> int: return 1001
def key_right() -> int: return 1002
def key_up() -> int: return 1003
def key_down() -> int: return 1004
def key_home() -> int: return 1005
def key_end() -> int: return 1006
def key_pgup() -> int: return 1007
def key_pgdn() -> int: return 1008
def key_delete() -> int: return 1009

# --- layout constants (matches the Tailwind-scale-step values baked into
# the markup below: h-9 = 36px, h-7 = 28px -- see toolkit.layout.flex's own
# "numbers are scale steps, N*4px" note) ------------------------------
def menu_h() -> int: return 36
# Measured empirically (click-position scan against the real layout tree),
# not derived from "h-9 = 9*4 = 36px" -- the tab strip actually renders at
# 72px, double the naive scale-step math. Whatever combination of
# items-end/tabitem's own h-9/row auto-sizing produces that isn't traced
# further here; matching the REAL rendered position is what keeps the
# hand-painted editor pane/hover-highlight/cursor-kind from overlapping the
# tree's own real chrome, regardless of why the toolkit renders it that way.
def tabstrip_h() -> int: return 72
def statusbar_h() -> int: return 28
def sidebar_w() -> int: return 200

def chrome_top() -> int: return 0
def editor_x() -> int: return sidebar_w()
def editor_y() -> int: return chrome_top() + menu_h() + tabstrip_h()
def content_h(total_h: int) -> int:
    return total_h - editor_y() - statusbar_h()
def status_y(total_h: int) -> int:
    return total_h - statusbar_h()

# --- syntax highlighting -----------------------------------------------

pub class Token:
    pub text: str
    pub color: int

def color_keyword() -> int: return 0xC792EA
def color_string() -> int: return 0xC3E88D
def color_comment() -> int: return 0x546E7A
def color_number() -> int: return 0xF78C6C
def color_type() -> int: return 0x82AAFF
def color_plain() -> int: return 0xE2E8F0

def is_keyword(w: str) -> bool:
    if w == "def" or w == "pub" or w == "mut" or w == "class" or w == "extend": return true
    if w == "from" or w == "import" or w == "if" or w == "elif" or w == "else": return true
    if w == "while" or w == "for" or w == "in" or w == "return" or w == "match": return true
    if w == "case" or w == "true" or w == "false" or w == "and" or w == "or": return true
    if w == "not" or w == "self" or w == "pass" or w == "break" or w == "continue": return true
    if w == "interface" or w == "implements" or w == "enum" or w == "unsafe" or w == "as": return true
    if w == "let" or w == "export" or w == "extern" or w == "void" or w == "usize": return true
    return false

def is_typename(w: str) -> bool:
    if w == "int" or w == "str" or w == "bool" or w == "float" or w == "char": return true
    if w == "List" or w == "Dict" or w == "Vec" or w == "Set" or w == "Map": return true
    if w == "Pointer" or w == "Event" or w == "Canvas" or w == "Font": return true
    return false

def is_alpha_us(c: int) -> bool:
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

def is_digit_c(c: int) -> bool:
    return c >= 48 and c <= 57

def is_word_char(c: int) -> bool:
    return is_alpha_us(c) or is_digit_c(c)

def is_span_start(c: int) -> bool:
    return is_alpha_us(c) or is_digit_c(c) or c == 34 or c == 35

# Scans one line into contiguous, same-color spans. Deliberately simple
# (no multi-line string/comment state carried between lines) -- correct
# enough for the kind of short demo snippets this editor ships with, not a
# real language server.
pub def highlight_line(line: str) -> List[Token]:
    mut toks: List[Token] = []
    mut n = Str.len(line)
    mut i = 0
    while i < n:
        mut c = Str.char_at(line, i)
        if c == 35:
            mut t = Token()
            t.text = Str.slice(line, i, n)
            t.color = color_comment()
            toks.append(t)
            i = n
        elif c == 34:
            mut j = i + 1
            while j < n and Str.char_at(line, j) != 34:
                j = j + 1
            if j < n: j = j + 1
            mut t = Token()
            t.text = Str.slice(line, i, j)
            t.color = color_string()
            toks.append(t)
            i = j
        elif is_alpha_us(c):
            mut j = i + 1
            while j < n and is_word_char(Str.char_at(line, j)):
                j = j + 1
            mut w = Str.slice(line, i, j)
            mut t = Token()
            t.text = w
            if is_keyword(w):
                t.color = color_keyword()
            elif is_typename(w):
                t.color = color_type()
            else:
                t.color = color_plain()
            toks.append(t)
            i = j
        elif is_digit_c(c):
            mut j = i + 1
            while j < n and (is_digit_c(Str.char_at(line, j)) or Str.char_at(line, j) == 46):
                j = j + 1
            mut t = Token()
            t.text = Str.slice(line, i, j)
            t.color = color_number()
            toks.append(t)
            i = j
        else:
            mut j = i + 1
            while j < n and not is_span_start(Str.char_at(line, j)):
                j = j + 1
            mut t = Token()
            t.text = Str.slice(line, i, j)
            t.color = color_plain()
            toks.append(t)
            i = j
    return toks

# --- text buffer ---------------------------------------------------------

pub class Buffer:
    pub name: str
    pub lines: List[str]
    pub cursor_row: int
    pub cursor_col: int
    pub scroll_row: int
    pub modified: bool

extend Buffer:
    pub def init(name: str, content: str) -> Buffer:
        mut b = Buffer()
        b.name = name
        b.lines = Str.split(content, "\n")
        if len(b.lines) == 0:
            b.lines.append("")
        b.cursor_row = 0
        b.cursor_col = 0
        b.scroll_row = 0
        b.modified = false
        return b

    pub def line_at(self, i: int) -> str:
        return self.lines[i]

    pub def clamp_cursor(self):
        if self.cursor_row < 0: self.cursor_row = 0
        if self.cursor_row >= len(self.lines): self.cursor_row = len(self.lines) - 1
        mut ll = Str.len(self.line_at(self.cursor_row))
        if self.cursor_col < 0: self.cursor_col = 0
        if self.cursor_col > ll: self.cursor_col = ll

    pub def set_cursor_col(self, col: int):
        mut ll = Str.len(self.line_at(self.cursor_row))
        mut c = col
        if c < 0: c = 0
        if c > ll: c = ll
        self.cursor_col = c

    pub def insert_char(self, ch: int):
        mut row = self.line_at(self.cursor_row)
        mut sb = StringBuilder.init(Str.len(row) + 4)
        sb.append(Str.slice(row, 0, self.cursor_col))
        sb.append_char(ch)
        sb.append(Str.slice(row, self.cursor_col, Str.len(row)))
        self.lines.set(self.cursor_row, sb.to_owned())
        self.cursor_col = self.cursor_col + 1
        self.modified = true

    pub def insert_tab(self):
        mut row = self.line_at(self.cursor_row)
        mut before = Str.slice(row, 0, self.cursor_col)
        mut after = Str.slice(row, self.cursor_col, Str.len(row))
        self.lines.set(self.cursor_row, before + "    " + after)
        self.cursor_col = self.cursor_col + 4
        self.modified = true

    pub def newline(self):
        mut row = self.line_at(self.cursor_row)
        mut before = Str.slice(row, 0, self.cursor_col)
        mut after = Str.slice(row, self.cursor_col, Str.len(row))
        mut new_lines: List[str] = []
        mut i = 0
        while i < self.cursor_row:
            new_lines.append(self.line_at(i))
            i = i + 1
        new_lines.append(before)
        new_lines.append(after)
        i = self.cursor_row + 1
        while i < len(self.lines):
            new_lines.append(self.line_at(i))
            i = i + 1
        self.lines = new_lines
        self.cursor_row = self.cursor_row + 1
        self.cursor_col = 0
        self.modified = true

    pub def backspace(self):
        if self.cursor_col > 0:
            mut row = self.line_at(self.cursor_row)
            mut before = Str.slice(row, 0, self.cursor_col - 1)
            mut after = Str.slice(row, self.cursor_col, Str.len(row))
            self.lines.set(self.cursor_row, before + after)
            self.cursor_col = self.cursor_col - 1
            self.modified = true
        elif self.cursor_row > 0:
            mut prev = self.line_at(self.cursor_row - 1)
            mut cur = self.line_at(self.cursor_row)
            mut new_col = Str.len(prev)
            mut new_lines: List[str] = []
            mut i = 0
            while i < self.cursor_row - 1:
                new_lines.append(self.line_at(i))
                i = i + 1
            new_lines.append(prev + cur)
            i = self.cursor_row + 1
            while i < len(self.lines):
                new_lines.append(self.line_at(i))
                i = i + 1
            self.lines = new_lines
            self.cursor_row = self.cursor_row - 1
            self.cursor_col = new_col
            self.modified = true

    pub def delete_forward(self):
        mut row = self.line_at(self.cursor_row)
        mut ll = Str.len(row)
        if self.cursor_col < ll:
            mut before = Str.slice(row, 0, self.cursor_col)
            mut after = Str.slice(row, self.cursor_col + 1, ll)
            self.lines.set(self.cursor_row, before + after)
            self.modified = true
        elif self.cursor_row < len(self.lines) - 1:
            mut nxt = self.line_at(self.cursor_row + 1)
            mut new_lines: List[str] = []
            mut i = 0
            while i < self.cursor_row:
                new_lines.append(self.line_at(i))
                i = i + 1
            new_lines.append(row + nxt)
            i = self.cursor_row + 2
            while i < len(self.lines):
                new_lines.append(self.line_at(i))
                i = i + 1
            self.lines = new_lines
            self.modified = true

    pub def move_left(self):
        if self.cursor_col > 0:
            self.cursor_col = self.cursor_col - 1
        elif self.cursor_row > 0:
            self.cursor_row = self.cursor_row - 1
            self.cursor_col = Str.len(self.line_at(self.cursor_row))

    pub def move_right(self):
        mut ll = Str.len(self.line_at(self.cursor_row))
        if self.cursor_col < ll:
            self.cursor_col = self.cursor_col + 1
        elif self.cursor_row < len(self.lines) - 1:
            self.cursor_row = self.cursor_row + 1
            self.cursor_col = 0

    pub def move_up(self):
        if self.cursor_row > 0:
            self.cursor_row = self.cursor_row - 1
            self.clamp_cursor()

    pub def move_down(self):
        if self.cursor_row < len(self.lines) - 1:
            self.cursor_row = self.cursor_row + 1
            self.clamp_cursor()

    pub def move_home(self):
        self.cursor_col = 0

    pub def move_end(self):
        self.cursor_col = Str.len(self.line_at(self.cursor_row))

    pub def page_up(self, n: int):
        self.cursor_row = self.cursor_row - n
        self.clamp_cursor()

    pub def page_down(self, n: int):
        self.cursor_row = self.cursor_row + n
        self.clamp_cursor()

    pub def ensure_visible(self, visible_lines: int):
        if self.cursor_row < self.scroll_row:
            self.scroll_row = self.cursor_row
        if self.cursor_row >= self.scroll_row + visible_lines:
            self.scroll_row = self.cursor_row - visible_lines + 1
        if self.scroll_row < 0: self.scroll_row = 0

    pub def click_to_cursor(self, rel_x: int, rel_y: int, cell_w: int, cell_h: int):
        mut row = self.scroll_row + rel_y / cell_h
        if row < 0: row = 0
        if row >= len(self.lines): row = len(self.lines) - 1
        self.cursor_row = row
        self.set_cursor_col(rel_x / cell_w)

    pub def char_count(self) -> int:
        mut total = 0
        mut i = 0
        while i < len(self.lines):
            total = total + Str.len(self.line_at(i))
            i = i + 1
        return total

# --- event handlers (widget tags need a registered @on_click name even
# when the handler body is empty -- the click still toggles/selects via
# hit_test_widget regardless, see toolkit.ui.interp's own dispatch order) --

pub class NoopHandler implements EventHandler:
    pub tag: str

extend NoopHandler:
    pub def init(tag: str) -> NoopHandler:
        mut h = NoopHandler()
        h.tag = tag
        return h

    pub def handle(self, e: Event) -> void:
        pass

# --- persistent state ----------------------------------------------------
# On freestanding wasm, a module-level `mut` keeps its declared initializer
# ONLY for literal/scalar values (tauraroc's own "safe" global-init half,
# see tauraro/src/codegen/c.tr) -- anything that allocates (every Buffer
# below) is NOT constructed until nebula_init's own body runs. These start
# as raw zeroed/null values and are given their real ones there.
mut _frames:     int = 0
mut _prev_btn:   bool = false
mut _it:         Interpreter = Interpreter.init()
mut _tree:       Pointer[UiNode] = 0 as Pointer[UiNode]
mut _buffers:    List[Buffer] = []
mut _font:       Font = Font.load()
mut _mb:         MenuBar = MenuBar.init(["File"], [1], ["Loading..."])
mut _dark:       bool = true
mut _toast:      str = ""
mut _toast_ttl:  int = 0
mut _cursor_kind: int = 0

# 0=default arrow, 1=pointer (clickable chrome), 2=text (I-beam, editable).
# The host page has no idea what's under the mouse -- it only forwards raw
# mouse_x/mouse_y in -- so this app computes it from the same layout
# constants nebula_frame's own click routing already uses, and index.html
# polls nebula_cursor_kind() once per frame to set the real CSS cursor.
def compute_cursor_kind(mx: int, my: int, total_h: int) -> int:
    if my < chrome_top():
        return 0
    elif my < editor_y():
        return 1
    elif my >= status_y(total_h):
        return 0
    elif mx < editor_x():
        return 1
    else:
        return 2

def seed_files() -> List[Buffer]:
    mut bufs: List[Buffer] = []
    bufs.append(Buffer.init("main.tr",
        "from toolkit.ui.interp import Interpreter, render_to\n" +
        "from toolkit.ui.parser import UiParser\n" +
        "\n" +
        "# Entry point for the demo app.\n" +
        "def main():\n" +
        "    mut it = Interpreter.init()\n" +
        "    mut src = \"<panel \\\"p-4 bg-slate-900\\\">Hello</panel>\"\n" +
        "    mut tree = UiParser.init().parse(src)\n" +
        "    render_to(it, tree, canvas)\n" +
        "\n" +
        "class Counter:\n" +
        "    pub value: int\n" +
        "\n" +
        "extend Counter:\n" +
        "    pub def init() -> Counter:\n" +
        "        mut c = Counter()\n" +
        "        c.value = 0\n" +
        "        return c\n" +
        "\n" +
        "    pub def increment(self):\n" +
        "        self.value = self.value + 1\n"))
    bufs.append(Buffer.init("utils.tr",
        "# Small helpers shared across the demo.\n" +
        "\n" +
        "def clamp(x: int, lo: int, hi: int) -> int:\n" +
        "    if x < lo: return lo\n" +
        "    if x > hi: return hi\n" +
        "    return x\n" +
        "\n" +
        "def lerp(a: int, b: int, t: int) -> int:\n" +
        "    return a + (b - a) * t / 100\n" +
        "\n" +
        "def is_even(n: int) -> bool:\n" +
        "    return n - (n / 2) * 2 == 0\n"))
    bufs.append(Buffer.init("style.tr",
        "# Tailwind-style utility tokens this toolkit understands.\n" +
        "#\n" +
        "# flex-col, flex-row, items-center, justify-between,\n" +
        "# gap-2, p-4, px-3, py-2, rounded, border,\n" +
        "# bg-slate-900, text-blue-400, w-[240px], h-full\n" +
        "\n" +
        "def card_classes() -> str:\n" +
        "    return \"flex-col gap-2 p-4 bg-slate-800 rounded border\"\n"))
    bufs.append(Buffer.init("README.md",
        "Nebula Code\n" +
        "===========\n" +
        "\n" +
        "A small text editor written in Tauraro, rendered on the web via\n" +
        "Canvas2D, using nebula's own markup and component model for the\n" +
        "surrounding IDE chrome.\n" +
        "\n" +
        "Try it:\n" +
        "  - click any file in the sidebar or tab strip\n" +
        "  - type, use arrow keys, Home/End, Page Up/Down\n" +
        "  - File > Save clears the modified dot\n" +
        "  - View > Toggle Theme flips dark/light\n"))
    bufs.append(Buffer.init("palette.tr",
        "# A few named colors used by the editor's own theme.\n" +
        "\n" +
        "def bg_dark() -> int:\n" +
        "    return 0x1E1E2E\n" +
        "\n" +
        "def bg_light() -> int:\n" +
        "    return 0xF8FAFC\n" +
        "\n" +
        "def accent() -> int:\n" +
        "    return 0x82AAFF\n"))
    return bufs

def file_color(i: int) -> str:
    if i == 0: return "blue-500"
    if i == 1: return "amber-500"
    if i == 2: return "emerald-500"
    if i == 3: return "violet-500"
    return "rose-500"

def build_shell_tree(bufs: List[Buffer]) -> Pointer[UiNode]:
    mut row_src = "<listitem \"group-active-file value-{idx} {sel} key-file-{idx} px-2 h-8 items-center gap-2\">\n  <panel \"w-[10px] h-[10px] rounded-full bg-{color}\" />\n  <text \"text-slate-200\">{name}</text>\n</listitem>\n"
    mut row_p = UiParser.init()
    mut row_template = row_p.parse(row_src)

    mut tab_src = "<tabitem \"group-active-file value-{idx} {sel} key-tab-{idx} px-4 h-9 items-center justify-center\">\n  <text \"text-slate-200\">{name}</text>\n</tabitem>\n"
    mut tab_p = UiParser.init()
    mut tab_template = tab_p.parse(tab_src)

    mut sidebar_kids: List[Pointer[UiNode]] = []
    mut tab_kids: List[Pointer[UiNode]] = []
    mut i = 0
    while i < len(bufs):
        mut sel = ""
        if i == 0: sel = "selected"
        mut props = no_props()
        props["idx"] = i.to_str()
        props["name"] = bufs[i].name
        props["color"] = file_color(i)
        props["sel"] = sel
        sidebar_kids.append(instantiate(row_template, one_slot([]), props))
        mut tprops = no_props()
        tprops["idx"] = i.to_str()
        tprops["name"] = bufs[i].name
        tprops["sel"] = sel
        tab_kids.append(instantiate(tab_template, one_slot([]), tprops))
        i = i + 1
    mut sidebar_panel = box_node(UiNode.Element("panel", "w-[200px] bg-[#111827] flex-col p-2 gap-1", "", "", sidebar_kids))

    mut shell_src = "<panel \"flex-col\">\n  <panel \"flex-row items-end h-9 bg-[#0B1120] gap-1 px-2\">\n    <slot \"tabs\"/>\n  </panel>\n  <panel \"flex-row grow\">\n    <slot \"sidebar\"/>\n    <panel \"grow\" key-editor-area />\n  </panel>\n  <panel \"flex-row items-center h-7\" key-statusbar />\n</panel>\n"
    mut shell_p = UiParser.init()
    mut shell_template = shell_p.parse(shell_src)
    mut slots: Dict[str, List[Pointer[UiNode]]] = {}
    slots["sidebar"] = [sidebar_panel]
    slots["tabs"] = tab_kids
    return instantiate(shell_template, slots, no_props())

def b2i(b: bool) -> int:
    if b: return 1
    return 0

pub export def nebula_init(width: int, height: int) -> void:
    _buffers = seed_files()
    _font = Font.load()
    _it = Interpreter.init()
    _it.root_bg = 0x0B1120
    register_handler(_it, "noop", NoopHandler.init(""))
    _tree = build_shell_tree(_buffers)
    _mb = MenuBar.init(
        ["File", "Edit", "View", "Help"],
        [2, 1, 1, 1],
        ["Save", "New (not wired up)", "No undo history in this demo", "Toggle Theme", "About Nebula Code"],
    )
    _dark = true

pub export def nebula_frames() -> int:
    return _frames

pub export def nebula_cursor_kind() -> int:
    return _cursor_kind

pub export def nebula_arena_used() -> int:
    return 0

def show_toast(msg: str):
    _toast = msg
    _toast_ttl = 90

def active_index() -> int:
    return _it.state_get("G:active-file", 0)

def theme_editor_bg() -> int:
    if _dark: return 0x1E1E2E
    return 0xF8FAFC
def theme_gutter_bg() -> int:
    if _dark: return 0x181825
    return 0xE2E8F0
def theme_text_fg() -> int:
    if _dark: return 0xE2E8F0
    return 0x1E1E2E
def theme_line_no() -> int:
    if _dark: return 0x64748B
    return 0x94A3B8
def theme_status_bg() -> int:
    if _dark: return 0x111827
    return 0xE2E8F0
def theme_status_fg() -> int:
    if _dark: return 0xCBD5E1
    return 0x1E293B

pub def render_editor(canvas: Canvas2DCanvas, buf: Buffer, x: int, y: int, w: int, h: int, blink_on: bool):
    mut cw = _font.cell_w()
    mut ch = _font.cell_h()
    canvas.fill_rect(x, y, w, h, theme_editor_bg())
    mut gutter_w = 5 * cw + 16
    canvas.fill_rect(x, y, gutter_w, h, theme_gutter_bg())

    mut visible_lines = h / ch
    if visible_lines < 1: visible_lines = 1
    buf.ensure_visible(visible_lines)

    mut row = buf.scroll_row
    mut py = y
    mut last_row = buf.scroll_row + visible_lines
    while row < len(buf.lines) and row < last_row:
        mut lno = (row + 1).to_str()
        mut lno_x = x + gutter_w - 8 - Str.len(lno) * cw
        canvas.text(canvas, _font, lno, lno_x, py, theme_line_no(), theme_gutter_bg())

        mut line = buf.line_at(row)
        mut toks = highlight_line(line)
        mut px = x + gutter_w + 8
        mut ti = 0
        while ti < len(toks):
            mut tk = toks[ti]
            if Str.len(tk.text) > 0:
                canvas.text(canvas, _font, tk.text, px, py, tk.color, theme_editor_bg())
            px = px + Str.len(tk.text) * cw
            ti = ti + 1

        if row == buf.cursor_row and blink_on:
            mut cx = x + gutter_w + 8 + buf.cursor_col * cw
            canvas.fill_rect(cx, py, 2, ch, theme_text_fg())

        py = py + ch
        row = row + 1

# A subtle highlight behind whichever sidebar row the mouse is over --
# computed from the same fixed geometry build_shell_tree's own markup uses
# (p-2 padding, h-8 rows, gap-1 between them: 8/32/4px), not introspected
# from the layout tree, same "known constants" approach as editor_x()/
# editor_y() above. The sidebar's own listitem widgets already handle
# click/selected-state visuals; this only adds hover feedback, which
# tabitem/listitem don't get from the tree renderer on their own.
pub def render_sidebar_hover(canvas: Canvas2DCanvas, mx: int, my: int, total_h: int):
    if mx < 0 or mx >= sidebar_w(): return
    if my < editor_y() or my >= status_y(total_h): return
    mut row_h = 32
    mut pad = 8
    mut rel_y = my - editor_y() - pad
    if rel_y < 0: return
    mut stride = row_h + 4
    mut row = rel_y / stride
    if row < 0 or row >= len(_buffers): return
    if rel_y - row * stride >= row_h: return
    mut ry = editor_y() + pad + row * stride
    canvas.fill_rect_alpha(pad, ry, sidebar_w() - pad * 2, row_h, 0xFFFFFF, 18)

pub def render_status_bar(canvas: Canvas2DCanvas, buf: Buffer, x: int, y: int, w: int, h: int):
    canvas.fill_rect(x, y, w, h, theme_status_bg())
    mut ch = _font.cell_h()
    mut ty = y + (h - ch) / 2
    mut mod_dot = ""
    if buf.modified: mod_dot = "*"
    canvas.text(canvas, _font, buf.name + mod_dot, x + 12, ty, theme_status_fg(), theme_status_bg())
    mut pos = "Ln " + (buf.cursor_row + 1).to_str() + ", Col " + (buf.cursor_col + 1).to_str()
    mut chars = buf.char_count().to_str() + " chars"
    mut right = pos + "    " + chars + "    Tauraro"
    mut right_x = x + w - Str.len(right) * _font.cell_w() - 12
    canvas.text(canvas, _font, right, right_x, ty, theme_status_fg(), theme_status_bg())
    if _toast_ttl > 0:
        mut toast_w = Str.len(_toast) * _font.cell_w() + 24
        mut toast_x = x + w / 2 - toast_w / 2
        mut toast_y = y - h - 8
        # Fade in over the first 15 ticks, hold, fade out over the last 25 --
        # a canvas redraws from scratch every frame, so "transition" here
        # just means computing an alpha from the remaining ttl, not a CSS
        # transition on anything persistent.
        mut alpha = 255
        if _toast_ttl < 25: alpha = _toast_ttl * 255 / 25
        elif _toast_ttl > 75: alpha = (90 - _toast_ttl) * 255 / 15
        canvas.fill_rect_alpha(toast_x, toast_y, toast_w, h, 0x2563EB, alpha)
        canvas.text(canvas, _font, _toast, toast_x + 12, toast_y + (h - ch) / 2, 0xFFFFFF, 0x2563EB)

pub export def nebula_frame(width: int, height: int, mouse_x: int, mouse_y: int, buttons: int, key: int, wheel_delta: int) -> void:
    _frames = _frames + 1
    mut pressed = buttons != 0
    mut clicked = pressed and not _prev_btn
    _prev_btn = pressed

    mut canvas = Canvas2DCanvas.init(width, height)
    canvas.clear(theme_editor_bg())

    _cursor_kind = compute_cursor_kind(mouse_x, mouse_y, height)

    # By default an Interpreter/MenuBar paints its tree through
    # SoftwareRenderer -- a CPU rasterizer using a small baked bitmap font
    # with per-pixel coverage blending (see toolkit.text.font's own header).
    # That's correct and portable, but visibly softer than the browser's own
    # vector font rasterizer -- next to this editor's hand-painted pane
    # (which already calls Canvas2DCanvas.text -> real ctx.fillText), the
    # difference reads as "half the UI is blurry". Point both at the native
    # Canvas2D renderer instead so every layer -- menu bar, tab strip,
    # sidebar, editor -- shares the same crisp text path.
    mut renderer: Renderer = canvas2d_renderer_of(canvas)
    _it.renderer = renderer
    _mb.renderer = renderer

    mut active = active_index()
    if active < 0 or active >= len(_buffers): active = 0
    mut buf = _buffers[active]

    mut menu_consumed = false
    if clicked:
        if _mb.click_inside(mouse_x, mouse_y, 0, chrome_top(), width, menu_h()):
            menu_consumed = true
            if _mb.clicked_menu == 0 and _mb.clicked_item == 0:
                buf.modified = false
                show_toast("Saved " + buf.name)
            elif _mb.clicked_menu == 0 and _mb.clicked_item == 1:
                show_toast("New file: not wired up in this demo")
            elif _mb.clicked_menu == 1:
                show_toast("No undo history in this demo")
            elif _mb.clicked_menu == 2:
                _dark = not _dark
                show_toast("Theme: " + bool_theme_name())
            elif _mb.clicked_menu == 3:
                show_toast("Nebula Code -- built with Tauraro + nebula")
    _mb.hover_at(mouse_x, mouse_y, 0, chrome_top(), width, menu_h())

    if clicked and not menu_consumed:
        _it.dispatch(Event.click(mouse_x, mouse_y - chrome_top() - menu_h()))
        mut new_active = active_index()
        if new_active >= 0 and new_active < len(_buffers):
            active = new_active
            buf = _buffers[active]
        mut ex = editor_x()
        mut ey = editor_y()
        mut ew = width - ex
        mut eh = content_h(height)
        if mouse_x >= ex and mouse_x < ex + ew and mouse_y >= ey and mouse_y < ey + eh:
            mut gutter_w = 5 * _font.cell_w() + 16
            buf.click_to_cursor(mouse_x - ex - gutter_w - 8, mouse_y - ey, _font.cell_w(), _font.cell_h())

    _it.hover_x = mouse_x
    _it.hover_y = mouse_y - chrome_top() - menu_h()
    _it.pressed = pressed
    _it.mouse_x = mouse_x
    _it.mouse_y = mouse_y - chrome_top() - menu_h()

    mut i = 0
    while i < len(_buffers):
        _it.state_set("K:tab-" + i.to_str(), b2i(i == active))
        _it.state_set("K:file-" + i.to_str(), b2i(i == active))
        i = i + 1

    if key == key_backspace(): buf.backspace()
    elif key == key_enter(): buf.newline()
    elif key == key_tab(): buf.insert_tab()
    elif key == key_delete(): buf.delete_forward()
    elif key == key_left(): buf.move_left()
    elif key == key_right(): buf.move_right()
    elif key == key_up(): buf.move_up()
    elif key == key_down(): buf.move_down()
    elif key == key_home(): buf.move_home()
    elif key == key_end(): buf.move_end()
    elif key == key_pgup(): buf.page_up(10)
    elif key == key_pgdn(): buf.page_down(10)
    elif key >= 32 and key <= 126: buf.insert_char(key)

    if wheel_delta != 0:
        mut ex = editor_x()
        mut ey = editor_y()
        if mouse_x >= ex and mouse_y >= ey and mouse_y < ey + content_h(height):
            buf.scroll_row = buf.scroll_row - wheel_delta * 3
            if buf.scroll_row < 0: buf.scroll_row = 0

    mut tree_y = chrome_top() + menu_h()
    render_into(_it, _tree, canvas, 0, tree_y, width, height - tree_y, theme_editor_bg())
    render_editor(canvas, buf, editor_x(), editor_y(), width - editor_x(), content_h(height), (_frames / 30) % 2 == 0)
    render_sidebar_hover(canvas, mouse_x, mouse_y, height)
    render_status_bar(canvas, buf, 0, status_y(height), width, statusbar_h())
    _mb.paint(canvas, 0, chrome_top(), width, menu_h())

    if _toast_ttl > 0: _toast_ttl = _toast_ttl - 1

def bool_theme_name() -> str:
    if _dark: return "dark"
    return "light"
