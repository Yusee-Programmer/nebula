# verified-examples/node_identity.tr — node identity + per-node state
# (proposal v4, step F).
#
# The gap this closes (proposal-v4-renderer-architecture.md section 6):
# Interpreter.render() rebuilds a fresh LayoutBox tree from a static class
# string every call, so nothing stateful can live IN that tree -- it gets
# thrown away and rebuilt next frame. This checks the two things that fix
# is required to get right, neither obvious from reading the code that
# implements them:
#
#   1. The SAME logical node gets the SAME node_key on two different builds
#      of the same markup (structural position is stable across frames),
#      but two DIFFERENT siblings with IDENTICAL class strings do NOT
#      collide -- proving identity is per-node-position, not per-Style
#      (StyleCache caches Style BY class string, so if node_key were
#      derived from that, two identical-looking siblings would share it).
#   2. An explicit `key-<name>` token gives a node identity that survives
#      REORDERING -- position-based identity alone would not.
#   3. Interpreter.state actually persists across a render() call that
#      throws the old tree away and builds a new one -- that persistence,
#      not the tree, is what makes state survive a re-render.
#
# NOTE on bugs.txt #11: this file deliberately never holds a LayoutBox's
# `str` field (node_key) in a local past a render() call that could free
# the object it came from -- see that entry for why (a real, narrow ARC
# gap in str-field reads, found while first writing this test). Two
# techniques sidestep it below, both correct today: comparing two
# independently-built, simultaneously-alive trees instead of reusing one
# across two builds, and keeping an old root ALIVE via a class-typed local
# (`mut old_root = it.root`, which retains correctly) rather than just its
# field, when a genuine before/after comparison is needed.
#
#   tauraroc --run verified-examples/node_identity.tr

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to
from toolkit.render.hosted.buffer import BufferCanvas

mut _pass: int = 0
mut _fail: int = 0

def check_str(label: str, got: str, want: str) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got \"" + got + "\" want \"" + want + "\"")

def check_bool(label: str, got: bool, want: bool) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def check_int(label: str, got: int, want: int) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def main():
    mut W = 200
    mut H = 200

    # Two children, IDENTICAL class strings -- if identity were derived from
    # the resolved Style (which StyleCache caches by class string) they
    # would collide. They must not.
    mut src = "<panel \"flex-col\">\n  <panel \"w-10 h-10 bg-red-500\" />\n  <panel \"w-10 h-10 bg-red-500\" />\n</panel>\n"
    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut it_a = Interpreter.init()
    mut ca = BufferCanvas.init(W, H, 0x1E293B)
    render_to(it_a, tree, ca)

    mut key_a = it_a.root.children[0].node_key
    mut key_b = it_a.root.children[1].node_key
    check_bool("identical-class siblings get DIFFERENT node_keys", key_a != key_b, true)

    # Same markup, built again as a SEPARATE, simultaneously-alive tree --
    # standing in for "a second frame" without ever freeing the first tree
    # while its node_key is still being compared (see the file header note).
    mut it_b = Interpreter.init()
    mut cb = BufferCanvas.init(W, H, 0x1E293B)
    render_to(it_b, tree, cb)
    check_str("node_key is stable across two independent builds of the same tree", it_b.root.children[0].node_key, key_a)
    check_str("node_key is stable across two independent builds of the same tree (2nd child)", it_b.root.children[1].node_key, key_b)

    # Explicit key- tokens: two trees with the SAME two logical items in
    # SWAPPED order. Position-based identity alone would swap with them;
    # the explicit key must not.
    mut fwd = "<panel \"flex-col\">\n  <panel \"key-alpha w-10 h-10 bg-red-500\" />\n  <panel \"key-beta w-10 h-10 bg-green-500\" />\n</panel>\n"
    mut rev = "<panel \"flex-col\">\n  <panel \"key-beta w-10 h-10 bg-green-500\" />\n  <panel \"key-alpha w-10 h-10 bg-red-500\" />\n</panel>\n"
    mut pf = UiParser.init()
    mut tf = pf.parse(fwd)
    mut pr = UiParser.init()
    mut tr = pr.parse(rev)

    mut itf = Interpreter.init()
    mut itr = Interpreter.init()
    mut cf = BufferCanvas.init(W, H, 0x1E293B)
    mut cr = BufferCanvas.init(W, H, 0x1E293B)
    render_to(itf, tf, cf)
    render_to(itr, tr, cr)

    mut alpha_key_fwd = itf.root.children[0].node_key
    mut alpha_key_rev = itr.root.children[1].node_key
    check_str("explicit key-alpha is the same identity regardless of position", alpha_key_fwd, alpha_key_rev)

    mut beta_key_fwd = itf.root.children[1].node_key
    mut beta_key_rev = itr.root.children[0].node_key
    check_str("explicit key-beta is the same identity regardless of position", beta_key_fwd, beta_key_rev)
    check_bool("alpha and beta keys are still distinct from each other", alpha_key_fwd != beta_key_fwd, true)

    # Interpreter.state: written under a key from the live tree, read back
    # after render() has thrown that tree away and built a new one -- this
    # is the actual "state survives a re-render" claim. `k` is used
    # immediately (state_set/state_get, no render() in between), which is
    # always safe; the before/after comparison below keeps the OLD root
    # alive via a class-typed local (bugs.txt #11's proven-safe pattern)
    # rather than holding just its node_key string across the render().
    mut it2 = Interpreter.init()
    mut c2 = BufferCanvas.init(W, H, 0x1E293B)
    render_to(it2, tree, c2)
    mut k = it2.root.children[0].node_key
    check_int("state_get on an unset key returns the default", it2.state_get(k, 0-1), 0-1)
    it2.state_set(k, 7)
    check_int("state_get returns what state_set just wrote", it2.state_get(k, 0-1), 7)

    mut old_root = it2.root
    render_to(it2, tree, c2)
    check_str("the same node_key comes back after a fresh render()", it2.root.children[0].node_key, old_root.children[0].node_key)
    check_int("state SURVIVES a render() that rebuilt the whole tree", it2.state_get(it2.root.children[0].node_key, 0-1), 7)

    # state_toggle: flips 0/1 (the key is already 7 -> non-zero -> flips to
    # 0), and remembers the flip across another render.
    mut t1 = it2.state_toggle(it2.root.children[0].node_key, 0)
    check_int("state_toggle flips the current non-zero value (7) to 0", t1, 0)
    render_to(it2, tree, c2)
    mut t2 = it2.state_toggle(it2.root.children[0].node_key, 0)
    check_int("state_toggle flips back to 1, remembering the 0 from before", t2, 1)

    print("")
    print("passed=" + _pass.to_str() + " failed=" + _fail.to_str())
    if _fail == 0:
        print("ALL OK")
