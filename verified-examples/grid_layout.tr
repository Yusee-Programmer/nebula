# verified-examples/grid_layout.tr — grid container layout (proposal v4, step E).
#
# Checks the three things a 2-column grid has to get right that a flex
# container can't express at all:
#
#   1. Row-major wrap: with 3 children and grid-cols-2, child 2 starts a new
#      row rather than overflowing the second column.
#   2. Equal-width tracks: every column is (inner width - gaps) / cols, not
#      each child's own natural width.
#   3. Per-row auto height: a row's height is the max of THAT row's children,
#      not the whole grid's, so row 0 (tall) doesn't inflate row 1 (short).
#
#   tauraroc --run verified-examples/grid_layout.tr

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to
from toolkit.render.hosted.buffer import BufferCanvas
from toolkit.layout.flex import dump_layout

mut _pass: int = 0
mut _fail: int = 0

def check(label: str, got: int, want: int) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def main():
    mut W = 400
    mut H = 300

    # 3 children, grid-cols-2 -> 2 rows: [red, green] / [blue].
    # red/blue are 40 tall, green is 80 tall -- row 0's height must come
    # from green (80), row 1's height must come from blue (40) alone.
    mut src = "<panel \"grid grid-cols-2 gap-2 p-4 bg-slate-800\">\n  <panel \"h-40 bg-red-500\" />\n  <panel \"h-80 bg-green-500\" />\n  <panel \"h-40 bg-blue-500\" />\n</panel>\n"

    mut p = UiParser.init()
    mut tree = p.parse(src)
    mut it = Interpreter.init()
    it.root_bg = 0x1E293B
    mut canvas = BufferCanvas.init(W, H, 0x1E293B)
    render_to(it, tree, canvas)

    print("grid layout (grid-cols-2, rows of heights 80/40):")
    dump_layout(it.root, 1)

    mut red = it.root.children[0]
    mut green = it.root.children[1]
    mut blue = it.root.children[2]

    # Row-major wrap: red/green share row 0's y, blue starts row 1.
    check("red and green share row 0's y", red.y, green.y)

    # Equal-width tracks: red and green get the same width (half the
    # content box, minus the gap), regardless of their own natural width.
    check("red width equals green width", red.w, green.w)

    # Per-row auto height: row 0's height is green's (h-80 -> 320px on the
    # toolkit's tailwind-style 4x spacing scale), so row 1 (blue) starts at
    # row0_y + 320 + gap_y (gap-2 -> 8px), NOT row0_y + max(160,320) again
    # blended with row 1's own (shorter) content.
    mut expect_row1_y = red.y + green.h + 8
    check("row 1 starts after row 0's OWN height (green's), not blended", blue.y, expect_row1_y)

    # blue is alone in row 1 -- its column still spans the same track width
    # as row 0's columns (equal tracks across the whole grid, not per-row).
    check("blue width equals red width (tracks are grid-wide, not per-row)", blue.w, red.w)

    # x positions: red starts the content box, green starts one track + gap
    # to the right, blue starts back at the same x as red (new row, col 0).
    check("green.x is to the right of red.x", green.x - red.x, red.w + 8)
    check("blue.x resets to red.x on the new row", blue.x, red.x)

    canvas.save_ppm("examples/hosted_demo/out_grid.ppm")
    print("")
    print("passed=" + _pass.to_str() + " failed=" + _fail.to_str())
    if _fail == 0:
        print("ALL OK -- wrote examples/hosted_demo/out_grid.ppm")
