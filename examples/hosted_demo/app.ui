# The UI is data. Editing this file and re-running the interpreter changes what
# renders, with no rebuild of the toolkit and no restart of the host process.

<panel "flex-col p-1 gap-[3px] bg-slate-800">
  <text "text-white">TAURARO UI TOOLKIT</text>
  <panel "flex-row gap-[3px] h-[90px]">
    <panel "bg-red grow" />
    <panel "bg-green grow" />
    <panel "bg-blue w-15" />
  </panel>
  <panel "flex-row gap-[3px] h-10 p-[3px] bg-slate-700">
    <button "bg-amber grow justify-center items-center" @on_click(on_ok)>
      <text "text-white">OK</text>
    </button>
    <button "bg-violet grow justify-center items-center" @on_click(on_cancel)>
      <text "text-white">CANCEL</text>
    </button>
  </panel>
</panel>
