# A Nebula UI file. This is DATA -- edit it and re-run, no rebuild.
#
# Class strings are Tailwind: numbers are scale steps (p-6 = 24px), not
# pixels. @on_click(name) binds a host handler registered under that name.

<panel "flex-col p-6 gap-4 bg-slate-900">

  <text "text-slate-100">NEBULA QUICKSTART</text>

  <panel "flex-row gap-4 grow">
    <panel "w-1/2 bg-indigo-500 rounded-xl" />
    <panel "grow bg-emerald-500 rounded-xl" />
    <panel "grow bg-emerald-500 rounded-xl" />
  </panel>

  <panel "flex-row gap-4 h-14">
    <button "grow bg-sky-500 rounded-lg justify-center items-center" @on_click(on_save)>
      <text "text-white">SAVE</text>
    </button>
    <button "grow bg-slate-700 rounded-lg border border-slate-500 justify-center items-center" @on_click(on_cancel)>
      <text "text-slate-200">CANCEL</text>
    </button>
  </panel>

</panel>
