# verified-examples/diff_render.tr — scene graph diffing (proposal v4, step I).
#
# Checks the two things render_diff() has to get right, neither of which is
# obvious from looking at a screenshot:
#
#   1. IT NEVER CHANGES WHAT GETS PAINTED. A diffed re-render must still
#      produce the exact pixels a full render() would -- only HOW MUCH of
#      the scene gets repainted may differ, never the visual result.
#   2. IT ACTUALLY SKIPS UNCHANGED WORK. Two consecutive renders of the
#      identical tree must find zero changed commands; moving the hover
#      point onto an interactive box (which darkens its fill -- see
#      Interpreter.emit) must find at least one.
#
#   tauraroc --run verified-examples/diff_render.tr

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_diff_to
from toolkit.render.hosted.buffer import BufferCanvas
from toolkit.render.scene import Scene, cmd_eq

mut _pass: int = 0
mut _fail: int = 0

def check(label: str, got: int, want: int) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def check_bool(label: str, got: bool, want: bool) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

# How many commands differ between two same-length scenes -- exactly what
# render_diff()'s internal execute_diff() would actually repaint.
def count_changed(prev: Scene, curr: Scene) -> int:
    mut n = 0
    mut i = 0
    while i < len(curr.cmds):
        if not cmd_eq(prev.cmds[i], curr.cmds[i]):
            n = n + 1
        i = i + 1
    return n

def main():
    mut W = 320
    mut H = 240

    mut src = "<panel \"flex-row gap-2 p-2 bg-slate-800\">\n  <panel \"bg-red-500 w-40 h-40 radius-8\" />\n  <button \"bg-amber-500 w-40 h-40 radius-8\" @on_click(noop)>\n    <text \"text-white\">OK</text>\n  </button>\n</panel>\n"
    mut p = UiParser.init()
    mut tree = p.parse(src)

    mut canvas = BufferCanvas.init(W, H, 0x1E293B)
    mut it = Interpreter.init()
    it.root_bg = 0x1E293B

    # Frame 1: no previous scene yet -- render_diff() must fall back to a
    # full repaint (there is nothing to diff against).
    render_diff_to(it, tree, canvas)
    check("frame 1 painted the red panel", canvas.get_px(20, 20), 0xEF4444)

    mut scene1 = it.last_scene

    # Frame 2: identical tree, hover point unchanged -- every command must
    # come out equal to frame 1's, so nothing gets repainted.
    render_diff_to(it, tree, canvas)
    mut scene2 = it.last_scene
    check("frame 2 has the same command count as frame 1", len(scene2.cmds), len(scene1.cmds))
    check("zero commands changed between two identical frames", count_changed(scene1, scene2), 0)

    # The red panel's pixel must still be correct after a diffed (entirely
    # skipped) re-render -- diffing must never leave stale/wrong pixels.
    check("red panel pixel survives an all-skipped re-render", canvas.get_px(20, 20), 0xEF4444)

    # Frame 3: move the hover point onto the button. emit() darkens a hot
    # box's fill (see Interpreter.emit), so the button's command must now
    # differ from frame 2's -- at least one changed command.
    it.hover_x = 200
    it.hover_y = 20
    render_diff_to(it, tree, canvas)
    mut scene3 = it.last_scene
    check_bool("hovering the button changes at least one command", count_changed(scene2, scene3) > 0, true)

    # And the result is still correct: the button's fill actually darkened,
    # the untouched red panel did not.
    check("red panel unaffected by hovering the button", canvas.get_px(20, 20), 0xEF4444)
    check_bool("hovered button darkened away from its base fill", canvas.get_px(200, 20) != 0xF59E0B, true)

    canvas.save_ppm("examples/hosted_demo/out_diff.ppm")
    print("")
    print("passed=" + _pass.to_str() + " failed=" + _fail.to_str())
    if _fail == 0:
        print("ALL OK -- wrote examples/hosted_demo/out_diff.ppm")
