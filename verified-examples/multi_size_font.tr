# verified-examples/multi_size_font.tr — multi-size fonts (nebula1.0 Phase 2).
#
# Checks the thing that makes "text-sm"/"text-lg" more than a label: layout
# and paint must AGREE on how big the glyph cell is, or a text node either
# overflows the box it was measured into or leaves a gap where painting
# stopped short. Confirms all three sizes are DISTINCT (not all silently
# aliased to base) and that a text node's measured LayoutBox size exactly
# matches glyph_w(size)*len / glyph_h(size) for its OWN declared size, not
# base's.
#
#   tauraroc --run verified-examples/multi_size_font.tr

from toolkit.ui.parser import UiParser
from toolkit.ui.interp import Interpreter, render_to
from toolkit.render.hosted.buffer import BufferCanvas
from toolkit.text.font import Fonts, font_size_sm, font_size_base, font_size_lg

mut _pass: int = 0
mut _fail: int = 0

def check_int(label: str, got: int, want: int) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def check_bool(label: str, got: bool, want: bool) -> void:
    if got == want:
        _pass = _pass + 1
    else:
        _fail = _fail + 1
        print("  FAIL " + label + ": got " + got.to_str() + " want " + want.to_str())

def main():
    mut W = 400
    mut H = 200
    mut bg = 0x1E293B

    # The three baked atlases must actually be different sizes -- otherwise
    # "text-sm"/"text-lg" would silently do nothing and every check below
    # would pass for the wrong reason (base measured 3 times).
    mut fonts = Fonts.load()
    mut sm = fonts.pick(font_size_sm())
    mut base = fonts.pick(font_size_base())
    mut lg = fonts.pick(font_size_lg())
    check_bool("text-sm's cell is smaller than base's", sm.cell_w() < base.cell_w() and sm.cell_h() < base.cell_h(), true)
    check_bool("text-lg's cell is larger than base's", lg.cell_w() > base.cell_w() and lg.cell_h() > base.cell_h(), true)

    # One panel with three text children, one per size, each holding the
    # SAME string -- if layout used the wrong atlas for any of them, its
    # measured width/height would not match that size's OWN glyph cell.
    # `items-start` on the container: the default cross-axis alignment is
    # `items-stretch`, which would widen every child to the container's own
    # width and hide each text node's OWN intrinsic (per-size) width behind
    # a shared stretched one -- not what this test needs to see.
    mut src = "<panel \"flex-col items-start p-4 bg-slate-800\">\n  <text \"text-sm text-white\">hello</text>\n  <text \"text-base text-white\">hello</text>\n  <text \"text-lg text-white\">hello</text>\n</panel>\n"
    mut p = UiParser.init()
    mut tree = p.parse(src)
    mut it = Interpreter.init()
    it.root_bg = bg
    mut canvas = BufferCanvas.init(W, H, bg)
    render_to(it, tree, canvas)

    mut sm_box = it.root.children[0]
    mut base_box = it.root.children[1]
    mut lg_box = it.root.children[2]

    check_int("text-sm node measured at the SMALL atlas's own cell size", sm_box.w, sm.cell_w() * 5)
    check_int("text-sm node height matches the small atlas", sm_box.h, sm.cell_h())
    check_int("text-base node measured at the BASE atlas's own cell size", base_box.w, base.cell_w() * 5)
    check_int("text-base node height matches base", base_box.h, base.cell_h())
    check_int("text-lg node measured at the LARGE atlas's own cell size", lg_box.w, lg.cell_w() * 5)
    check_int("text-lg node height matches the large atlas", lg_box.h, lg.cell_h())

    # Stacked in a flex-col, so each successive box's y should already
    # reflect the PREVIOUS box's own (different) height -- another way the
    # wrong atlas silently shows up as "layout" bugs, not just visual size.
    check_int("base node starts right after the (shorter) sm node", base_box.y, sm_box.y + sm_box.h)
    check_int("lg node starts right after the (shorter) base node", lg_box.y, base_box.y + base_box.h)

    print("")
    print("passed=" + _pass.to_str() + " failed=" + _fail.to_str())
    if _fail == 0:
        print("ALL OK")
