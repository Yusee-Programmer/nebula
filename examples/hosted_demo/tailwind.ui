# Exercises the layout features the pre-Tailwind vocabulary could not express:
# fractional widths, per-side padding, margins, and the two distributed
# justify modes. Rendered by verified-examples/tailwind_layout.tr.

<panel "flex-col p-4 gap-4 bg-slate-900">

  # Thirds. w-1/3 is resolved against the parent's CONTENT box as an exact
  # fraction, so three of them fill the row with no rounding gap.
  <panel "flex-row h-12 gap-0">
    <panel "w-1/3 bg-red-500" />
    <panel "w-1/3 bg-emerald-500" />
    <panel "w-1/3 bg-blue-500" />
  </panel>

  # justify-evenly: every space, including both outer edges, is equal.
  <panel "flex-row h-12 justify-evenly items-center bg-slate-800 rounded-lg">
    <panel "w-10 h-6 bg-amber-400 rounded" />
    <panel "w-10 h-6 bg-amber-400 rounded" />
    <panel "w-10 h-6 bg-amber-400 rounded" />
  </panel>

  # justify-between: outer children flush to the edges.
  <panel "flex-row h-12 justify-between items-center bg-slate-800 rounded-lg px-2">
    <panel "w-10 h-6 bg-violet-400 rounded" />
    <panel "w-10 h-6 bg-violet-400 rounded" />
    <panel "w-10 h-6 bg-violet-400 rounded" />
  </panel>

  # Margins push siblings apart and shrink a stretched child.
  <panel "flex-row h-12 bg-slate-800 rounded-lg">
    <panel "w-1/2 my-2 ml-2 bg-cyan-500 rounded" />
    <panel "grow m-2 bg-pink-500 rounded" />
  </panel>

  # Asymmetric padding: the inner box sits 16px from the left, 4px elsewhere.
  <panel "h-12 pl-4 pr-1 py-1 bg-slate-800 rounded-lg">
    <panel "grow bg-lime-400 rounded" />
  </panel>

</panel>
